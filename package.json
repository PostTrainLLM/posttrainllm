{
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "deploy": "node scripts/release/manual-deploy.mjs deploy.yml ci.yml",
    "format:check": "node scripts/quality/check-code-format.mjs",
    "lint": "node scripts/quality/check-code-lint.mjs",
    "typecheck": "pnpm --dir browser run typecheck",
    "test": "pnpm --dir browser test && bash evals/common-smoke.sh && bash evals/cli-surface-smoke.sh",
    "test:coverage": "pnpm --dir browser test:coverage",
    "completion:check": "bash evals/project-completion-smoke.sh && bash evals/attempt-ledger-smoke.sh && bash evals/technique-inventory-smoke.sh && bash evals/learning-roadmap-smoke.sh && bash evals/cli-surface-smoke.sh",
    "quality:unused": "node scripts/quality/check-unused-code.mjs",
    "quality:complexity": "node scripts/quality/check-complexity.mjs",
    "quality:duplication": "node scripts/quality/check-duplication.mjs",
    "quality:cycles": "node scripts/quality/check-cycles.mjs",
    "quality:dependencies": "node scripts/quality/check-dependency-risk.mjs",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run quality:unused && pnpm run quality:complexity && pnpm run quality:duplication && pnpm run quality:cycles && pnpm run quality:dependencies",
    "test:dependency-security": "node --test scripts/http-cache-security.test.mjs"
  },
  "devDependencies": {
    "jscpd": "5.1.1",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "wrangler": "^4.128.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7",
      "nanoid@<3.3.18": "3.3.18",
      "sharp": "0.35.4",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "undici@>=8.0.0 <8.10.2": "8.10.2",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.11",
      "devalue@>=5.0.0 <5.9.3": "5.9.3",
      "http-cache-semantics": "4.3.0"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    }
  }
}
