{
  "name": "posttrainllm-browser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Browser posttrainllm — trains a tiny GPT in a Web Worker on WASM (Phase 4)",
  "scripts": {
    "dev": "astro dev --port 5173",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "build": "tsc --noEmit && astro build && node scripts/build-docs.mjs && node scripts/build-agent-surfaces.mjs",
    "agent:check": "node scripts/build-agent-surfaces.mjs --check",
    "preview": "astro preview --port 4173",
    "e2e": "node e2e_browser.mjs",
    "webgpu-test": "node webgpu_test.mjs",
    "gallery": "node finalize_gallery.ts && node finalize_gallery_int4.ts",
    "gallery:check": "node scripts/check_gallery_drift.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "size:check": "size-limit --json"
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@webgpu/types": "^0.1.70",
    "astro": "^5.0.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "size-limit": "^11.2.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "posthog-js": "^1.376.2",
    "web-vitals": "^4.2.4"
  }
}
