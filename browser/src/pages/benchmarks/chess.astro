---
import Default from "../../layouts/Default.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import replay from "../../data/benchmarks/chess-development-v1.json";
import candidateMatrix from "../../data/benchmarks/chess-candidate-model-matrix-v1.json";

const clientData = JSON.stringify(replay).replaceAll("<", "\\u003c");
const measured = replay.models.filter((model) => model.aggregate);
const frontier = measured.find((model) => model.role === "frontier-calibration-anchor");
const local = measured.filter((model) => model.role.includes("local"));
const candidateNames: Record<string, string> = {
  "random-legal": "Random legal",
  "gpt-5.5": "GPT-5.5",
  "gpt-5.4": "GPT-5.4",
  "gpt-5.4-mini": "GPT-5.4-mini",
  "claude-sonnet-5": "Claude Sonnet 5",
  "claude-opus-4-8": "Claude Opus 4.8",
  "glm-5.2": "Devin GLM-5.2",
};
const formatPercent = (value: number) => `${(value * 100).toFixed(value * 100 % 1 ? 1 : 0)}%`;
const candidateRuns = candidateMatrix.runs.filter((run) => run.requested_model !== "random-legal");
const candidateRandom = candidateMatrix.runs.find((run) => run.requested_model === "random-legal");
---

<Default
  title="Character Chess LLM benchmark — posttrainllm"
  description="Watch frontier, 9B, and 4B language models solve identical chess tactics and replay their complete paired games move by move."
>
  <SiteHeader mode="instrument" active="benchmarks" />
  <!--
    THESIS: One board, two truths: tactics measure capability; full games reveal behavior.
    OWN-WORLD: Preserve the 2048 deep-ink instrument, teal live state, coral failures, amber caveats.
    STORY: See the gradient, inspect a decision, then watch why a match score can mislead.
    FIRST VIEWPORT: A full chessboard owns the left; mode, model, evidence, and controls occupy the right rail.
    FORM: Existing benchmark instrument extended as a dual-lane analysis console; no concept seed for a pinned preserve request.
  -->
  <main>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/benchmarks">Benchmarks</a><span>/</span><span>Character Chess</span></nav>

    <header class="hero">
      <div>
        <p class="kicker">Development Gate 0 · 20 novel positions · no tools</p>
        <h1>The gradient<br /><em>is real.</em></h1>
      </div>
      <p>{replay.benchmark.claim} Puzzles are the ruler. Complete games show what those scores look like when policies must keep choosing.</p>
    </header>

    <section class="gate" aria-labelledby="gate-title">
      <div class="gate-verdict"><span aria-hidden="true">✓</span><div><small>Gate 0 passed</small><strong id="gate-title">Eligible for a frozen suite—not training yet.</strong></div></div>
      <dl>
        <div><dt>Frontier</dt><dd>{Math.round((frontier?.aggregate?.exact_move_accuracy ?? 0) * 100)}%</dd></div>
        <div><dt>9B local</dt><dd>{Math.round((local.find((model) => model.size === "9B")?.aggregate?.exact_move_accuracy ?? 0) * 100)}%</dd></div>
        <div><dt>4B local</dt><dd>{Math.round((local.find((model) => model.size === "4B")?.aggregate?.exact_move_accuracy ?? 0) * 100)}%</dd></div>
        <div><dt>Random calibrated</dt><dd>{(replay.random.calibration.mean_exact_move_accuracy * 100).toFixed(2)}%</dd></div>
      </dl>
    </section>

    <section class="arena" aria-labelledby="arena-title">
      <div class="arena-head">
        <div><p class="section-label">Prerecorded evidence</p><h2 id="arena-title">Watch every decision.</h2></div>
        <div class="mode-switch" role="tablist" aria-label="Evidence lane">
          <button id="puzzle-mode" type="button" role="tab" aria-selected="true">Puzzle Arena</button>
          <button id="match-mode" type="button" role="tab" aria-selected="false">Match Arena</button>
        </div>
      </div>

      <div class="arena-instrument">
        <div class="board-side">
          <div class="board-meta">
            <div><span id="position-label">Puzzle 1 / 20</span><strong id="position-name">—</strong></div>
            <div class="turn"><span>Turn</span><strong id="turn">—</strong></div>
          </div>
          <div class="board" id="chessboard" role="img" aria-label="Chess position">
            {Array.from({ length: 64 }, (_, index) => <div class="square" data-square-index={index}><span class="piece"></span><small></small></div>)}
          </div>
          <div class="transport">
            <button id="previous" type="button" aria-label="Previous decision">←</button>
            <button id="play" class="play" type="button">Play</button>
            <button id="next" type="button" aria-label="Next decision">→</button>
            <input id="timeline" type="range" min="0" max="19" value="0" aria-label="Replay position" />
          </div>
        </div>

        <aside class="console">
          <div class="console-top">
            <div><span class="trace-label">Selected policy</span><strong id="model-name">—</strong></div>
            <span class="evidence-state" id="evidence-state">development</span>
          </div>
          <div class="model-strip" id="model-strip" aria-label="Choose a measured model"></div>
          <div class="exact-input">
            <span class="trace-label">Exact character input</span>
            <code id="character-input">—</code>
          </div>
          <div class="decision-grid">
            <div><span class="trace-label">Model output</span><strong id="model-output">—</strong></div>
            <div><span class="trace-label">Best move</span><strong id="best-move">—</strong></div>
            <div><span class="trace-label">Latency</span><strong id="latency">—</strong></div>
          </div>
          <div class="verdict" id="verdict" data-state="waiting"><span id="verdict-mark">•</span><p id="verdict-copy">Choose a policy and position.</p></div>
          <div class="match-picker" id="match-picker" hidden>
            <label for="game-select">Recorded game</label><select id="game-select"></select>
          </div>
          <ol class="move-list" id="move-list" aria-label="Game moves" hidden></ol>
        </aside>
      </div>
    </section>

    <section class="results" aria-labelledby="results-title">
      <div class="section-heading"><div><p class="section-label">Primary ruler</p><h2 id="results-title">Tactical move selection</h2></div><span>Stockfish 18 labels · depth 12</span></div>
      <p class="scroll-hint">Swipe the table to inspect latency and interpretation →</p>
      <div class="table-wrap" tabindex="0" aria-label="Chess model results. Scroll horizontally for all columns."><table>
        <thead><tr><th>Policy</th><th>Role</th><th>Exact</th><th>Legal</th><th>Mean decision</th><th>Interpretation</th></tr></thead>
        <tbody>
          <tr><th>Codex gpt-5.5</th><td>frontier</td><td class="number pass">13 / 20 · 65%</td><td class="number">100%</td><td class="number">23.69 s</td><td>Gate anchor passed</td></tr>
          <tr><th>Qwen3.5 9B</th><td>local general</td><td class="number">2 / 20 · 10%</td><td class="number">90%</td><td class="number">577 ms</td><td>Above 4B, far below frontier</td></tr>
          <tr><th>Qwen3 4B</th><td>local general</td><td class="number bad">0 / 20 · 0%</td><td class="number">95%</td><td class="number">294 ms</td><td>Legal executor, no tactical hits</td></tr>
          <tr><th>Random legal</th><td>calibrated diagnostic</td><td class="number">6.74% expected</td><td class="number">100%</td><td class="number">&lt;1 ms</td><td>2,000-seed mean</td></tr>
          <tr class="specialist"><th>Our chess specialist<small>30–50M · ≤50M</small></th><td>specialist</td><td colspan="4"><span>Not trained—freeze the benchmark first</span></td></tr>
        </tbody>
      </table></div>
      <p class="finding"><strong>Why this passes:</strong> frontier exceeded calibrated random by 58.26 points and the strongest local model by 55 points, while returning a legal move on every position. The ruler is promising; it is not frozen benchmark evidence yet.</p>
    </section>

    <section class="results" aria-labelledby="candidate-results-title">
      <div class="section-heading"><div><p class="section-label">Expanded candidate audit</p><h2 id="candidate-results-title">More data exposed the ceiling problem.</h2></div><span>100 generated · 86 admitted · 40 reviewed</span></div>
      <p class="scroll-hint">Different coverage is shown explicitly; do not rank a 10-position row against a 40-position row →</p>
      <div class="table-wrap" tabindex="0" aria-label="Candidate-only chess model audit. Scroll horizontally for all columns."><table>
        <thead><tr><th>Policy</th><th>Coverage</th><th>Exact</th><th>Raw legal</th><th>Executed legal</th><th>Redirect</th><th>Mean decision</th></tr></thead>
        <tbody>
          {candidateRuns.map((run) => <tr>
            <th>{candidateNames[run.requested_model] ?? run.requested_model}<small>{run.policy_id.includes("high-ceiling") ? "high reasoning" : run.backend}</small></th>
            <td class="number">{run.puzzles} / 40</td>
            <td class="number">{run.exact} / {run.puzzles} · {formatPercent(run.exact_move_accuracy)}</td>
            <td class="number">{formatPercent(run.raw_legal_rate)}</td>
            <td class="number pass">{formatPercent(run.executed_legal_rate ?? 0)}</td>
            <td class="number">{formatPercent(run.redirect_rate)}</td>
            <td class="number">{run.mean_latency_ms === null ? "not exposed" : `${(run.mean_latency_ms / 1000).toFixed(2)} s`}</td>
          </tr>)}
        </tbody>
      </table></div>
      <p class="finding"><strong>Why this is not frozen:</strong> Stockfish's top move was stable at depths 16 and 20 on all {candidateMatrix.label_authority.deep_verification.candidates} candidates, but no frontier lane reached the required near-100% ceiling. GPT-5.5 high reasoning scored lower than medium reasoning. The calibrated random mean was {candidateRandom && "calibration" in candidateRandom ? formatPercent(candidateRandom.calibration.mean_exact_move_accuracy) : "not available"}. Human audit comes next; small-model grading and training remain blocked.</p>
    </section>

    <section class="match-report" aria-labelledby="match-title">
      <div><p class="section-label">Secondary demonstration</p><h2 id="match-title">A match score can lie.</h2></div>
      <p>Qwen 4B recorded two wins and two draws against Qwen 9B—but both wins were notation forfeits, and both draws were 14-ply repetitions. That is why the dense puzzle ruler decides admission while complete games remain inspectable behavior.</p>
      <dl>
        <div><dt>Recorded games</dt><dd>4</dd></div>
        <div><dt>4B wins</dt><dd>2</dd></div>
        <div><dt>Draws</dt><dd>2</dd></div>
        <div><dt>9B wins</dt><dd>0</dd></div>
        <div><dt>Notation forfeits</dt><dd>2</dd></div>
      </dl>
    </section>

    <section class="protocol" aria-labelledby="protocol-title">
      <div><p class="section-label">Reproduce locally</p><h2 id="protocol-title">Same board. Same legal set. No engine.</h2><p>{replay.reproduce.protocol}</p></div>
      <div class="command-block"><code id="command">{replay.reproduce.puzzle_command}</code><button id="copy-command" type="button">Copy command</button></div>
      <div class="protocol-grid">
        <div><span>Observation</span><strong>FEN + ply + sorted legal UCI moves</strong></div>
        <div><span>Strict output</span><strong>One legal UCI move, nothing else</strong></div>
        <div><span>Rules</span><strong>python-chess 1.999</strong></div>
        <div><span>Labels</span><strong>Stockfish 18, depth 12</strong></div>
      </div>
      <button class="download" id="download-replay" type="button">Download prerecorded evidence</button>
    </section>

    <section class="limitations" aria-labelledby="limitations-title">
      <h2 id="limitations-title">What this does not prove</h2>
      <ul>{replay.benchmark.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
    </section>
  </main>
  <script is:inline type="application/json" id="chess-replay-data" set:html={clientData}></script>
</Default>

<script>
  type Decision = { puzzle_id?:string; input:string; fen?:string; pre_fen?:string; post_fen?:string; raw_output:string|null; parsed_move:string|null; best_moves?:string[]; exact?:boolean; legal:boolean; failure:string|null; latency_ms:number; policy_id?:string; side?:string; ply?:number };
  type Model = { policy_id:string; name:string; size:string; role:string; aggregate:any; decisions:Decision[] };
  type Game = { opening_id:string; color_assignment:string; white:{policy_id:string}; black:{policy_id:string}; outcome:{result:string;termination:string;winner:string|null}; initial_fen:string; decisions:Decision[] };
  type Replay = { benchmark:any; puzzles:any[]; models:Model[]; random:any; matches:{games:Game[]}; reproduce:any };
  const replayData = JSON.parse(document.querySelector<HTMLScriptElement>("#chess-replay-data")!.textContent!) as Replay;
  const pieces:Record<string,string> = { K:"♔",Q:"♕",R:"♖",B:"♗",N:"♘",P:"♙",k:"♚",q:"♛",r:"♜",b:"♝",n:"♞",p:"♟" };
  const files = "abcdefgh";
  const models = replayData.models.filter((model) => model.aggregate);
  let mode:"puzzle"|"match" = "puzzle";
  let modelIndex = Math.max(0, models.findIndex((model) => model.role === "frontier-calibration-anchor"));
  let positionIndex = Math.max(0, models[modelIndex].decisions.findIndex((decision) => decision.exact));
  let gameIndex = 0;
  let playing:number|undefined;

  const byId = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
  const parseFen = (fen:string) => {
    const rows:string[][] = [];
    for (const row of fen.split(" ")[0].split("/")) {
      const cells:string[] = [];
      for (const token of row) Number.isInteger(Number(token)) ? cells.push(...Array(Number(token)).fill("")) : cells.push(token);
      rows.push(cells);
    }
    return rows.flat();
  };
  const squareName = (index:number) => `${files[index % 8]}${8 - Math.floor(index / 8)}`;
  const renderBoard = (fen:string, chosen:string|null, best:string|null) => {
    const board = parseFen(fen);
    document.querySelectorAll<HTMLElement>(".square").forEach((square,index) => {
      const name = squareName(index);
      square.dataset.chosen = String(Boolean(chosen?.includes(name)));
      square.dataset.best = String(Boolean(best?.includes(name)));
      square.querySelector<HTMLElement>(".piece")!.textContent = pieces[board[index]] ?? "";
      square.querySelector<HTMLElement>("small")!.textContent = index % 8 === 0 ? String(8 - Math.floor(index / 8)) : index >= 56 ? files[index % 8] : "";
    });
    byId("chessboard").setAttribute("aria-label", `Chess position: ${fen}`);
    byId("turn").textContent = fen.split(" ")[1] === "w" ? "White" : "Black";
  };

  const renderModels = () => {
    const strip = byId("model-strip");
    if (!strip.childElementCount) models.forEach((model,index) => {
      const button = document.createElement("button"); button.type="button";
      button.innerHTML = `<strong>${model.name}</strong><span>${Math.round(model.aggregate.exact_move_accuracy*100)}% exact</span>`;
      button.addEventListener("click",()=>{ modelIndex=index; positionIndex=0; render(); }); strip.append(button);
    });
    strip.querySelectorAll<HTMLButtonElement>("button").forEach((button,index) => {
      const active=index===modelIndex; button.dataset.active=String(active); button.setAttribute("aria-pressed",String(active));
    });
  };

  const renderPuzzle = () => {
    const model=models[modelIndex]; const decision=model.decisions[positionIndex]; const puzzle=replayData.puzzles[positionIndex];
    renderBoard(decision.fen!, decision.parsed_move, decision.best_moves?.[0] ?? null);
    byId("position-label").textContent=`Puzzle ${positionIndex+1} / ${model.decisions.length}`;
    byId("position-name").textContent=puzzle.themes.join(" · "); byId("model-name").textContent=`${model.name} · ${model.size}`;
    byId("character-input").textContent=decision.input; byId("model-output").textContent=decision.raw_output ?? "provider failure";
    byId("best-move").textContent=decision.best_moves?.join(" or ") ?? "—"; byId("latency").textContent=`${Math.round(decision.latency_ms).toLocaleString()} ms`;
    const verdict=byId("verdict"); verdict.dataset.state=decision.exact?"pass":decision.legal?"miss":"failed";
    byId("verdict-mark").textContent=decision.exact?"✓":decision.legal?"↗":"×";
    byId("verdict-copy").textContent=decision.exact?"Exact engine move.":decision.legal?"Legal move, but missed the tactical best move.":`Invalid decision: ${decision.failure}`;
    const timeline=byId<HTMLInputElement>("timeline"); timeline.max=String(model.decisions.length-1); timeline.value=String(positionIndex);
  };

  const renderMatch = () => {
    const game=replayData.matches.games[gameIndex]; const decision=game.decisions[positionIndex];
    const fen=decision ? decision.pre_fen! : game.initial_fen;
    renderBoard(fen, decision?.parsed_move ?? null, null);
    byId("position-label").textContent=`Ply ${decision ? positionIndex+1 : 0} / ${game.decisions.length}`;
    byId("position-name").textContent=`${game.outcome.result} · ${game.outcome.termination.replaceAll("-"," ")}`;
    byId("model-name").textContent=decision ? decision.policy_id! : `${game.white.policy_id} vs ${game.black.policy_id}`;
    byId("character-input").textContent=decision?.input ?? "Initial position"; byId("model-output").textContent=decision?.raw_output ?? "—";
    byId("best-move").textContent=decision?.parsed_move ?? "—"; byId("latency").textContent=decision ? `${Math.round(decision.latency_ms).toLocaleString()} ms` : "—";
    const verdict=byId("verdict"); verdict.dataset.state=decision?.legal===false?"failed":"pass";
    byId("verdict-mark").textContent=decision?.legal===false?"×":"✓";
    byId("verdict-copy").textContent=decision?.legal===false?`Forfeit: ${decision.failure}`:decision?`${decision.side} played ${decision.parsed_move}.`:`${game.white.policy_id} has White.`;
    const timeline=byId<HTMLInputElement>("timeline"); timeline.max=String(Math.max(0,game.decisions.length-1)); timeline.value=String(positionIndex);
    const list=byId<HTMLOListElement>("move-list"); list.replaceChildren(...game.decisions.map((row,index)=>{const li=document.createElement("li");const button=document.createElement("button");button.type="button";button.dataset.active=String(index===positionIndex);button.setAttribute("aria-current",index===positionIndex?"step":"false");button.textContent=`${index+1}. ${row.raw_output ?? "failure"}`;button.addEventListener("click",()=>{positionIndex=index;render();});li.append(button);return li;}));
  };

  const render = () => {
    renderModels();
    byId("model-strip").hidden=mode==="match"; byId("match-picker").hidden=mode!=="match"; byId("move-list").hidden=mode!=="match";
    byId("best-move").parentElement!.querySelector(".trace-label")!.textContent=mode==="puzzle"?"Best move":"Parsed move";
    mode==="puzzle"?renderPuzzle():renderMatch();
  };

  const setMode=(next:"puzzle"|"match")=>{mode=next;positionIndex=0;stop();byId("puzzle-mode").setAttribute("aria-selected",String(mode==="puzzle"));byId("match-mode").setAttribute("aria-selected",String(mode==="match"));byId("command").textContent=mode==="puzzle"?replayData.reproduce.puzzle_command:replayData.reproduce.match_command;render();};
  const stop=()=>{if(playing!==undefined)window.clearInterval(playing);playing=undefined;byId("play").textContent="Play";};
  const step=(delta:number)=>{const count=mode==="puzzle"?models[modelIndex].decisions.length:replayData.matches.games[gameIndex].decisions.length;positionIndex=(positionIndex+delta+count)%count;render();};
  byId("puzzle-mode").addEventListener("click",()=>setMode("puzzle")); byId("match-mode").addEventListener("click",()=>setMode("match"));
  document.querySelector(".mode-switch")!.addEventListener("keydown",(event)=>{if(!(event instanceof KeyboardEvent)||!["ArrowLeft","ArrowRight","Home","End"].includes(event.key))return;event.preventDefault();const next=event.key==="ArrowLeft"||event.key==="Home"?"puzzle":"match";setMode(next);byId(next==="puzzle"?"puzzle-mode":"match-mode").focus();});
  byId("previous").addEventListener("click",()=>{stop();step(-1)}); byId("next").addEventListener("click",()=>{stop();step(1)});
  byId("play").addEventListener("click",()=>{if(playing!==undefined){stop();return;}byId("play").textContent="Pause";playing=window.setInterval(()=>step(1),900);});
  byId("timeline").addEventListener("input",(event)=>{stop();positionIndex=Number((event.target as HTMLInputElement).value);render();});
  const gameSelect=byId<HTMLSelectElement>("game-select"); replayData.matches.games.forEach((game,index)=>gameSelect.add(new Option(`${index+1}. ${game.white.policy_id.replace(/-.*/,"")}–${game.black.policy_id.replace(/-.*/,"")} · ${game.outcome.result}`,String(index))));
  gameSelect.addEventListener("change",()=>{stop();gameIndex=Number(gameSelect.value);positionIndex=0;render();});
  byId("copy-command").addEventListener("click",async()=>{await navigator.clipboard.writeText(byId("command").textContent??"");byId("copy-command").textContent="Copied";window.setTimeout(()=>byId("copy-command").textContent="Copy command",1200);});
  byId("download-replay").addEventListener("click",()=>{const blob=new Blob([JSON.stringify(replayData)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="chess-prerecorded-evidence.json";a.click();URL.revokeObjectURL(a.href);});
  render();
</script>

<style is:global>
  :root{color-scheme:dark;--bg:#090b0e;--panel:#10141a;--panel2:#171c23;--line:#29313b;--fg:#eef1f5;--soft:#aab2bd;--quiet:#747e8b;--live:#48e5c2;--coral:#ff7163;--amber:#ffbd66;--light-square:#b6c8bf;--dark-square:#405a51}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 "Geist Variable",system-ui,sans-serif}button,select,input{font:inherit}main{width:min(1220px,calc(100% - 40px));margin:auto;padding:42px 0 110px}.crumbs{display:flex;gap:9px;color:var(--quiet);font:12px "Geist Mono Variable",monospace}.crumbs a{color:var(--soft);text-decoration:none}.hero{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);align-items:end;gap:52px;padding:70px 0 56px}.kicker,.section-label{color:var(--live);font:600 12px "Geist Mono Variable",monospace;margin:0 0 15px}.hero h1,.arena h2,.results h2,.match-report h2,.protocol h2,.limitations h2{font-family:"Bricolage Grotesque Variable","Geist Variable",sans-serif;letter-spacing:-.03em;margin:0}.hero h1{font-size:clamp(58px,9vw,106px);line-height:.82}.hero h1 em{color:var(--live);font-style:normal}.hero>p{color:var(--soft);font-size:19px;max-width:42ch;margin:0}.gate{display:grid;grid-template-columns:1fr 1.5fr;gap:40px;align-items:center;border-block:1px solid var(--line);padding:24px 0;margin-bottom:78px}.gate-verdict{display:flex;align-items:center;gap:15px}.gate-verdict>span{display:grid;place-items:center;width:42px;height:42px;background:var(--live);color:#05100d;border-radius:50%;font-weight:800}.gate-verdict div{display:grid}.gate-verdict small{color:var(--live);font:11px "Geist Mono Variable",monospace}.gate-verdict strong{font-size:15px}.gate dl{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);margin:0}.gate dl div{background:var(--bg);padding:9px 16px;display:grid}.gate dt{color:var(--quiet);font-size:11px}.gate dd{margin:0;font:600 18px "Geist Mono Variable",monospace}.arena{margin-bottom:100px}.aren