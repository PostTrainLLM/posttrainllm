olumns:44px 72px 44px 1fr;gap:8px;margin-top:18px}.transport button{border:1px solid var(--line);background:var(--panel2);color:var(--fg);cursor:pointer}.transport .play{background:var(--live);color:#06110e;border-color:var(--live);font-weight:700}.transport input{width:100%;accent-color:var(--live)}.console{display:flex;flex-direction:column;padding:clamp(22px,3vw,38px);min-width:0}.console-top{display:flex;justify-content:space-between;gap:20px}.console-top div{display:grid}.evidence-state{align-self:start;color:var(--amber);border:1px solid #6a5030;padding:3px 7px;font:10px "Geist Mono Variable",monospace}.model-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:24px 0}.model-strip button{display:grid;text-align:left;border:1px solid var(--line);background:var(--panel2);color:var(--soft);padding:10px;cursor:pointer}.model-strip button[data-active="true"]{border-color:var(--live);color:var(--fg)}.model-strip span{color:var(--quiet);font-size:10px}.exact-input{padding:20px 0;border-block:1px solid var(--line)}.exact-input code{display:block;color:var(--live);font:12px/1.65 "Geist Mono Variable",monospace;overflow-wrap:anywhere;margin-top:8px}.decision-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:22px 0}.decision-grid div{display:grid}.decision-grid strong{font:13px "Geist Mono Variable",monospace;overflow-wrap:anywhere}.verdict{display:flex;align-items:center;gap:12px;border-block:1px solid var(--line);padding:17px 0}.verdict span{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:var(--panel2);font-weight:800}.verdict p{margin:0;color:var(--soft)}.verdict[data-state="pass"] span{background:var(--live);color:#05100d}.verdict[data-state="miss"] span{background:var(--amber);color:#1a1002}.verdict[data-state="failed"] span{background:var(--coral);color:#210605}.match-picker{display:grid;gap:7px;margin-top:18px}.match-picker select{background:var(--panel2);color:var(--fg);border:1px solid var(--line);padding:9px}.move-list{display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:16px 0 0;margin:0;max-height:180px;overflow:auto}.move-list li{display:contents}.move-list button{padding:4px 7px;border:0;background:var(--panel2);color:var(--quiet);font:10px "Geist Mono Variable",monospace;cursor:pointer}.move-list button[data-active="true"]{background:var(--live);color:#06110e}.results{margin-bottom:90px}.section-heading span{color:var(--quiet);font:12px "Geist Mono Variable",monospace}.scroll-hint{display:none;color:var(--quiet);font:11px "Geist Mono Variable",monospace}.table-wrap{overflow:auto;border-top:1px solid var(--line)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:17px 12px;border-bottom:1px solid var(--line);font-size:14px}th{font-weight:600}thead th{color:var(--quiet);font:11px "Geist Mono Variable",monospace}.number{font-family:"Geist Mono Variable",monospace}.pass{color:var(--live)}.bad{color:var(--coral)}.specialist span{color:var(--amber)}.specialist small{display:block;color:var(--quiet)}.finding{color:var(--soft);max-width:82ch;margin:22px 0}.finding strong{color:var(--fg)}.match-report{display:grid;grid-template-columns:.7fr 1fr;gap:40px;padding:54px 0;border-block:1px solid var(--line);margin-bottom:90px}.match-report>p{color:var(--soft);font-size:18px;margin:0}.match-report dl{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);margin:0}.match-report dl div{display:grid;background:var(--bg);padding:15px}.match-report dt{color:var(--quiet);font-size:11px}.match-report dd{margin:0;font:20px "Geist Mono Variable",monospace}.protocol{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-bottom:80px}.protocol>div:first-child p:last-child{color:var(--soft);max-width:50ch}.command-block{display:grid;grid-template-columns:1fr auto;background:var(--panel);border:1px solid var(--line);padding:14px}.command-block code{font:11px/1.6 "Geist Mono Variable",monospace;color:var(--live);overflow-wrap:anywhere}.command-block button,.download{border:0;background:var(--live);color:#06110e;padding:9px 13px;font-weight:700;cursor:pointer}.protocol-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}.protocol-grid div{display:grid;background:var(--bg);padding:14px}.protocol-grid span{color:var(--quiet);font-size:11px}.protocol-grid strong{font-size:13px}.download{justify-self:start}.limitations{padding-top:48px;border-top:1px solid var(--line)}.limitations ul{columns:2;column-gap:55px;padding-left:20px;color:var(--soft)}.limitations li{break-inside:avoid;margin-bottom:12px}@media(max-width:900px){.hero,.gate,.arena-instrument,.match-report,.protocol{grid-template-columns:1fr}.gate dl{grid-template-columns:repeat(2,1fr)}.board-side{border-right:0;border-bottom:1px solid var(--line)}.arena-instrument{min-height:0}.match-report dl{grid-template-columns:repeat(3,1fr)}.protocol-grid{grid-template-columns:repeat(2,1fr)}.scroll-hint{display:block}}@media(max-width:560px){main{width:min(100% - 28px,1220px);padding-top:28px}.hero{padding:48px 0 42px;gap:25px}.hero h1{font-size:58px}.gate{margin-bottom:60px}.gate dl{grid-template-columns:1fr 1fr}.arena-head{align-items:start;flex-direction:column}.mode-switch{width:100%}.mode-switch button{flex:1}.arena-instrument{border-inline:0;margin-inline:-14px}.board-side,.console{padding:18px 14px}.model-strip{grid-template-columns:1fr}.decision-grid{grid-template-columns:1fr 1fr}.transport{grid-template-columns:42px 64px 42px 1fr}.piece{font-size:clamp(28px,11vw,48px)}.match-report dl,.protocol-grid{grid-template-columns:1fr 1fr}.limitations ul{columns:1}.section-heading span{display:none}}
