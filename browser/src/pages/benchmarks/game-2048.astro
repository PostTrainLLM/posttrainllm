---
import Default from "../../layouts/Default.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import replay from "../../data/benchmarks/game-2048-pilot-v1.json";

const clientData = JSON.stringify(replay).replaceAll("<", "\\u003c");
const measuredModels = replay.models.filter((model) => model.aggregate);
const specialist = replay.models.find((model) => model.role === "specialist-candidate");
const actionCharacter = { up: "U", down: "D", left: "L", right: "R" };
---

<Default
  title="Character 2048 LLM benchmark — posttrainllm"
  description="Inspect the retained Character 2048 benchmark failure, replay every local model move, and see why the expected intelligence advantage did not reproduce."
>
  <SiteHeader mode="instrument" active="benchmarks" />
  <!--
    THESIS: Watch the policy break, not a summary score; refuse the static leaderboard.
    OWN-WORLD: Deep-ink lab instrument, teal live state, coral failures, solid tile fields.
    STORY: Pick a model and seed, replay each decision, inspect exact input/output, reproduce it.
    FIRST VIEWPORT: Board dominates left; live decision trace and controls occupy the right rail.
    FORM: Existing posttrainllm instrument surface, preserve lane, replay console staging.
  -->
  <main>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/benchmarks">Benchmarks</a><span>/</span><span>Character 2048</span></nav>
    <header class="hero">
      <div>
        <p class="kicker">Development pilot · 3 paired seeds · no tools</p>
        <h1>Watch the policy break.</h1>
      </div>
      <p>{replay.benchmark.claim} Every frame below is a prerecorded model decision—not an animation of algorithmic play.</p>
    </header>

    <section class="evidence-note" aria-label="Evidence status">
      <span class="pulse" aria-hidden="true"></span>
      <p id="evidence-copy"><strong>Failed benchmark artifact—retained.</strong> The expected intelligence advantage did not reproduce: Sonnet matched random legal play, while the Opus cohort remained incomplete.</p>
    </section>

    <section class="admission" aria-labelledby="admission-title">
      <div>
        <p class="section-label">Gate 0 · before training</p>
        <h2 id="admission-title">First prove intelligence helps.</h2>
        <p>If a pinned frontier model cannot outperform random legal moves, we stop and choose a different game. No 30–50M specialist is trained merely to beat a broken ruler.</p>
      </div>
      <div class="gate-card" data-state="failed">
        <div class="gate-status"><span aria-hidden="true"></span><strong>Failed · artifact retained</strong></div>
        <ul>
          <li><span>Strict invalid decisions</span><strong>must be 0</strong></li>
          <li><span>Paired win rate vs random</span><strong>must be ≥60%</strong></li>
          <li><span>Mean score vs random</span><strong>must be ≥1.10×</strong></li>
          <li><span>Bootstrap lower bound</span><strong>must be positive</strong></li>
          <li><span>Frozen paired games</span><strong>30 seeds</strong></li>
        </ul>
        <p class="gate-result">Sonnet: 0.995× random over four complete games. Opus: 1.058× over three complete games—below the 1.10× bar—then one provider disconnect. No 30-seed run; no specialist training.</p>
      </div>
    </section>

    <section class="replay" aria-labelledby="replay-title">
      <div class="replay-heading">
        <div><p class="section-label">Recorded output</p><h2 id="replay-title">Decision replay</h2></div>
        <label class="file-control">Load replay JSON<input id="file-input" type="file" accept="application/json,.json" /></label>
      </div>

      <div class="run-strip" id="run-strip" aria-label="Choose a recorded model run"></div>

      <div class="stage">
        <div class="board-panel">
          <div class="scoreline">
            <div><span>Score</span><strong id="score">0</strong></div>
            <div><span>Max tile</span><strong id="max-tile">2</strong></div>
            <div><span>Move</span><strong id="move-count">0</strong></div>
          </div>
          <div class="board" id="board" role="img" aria-label="2048 board">
            {Array.from({ length: 16 }, (_, index) => <div class="tile" data-index={index}><span></span></div>)}
          </div>
          <div class="transport">
            <button id="previous" type="button" aria-label="Previous decision">←</button>
            <button id="play" class="play" type="button">Play</button>
            <button id="next" type="button" aria-label="Next decision">→</button>
            <input id="timeline" type="range" min="0" max="1" value="0" aria-label="Replay position" />
            <label>Speed <select id="speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select></label>
          </div>
        </div>

        <aside class="trace">
          <div class="trace-top">
            <div><span class="trace-label">Model</span><strong id="model-name">—</strong></div>
            <div><span class="trace-label">Seed</span><strong id="seed">—</strong></div>
          </div>
          <div class="decision">
            <p class="trace-label">Exact character input</p>
            <code id="character-input">—</code>
          </div>
          <div class="choice-grid">
            <div><span class="trace-label">Legal</span><strong id="legal-actions">—</strong></div>
            <div><span class="trace-label">Raw output</span><strong id="raw-output" class="raw">—</strong></div>
            <div><span class="trace-label">Parsed move</span><strong id="parsed-action">—</strong></div>
          </div>
          <div class="verdict" id="decision-verdict" data-state="waiting">
            <span id="verdict-mark">•</span><p id="verdict-copy">Choose a run to inspect its first decision.</p>
          </div>
          <dl class="episode-result">
            <div><dt>Episode score</dt><dd id="episode-score">—</dd></div>
            <div><dt>Terminal reason</dt><dd id="terminal-reason">—</dd></div>
            <div><dt>Trace</dt><dd id="trace-hash">—</dd></div>
          </dl>
        </aside>
      </div>
      <p class="load-error" id="load-error" role="alert" hidden></p>
    </section>

    <section class="results" aria-labelledby="results-title">
      <div class="section-heading"><div><p class="section-label">Paired development slice</p><h2 id="results-title">What happened</h2></div><span>128-move cap</span></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Policy</th><th>Role</th><th>Mean score</th><th>Mean max tile</th><th>Moves</th><th>Invalid</th><th>Median decision</th></tr></thead>
        <tbody id="results-body">
          {measuredModels.map((model) => <tr>
            <th scope="row"><span class="model-dot"></span>{model.name}<small>{model.size}</small></th>
            <td>{model.role === "small-base" ? "small base" : "general LLM"}</td>
            <td class="number">{Math.round(model.aggregate.mean_score)}</td>
            <td class="number">{Math.round(model.aggregate.mean_maximum_tile)}</td>
            <td class="number">{model.aggregate.mean_moves.toFixed(1)}</td>
            <td class:list={["number", { bad: model.aggregate.invalid_decisions > 0 }]}>{model.aggregate.invalid_decisions}</td>
            <td class="number">{Math.round(model.aggregate.median_decision_latency_ms)} ms</td>
          </tr>)}
          <tr class="specialist-row">
            <th scope="row"><span class="model-dot"></span>{specialist?.name}<small>{specialist?.size}</small></th>
            <td>specialist</td><td colspan="5"><span class="pending">Not trained — benchmark rejected at Gate 0</span></td>
          </tr>
        </tbody>
      </table></div>
      <p class="finding" id="finding"><strong>Decision:</strong> do not train on this benchmark. Sonnet matched random legal play; Opus showed only a small, incomplete advantage below the admission threshold. Keep this artifact as a documented failure, then require the next candidate to demonstrate a robust frontier-versus-random capability gradient.</p>
    </section>

    <section class="diagnostics" aria-labelledby="diagnostics-title">
      <div class="section-heading"><div><p class="section-label">Engine sanity checks</p><h2 id="diagnostics-title">Not model competitors.</h2></div><span>Never training labels</span></div>
      <div class="diagnostic-grid">
        {replay.diagnostics.map((diagnostic) => <article>
          <div><span>{diagnostic.policy_id}</span><strong>{Math.round(diagnostic.mean_score)} mean score</strong></div>
          <h3>{diagnostic.name}</h3>
          <p>{diagnostic.explanation}</p>
          <p class="advantage"><strong>Built-in advantage:</strong> {diagnostic.structural_advantage}</p>
        </article>)}
      </div>
    </section>

    <section class="protocol" aria-labelledby="protocol-title">
      <div><p class="section-label">Reproduce locally</p><h2 id="protocol-title">Same state. Same parser. Your Mac.</h2><p>{replay.reproduce.protocol}</p></div>
      <div class="command-block"><code id="command">{replay.reproduce.command_template}</code><button id="copy-command" type="button">Copy command</button></div>
      <div class="protocol-grid">
        <div><span>Observation</span><strong><code>B=&lt;16 chars&gt;;S=…;M=…;L=UDLR</code></strong></div>
        <div><span>Strict output</span><strong>Raw one character: U, D, L, or R</strong></div>
        <div><span>Runtime</span><strong>{replay.reproduce.runtime}</strong></div>
        <div><span>Constrained diagnostic</span><strong>Model chooses only among currently legal character tokens</strong></div>
      </div>
      <button class="download" id="download-replay" type="button">Download prerecorded outputs</button>
    </section>

    <section class="limitations" aria-labelledby="limitations-title">
      <h2 id="limitations-title">What this does not prove</h2>
      <ul>{replay.benchmark.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
    </section>
  </main>
  <script is:inline type="application/json" id="replay-data" set:html={clientData}></script>
</Default>

<script>
  type Decision = { input:string; board:number[]; score:number; move_count:number; legal_actions:string[]; raw_output:string; action:string|null; valid:boolean; failure:string|null };
  type Episode = { seed:number; score:number; maximum_tile:number; moves:number; terminal_reason:string; trace_hash:string; final_board:number[]; decisions:Decision[] };
  type Aggregate = { mean_score:number; mean_maximum_tile:number; mean_moves:number; invalid_decisions:number; median_decision_latency_ms:number };
  type Model = { policy_id:string; name:string; size:string; status:string; role:string; model_ref:string|null; aggregate:Aggregate|null; episodes:Episode[] };
  type ReplayData = { schema_version:string; benchmark:{ status:string }; models:Model[]; diagnostics:{ policy_id:string; mean_score:number }[] };

  const byId = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
  let replayData = JSON.parse(byId<HTMLScriptElement>("replay-data").textContent || "{}") as ReplayData;
  let runs: { model:Model; episode:Episode }[] = [];
  let selected = 0;
  let position = 0;
  let timer:number | undefined;
  const actionChars:Record<string,string> = { up:"U", down:"D", left:"L", right:"R" };

  function rebuildRuns() {
    runs = replayData.models.flatMap((model) => model.episodes.map((episode) => ({ model, episode })));
    const preferred = runs.findIndex((run) => run.model.policy_id.includes("4b") && run.episode.seed === 2048000000);
    selected = preferred >= 0 ? preferred : 0;
    position = 0;
    const strip = byId<HTMLDivElement>("run-strip");
    strip.replaceChildren(...runs.map((run, index) => {
      const button = document.createElement("button");
      button.type = "button";
      button.dataset.index = String(index);
      const name = document.createElement("span");
      name.textContent = run.model.name;
      const summary = document.createElement("small");
      summary.textContent = `seed ${run.episode.seed} · ${run.episode.score} pts`;
      button.append(name, summary);
      button.addEventListener("click", () => { selected = index; position = 0; stop(); render(); });
      return button;
    }));
    renderResults();
    render();
  }

  function appendCell(row:HTMLTableRowElement, value:string, className?:string) {
    const cell = document.createElement("td");
    cell.textContent = value;
    if (className) cell.className = className;
    row.append(cell);
    return cell;
  }

  function renderResults() {
    const body = byId<HTMLTableSectionElement>("results-body");
    body.replaceChildren(...replayData.models.map((model) => {
      const row = document.createElement("tr");
      if (model.role === "specialist-candidate") row.className = "specialist-row";

      const heading = document.createElement("th");
      heading.scope = "row";
      const dot = document.createElement("span");
      dot.className = "model-dot";
      const size = document.createElement("small");
      size.textContent = model.size;
      heading.append(dot, document.createTextNode(model.name), size);
      row.append(heading);

      const role = model.role === "small-base" ? "small base" : model.role === "specialist-candidate" ? "specialist" : "general LLM";
      appendCell(row, role);
      if (!model.aggregate) {
        const pending = appendCell(row, model.status === "awaiting-trained-candidate" ? "Awaiting trained candidate and frozen run" : model.status === "blocked-benchmark-rejected" ? "Not trained — benchmark rejected at Gate 0" : model.status, "pending");
        pending.colSpan = 5;
        return row;
      }

      appendCell(row, String(Math.round(model.aggregate.mean_score)), "number");
      appendCell(row, String(Math.round(model.aggregate.mean_maximum_tile)), "number");
      appendCell(row, model.aggregate.mean_moves.toFixed(1), "number");
      appendCell(row, String(model.aggregate.invalid_decisions), `number${model.aggregate.invalid_decisions > 0 ? " bad" : ""}`);
      appendCell(row, `${Math.round(model.aggregate.median_decision_latency_ms)} ms`, "number");
      return row;
    }));

    const frozen = replayData.benchmark?.status === "frozen";
    const rejected = replayData.benchmark?.status === "rejected-current-character-form";
    byId("evidence-copy").textContent = frozen
      ? "Frozen benchmark replay. Every result below comes from the loaded artifact."
      : rejected
        ? "Failed benchmark artifact—retained. The expected intelligence advantage did not reproduce: Sonnet matched random legal play, while the Opus cohort remained incomplete."
        : "Measured, not yet frozen. These runs test whether the task has headroom; they are not a final specialist win claim.";

    const general = replayData.models
      .filter((model) => model.role === "larger-general-llm" && model.aggregate)
      .sort((a, b) => (b.aggregate?.mean_score ?? 0) - (a.aggregate?.mean_score ?? 0))[0];
    const specialistModel = replayData.models.find((model) => model.role === "specialist-candidate" && model.aggregate);
    const random = replayData.diagnostics?.find((row) => row.policy_id === "random-legal");
    const finding = byId("finding");
    if (rejected) {
      finding.textContent = "Decision: do not train on this benchmark. Retain it as a documented failure: frontier screening did not reproduce a robust intelligence advantage over random legal play.";
    } else if (specialistModel?.aggregate && general?.aggregate) {
      finding.textContent = `${specialistModel.name} averaged ${Math.round(specialistModel.aggregate.mean_score)} points versus ${Math.round(general.aggregate.mean_score)} for the strongest larger general LLM, ${general.name}.`;
    } else if (general?.aggregate) {
      finding.textContent = `${general.name} was the strongest larger general LLM at ${Math.round(general.aggregate.mean_score)} mean points${random ? `; the paired random diagnostic averaged ${Math.round(random.mean_score)}` : ""}. The custom specialist is still awaiting a measured run.`;
    } else {
      finding.textContent = "Load a replay artifact containing measured general-model and specialist runs to compare them here.";
    }
  }

  function tileLevel(value:number) { return value ? Math.min(11, Math.log2(value)) : 0; }
  function render() {
    const run = runs[selected];
    if (!run) return;
    const { model, episode } = run;
    const decision = position < episode.decisions.length ? episode.decisions[position] : null;
    const board = decision?.board ?? episode.final_board;
    const score = decision?.score ?? episode.score;
    const move = decision?.move_count ?? episode.moves;
    const cells = [...document.querySelectorAll<HTMLElement>(".tile")];
    cells.forEach((cell,index) => {
      const value = board[index];
      const previous = cell.dataset.value;
      cell.dataset.level = String(tileLevel(value));
      cell.dataset.value = String(value);
      cell.querySelector("span")!.textContent = value ? String(value) : "";
      if (previous !== undefined && previous !== String(value)) {
        cell.classList.remove("changed"); void cell.offsetWidth; cell.classList.add("changed");
      }
    });
    byId("board").setAttribute("aria-label", `2048 board at move ${move}, score ${score}: ${board.join(", ")}`);
    byId("score").textContent = String(score);
    byId("max-tile").textContent = String(Math.max(...board));
    byId("move-count").textContent = `${move}/${episode.moves}`;
    byId("model-name").textContent = `${model.name} · ${model.size}`;
    byId("seed").textContent = String(episode.seed);
    byId("character-input").textContent = decision?.input ?? "Episode complete";
    byId("legal-actions").textContent = decision ? decision.legal_actions.map((action) => actionChars[action]).join(" ") : "—";
    byId("raw-output").textContent = decision ? JSON.stringify(decision.raw_output) : "—";
    byId("parsed-action").textContent = decision?.action ? `${actionChars[decision.action]} · ${decision.action}` : "—";
    const verdict = byId("decision-verdict");
    if (!decision) {
      verdict.dataset.state = "complete"; byId("verdict-mark").textContent = "✓"; byId("verdict-copy").textContent = "Episode complete.";
    } else if (!decision.valid) {
      verdict.dataset.state = "failed"; byId("verdict-mark").textContent = "×"; byId("verdict-copy").textContent = `Decision failed: ${decision.failure}.`;
    } else {
      verdict.dataset.state = "valid"; byId("verdict-mark").textContent = "→"; byId("verdict-copy").textContent = "Legal decision accepted by the environment.";
    }
    byId("episode-score").textContent = `${episode.score} points · max ${episode.maximum_tile}`;
    byId("terminal-reason").textContent = episode.terminal_reason;
    byId("trace-hash").textContent = episode.trace_hash.slice(0,12) + "…";
    if (model.model_ref) {
      byId("command").textContent = `python3.12 scripts/game_2048_mlx_pilot.py --model ${model.model_ref} --policy-id ${model.policy_id} --track strict --seed 2048000000 --seed 2048000001 --seed 2048000002 --max-moves 128 --output runs/game-2048/model-pilot/${model.policy_id}.json`;
    }
    const timeline = byId<HTMLInputElement>("timeline"); timeline.max = String(episode.decisions.length); timeline.value = String(position);
    byId<HTMLButtonElement>("previous").disabled = position === 0;
    byId<HTMLButtonElement>("next").disabled = position >= episode.decisions.length;
    [...byId("run-strip").querySelectorAll("button")].forEach((button,index) => {
      const active = index === selected;
      button.classList.toggle("active", active);
      button.setAttribute("aria-pressed", String(active));
    });
  }

  function step(delta:number) {
    const episode = runs[selected]?.episode; if (!episode) return;
    position = Math.max(0, Math.min(episode.decisions.length, position + delta)); render();
    if (position >= episode.decisions.length) stop();
  }
  function stop() { if (timer) window.clearInterval(timer); timer = undefined; byId<HTMLButtonElement>("play").textContent = "Play"; }
  function togglePlay() {
    if (timer) { stop(); return; }
    if (position >= runs[selected].episode.decisions.length) position = 0;
    const speed = Number(byId<HTMLSelectElement>("speed").value);
    timer = window.setInterval(() => step(1), 700 / speed);
    byId<HTMLButtonElement>("play").textContent = "Pause";
  }
  byId("play").addEventListener("click", togglePlay);
  byId("previous").addEventListener("click", () => step(-1));
  byId("next").addEventListener("click", () => step(1));
  byId("timeline").addEventListener("input", (event) => { position = Number((event.target as HTMLInputElement).value); stop(); render(); });
  byId("speed").addEventListener("change", () => { if (timer) { stop(); togglePlay(); } });
  document.addEventListener("keydown", (event) => {
    if ((event.target as HTMLElement).matches("input,select,button")) return;
    if (event.key === " ") { event.preventDefault(); togglePlay(); }
    if (event.key === "ArrowLeft") step(-1);
    if (event.key === "ArrowRight") step(1);
  });
  byId("copy-command").addEventListener("click", async () => {
    await navigator.clipboard.writeText(byId("command").textContent || "");
    byId("copy-command").textContent = "Copied"; window.setTimeout(() => byId("copy-command").textContent = "Copy command", 1400);
  });
  byId("download-replay").addEventListener("click", () => {
    const blob = new Blob([JSON.stringify(replayData,null,2)], { type:"application/json" });
    const anchor = document.createElement("a"); anchor.href = URL.createObjectURL(blob); anchor.download = "game-2048-prerecorded-outputs.json"; anchor.click(); URL.revokeObjectURL(anchor.href);
  });
  byId<HTMLInputElement>("file-input").addEventListener("change", async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0]; if (!file) return;
    try {
      const loaded = JSON.parse(await file.text()) as ReplayData;
      if (loaded.schema_version !== "game-2048/site-replay/v1") throw new Error("Expected game-2048/site-replay/v1");
      replayData = loaded; byId("load-error").hidden = true; stop(); rebuildRuns();
    } catch (error) {
      byId("load-error").hidden = false; byId("load-error").textContent = `Could not load replay: ${error instanceof Error ? error.message : String(error)}`;
    }
  });
  rebuildRuns();
</script>

<style is:global>
  :root{color-scheme:dark;--bg:#0a0c0f;--panel:#111419;--panel2:#171b22;--sunken:#06080a;--line:#2a3039;--fg:#eaedf2;--soft:#a6adb9;--quiet:#737b88;--live:#48e5c2;--coral:#ff6f5c;--warn:#ffb454}
  *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.55 "Geist Variable",system-ui,sans-serif}button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.35}a{color:var(--live)}
