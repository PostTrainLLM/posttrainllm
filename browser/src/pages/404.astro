---
/**
 * 404.astro — the site's not-found page.
 *
 * This file is load-bearing infrastructure, not just a page. Cloudflare Pages
 * decides the status code for an unmatched path by looking for the nearest
 * `404.html` in the deployed output: when one exists it is served with HTTP
 * 404, and when none exists Pages falls back to serving `/index.html` with
 * HTTP **200** (single-page-app behaviour). Until this file existed, `dist/`
 * had no root `404.html`, so every unknown path on posttrainllm.com returned
 * the homepage with a 200 — unbounded duplicate content, and no external
 * signal distinguishing "this page shipped" from "the catch-all fired again".
 * `dist/docs/404.html` (emitted by the Blume docs build) is why `/docs/*`
 * already 404'd correctly while the root did not.
 *
 * build.format = "file" is irrelevant here: Astro always emits the /404 route
 * as `dist/404.html`, which is exactly the filename Pages looks for.
 * functions/_middleware.ts already handles a 404 from `context.next()` — it
 * serves the markdown recovery body to agents that ask for text/markdown and
 * passes this HTML through to browsers — so no middleware change is needed.
 *
 * scripts/check-built-links.mjs asserts this file survives into `dist/` and is
 * not a copy of the homepage, so the defect cannot silently return.
 */
import Default from "../layouts/Default.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/system.css";

const destinations = [
  {
    href: "/docs/quickstart",
    label: "Quickstart",
    detail: "Train your first specialist on one Mac.",
  },
  {
    href: "/playground",
    label: "Web Lab",
    detail: "Train a tiny GPT in the browser, no install.",
  },
  {
    href: "/artifacts",
    label: "Artifacts",
    detail: "Evidence for every specialist we shipped.",
  },
  {
    href: "/experiments",
    label: "Experiments",
    detail: "The full ledger, including what did not work.",
  },
  {
    href: "/learn",
    label: "Learn",
    detail: "Post-training concepts, in build order.",
  },
  {
    href: "/docs",
    label: "Documentation",
    detail: "CLI reference, guides, and technique notes.",
  },
];
---

<Default
  title="404 — page not found | PostTrainLLM"
  description="That page does not exist on posttrainllm.com. Jump to the quickstart, the browser training lab, the artifact evidence index, or the full documentation."
  ogTitle="404 — page not found"
  noindex={true}
>
  <SiteHeader mode="instrument" />

  <main id="main" class="notfound">
    <header class="nf-hero">
      <p class="mono-label">HTTP 404</p>
      <h1>That page does not exist.</h1>
      <p class="lede">
        The URL you asked for is not a route on posttrainllm.com. It may have
        been renamed, or it may never have existed. Everything the site does
        publish is reachable from the links below.
      </p>
    </header>

    <nav class="nf-grid" aria-label="Suggested destinations">
      {
        destinations.map((destination) => (
          <a class="nf-card" href={destination.href}>
            <span class="nf-card-label">{destination.label}</span>
            <span class="nf-card-detail">{destination.detail}</span>
          </a>
        ))
      }
    </nav>

    <section class="nf-machine" aria-labelledby="nf-machine-heading">
      <h2 id="nf-machine-heading" class="mono-label">For crawlers and agents</h2>
      <p>
        The complete route inventory is published as a <a href="/sitemap.xml"
          >sitemap</a
        >, a <a href="/llms.txt">compact agent index</a>, and a <a
          href="/llms-full.txt">full agent brief</a
        >. Requesting any page with <code>Accept: text/markdown</code> returns a
        markdown alternate, including for this 404.
      </p>
    </section>
  </main>
</Default>

<style>
  .notfound {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) var(--gutter) var(--s-10);
  }
  .nf-hero {
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--s-7);
  }
  .mono-label {
    margin: 0 0 var(--s-3);
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nf-hero h1 {
    margin: 0 0 var(--s-4);
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.05;
    color: var(--fg);
  }
  .lede {
    max-width: var(--measure);
    margin: 0;
    color: var(--fg-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .nf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-7);
  }
  .nf-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms var(--ease-out);
  }
  .nf-card:hover,
  .nf-card:focus-visible {
    border-color: var(--accent);
  }
  .nf-card-label {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent);
  }
  .nf-card-detail {
    color: var(--fg-soft);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .nf-machine {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .nf-machine p {
    max-width: var(--measure);
    margin: 0;
    color: var(--fg-soft);
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .nf-machine a {
    color: var(--accent);
  }
  .nf-machine code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--fg);
  }
</style>
