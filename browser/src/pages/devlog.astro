---
// Source of truth for this page (the convert_to_astro.mjs HTML pipeline was removed — edit here directly).
// Edit the HTML source then re-run the script, or edit this .astro file
// directly — both are valid. Keep IDs/attributes stable for src/main.ts and
// the popover system to keep wiring up correctly.
import Default from "../layouts/Default.astro";
import SiteHeader from "../components/SiteHeader.astro";

const layoutProps = {
  title: "posttrainllm — devlog",
  description:
    "Notes from building posttrainllm — kernel measurements, honest negative results, decisions made while AI-pairing.",
  ogType: "article" as const,
  ogTitle:
    "posttrainllm — devlog: kernel measurements + honest negative results",
  ogDescription:
    "What worked, what didn't. f16 doesn't compound on top of tiling. 8×8 register block lost to 4×4. vec4 wins standalone but a WGSL access-mode mismatch breaks integration — until you find it.",
  twitterTitle: "posttrainllm — devlog",
  twitterDescription:
    "Kernel measurements, honest negative results, decisions made while AI-pairing on a GPT-2 implementation.",
  themeColor: "#0a0c0f",
  loadFonts: false,
};

const pageStyle = `
      :root {
        --bg: #0a0c0f;
        --panel: #11141a;
        --panel-2: #161a22;
        --line: #232733;
        --line-strong: #2a2f3c;
        --fg: #e7e8ea;
        --muted: #c8cbd4;
        --faint: #787d88;
        --accent: #48e5c2;
        --accent-dim: #2a8a78;
        --accent-glow: rgba(72, 229, 194, 0.12);
        --warn: #f5b14a;
        --danger: #ff6f5c;
        --brand: #ff6f5c;
        --font-display: "Bricolage Grotesque Variable", "Geist Variable", ui-sans-serif, system-ui, sans-serif;
        --font-sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-mono: "Geist Mono Variable", ui-monospace, "SF Mono", Monaco, monospace;
      }
      h1, h2, h3 { font-family: var(--font-display); letter-spacing: -0.02em; }
      h1 { letter-spacing: -0.035em; }
      * { box-sizing: border-box; }
      html, body {
        background: var(--bg);
        color: var(--fg);
        font: 15px/1.65 var(--font-sans);
        margin: 0; padding: 0;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--accent-dim); }
      a:hover { text-decoration-color: var(--accent); }

      .wrap { max-width: 780px; margin: 0 auto; padding: 56px 24px 96px; }

      header {
        border-bottom: 1px solid var(--line);
        padding-bottom: 28px;
        margin-bottom: 40px;
      }
      header .crumb {
        font: 500 11px/1 var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        margin-bottom: 12px;
      }
      header .crumb a { color: var(--faint); }
      header .crumb a:hover { color: var(--accent); }
      header h1 {
        font: 500 32px/1.2 var(--font-sans);
        margin: 0 0 12px;
        letter-spacing: -0.02em;
      }
      header .sub {
        color: var(--muted);
        font-size: 15.5px;
        margin: 0;
      }

      h2 {
        font: 500 21px/1.25 var(--font-sans);
        margin: 56px 0 14px;
        letter-spacing: -0.01em;
      }
      h3 {
        font: 500 16px/1.3 var(--font-sans);
        color: var(--muted);
        margin: 28px 0 10px;
        letter-spacing: -0.005em;
      }
      h2 .tag {
        font: 500 10.5px/1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        background: var(--accent-glow);
        border: 1px solid var(--accent-dim);
        padding: 4px 8px;
        border-radius: 4px;
        margin-left: 10px;
        vertical-align: middle;
        position: relative; top: -3px;
      }
      h2 .tag.fail {
        color: var(--warn);
        background: #f5b14a18;
        border-color: #5b4423;
      }

      p { margin: 0 0 14px; color: var(--muted); }
      strong { color: var(--fg); font-weight: 500; }
      em { color: var(--fg); font-style: italic; }
      code {
        font: 13px/1.4 var(--font-mono);
        background: var(--panel-2);
        padding: 1px 6px;
        border-radius: 3px;
        color: var(--muted);
      }
      pre {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 14px 18px;
        overflow-x: auto;
        font: 13px/1.55 var(--font-mono);
        color: var(--muted);
        margin: 14px 0 18px;
      }

      .block {
        border-left: 2px solid var(--line-strong);
        padding-left: 18px;
        margin: 22px 0;
      }
      .block.win { border-left-color: var(--accent); }
      .block.miss { border-left-color: var(--warn); }
      .block.lesson { border-left-color: #6889e6; }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
        font: 13px/1.4 var(--font-mono);
      }
      th, td {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
      }
      th {
        font: 500 11px/1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
        border-bottom: 1px solid var(--line-strong);
      }
      td:first-child { color: var(--fg); }
      td.num { font-variant-numeric: tabular-nums; color: var(--accent); }

      footer {
        margin-top: 80px;
        padding-top: 32px;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: 13px;
        display: flex; gap: 14px; flex-wrap: wrap;
      }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--accent); }
    `;

import pageBody from "../content/public/devlog.html?raw";
---

<Default {...layoutProps}>
  <SiteHeader mode="instrument" active="changelog" />
  <style is:global slot="head" set:html={pageStyle}></style>
  <Fragment set:html={pageBody} />
</Default>
