---
import Default from "../../layouts/Default.astro";
import { artifacts, getArtifact, stateLabel } from "../../artifacts";

export function getStaticPaths() {
  return artifacts.map((entry) => ({ params: { slug: entry.slug } }));
}

const artifact = getArtifact(Astro.params.slug ?? "");
if (!artifact) {
  return Astro.redirect("/artifacts");
}

const layoutProps = {
  title: `TinyGPT Artifact — ${artifact.title}`,
  description: artifact.summary,
  ogType: "article" as const,
  ogTitle: `TinyGPT Artifact — ${artifact.title}`,
  ogDescription: artifact.summary,
  themeColor: "#0a0c10",
};
---

<Default {...layoutProps}>
  <main class="artifact-detail">
    <header class="hero">
      <nav class="crumb"><a href="/">TinyGPT</a> / <a href="/artifacts">artifacts</a> / {artifact.slug}</nav>
      <div class="meta-row">
        <span>{artifact.eyebrow}</span>
        <span data-state={artifact.state}>{stateLabel[artifact.state]}</span>
        <span>{artifact.date}</span>
      </div>
      <h1>{artifact.title}</h1>
      <p class="lede">{artifact.lede}</p>
      <ul class="tags" aria-label="Tags">
        {artifact.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    <section aria-labelledby="metrics">
      <h2 id="metrics">Headline Numbers</h2>
      <div class="metric-grid">
        {artifact.metrics.map((metric) => (
          <article>
            <p>{metric.label}</p>
            <strong>{metric.value}</strong>
            <span>{metric.context}</span>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="competition">
      <h2 id="competition">Competitive Context</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>System</th>
              <th>Metric</th>
              <th>Score</th>
              <th>Size / Class</th>
              <th>Comparable?</th>
              <th>Readout</th>
            </tr>
          </thead>
          <tbody>
            {artifact.comparisons.map((comparison) => (
              <tr>
                <td>
                  {comparison.sourceHref ? (
                    <a href={comparison.sourceHref}>{comparison.name}</a>
                  ) : (
                    comparison.name
                  )}
                </td>
                <td>{comparison.metric}</td>
                <td>{comparison.score}</td>
                <td>{comparison.size}</td>
                <td><span class="compare-chip">{comparison.comparability}</span></td>
                <td>{comparison.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="comparison-note">
        Direct rows share this artifact's eval setup. Directional rows are useful
        market context but should not be read as leaderboard claims.
      </p>
    </section>

    {artifact.tables.map((table) => (
      <section aria-labelledby={`${artifact.slug}-${table.title.replace(/\W+/g, "-").toLowerCase()}`}>
        <h2 id={`${artifact.slug}-${table.title.replace(/\W+/g, "-").toLowerCase()}`}>{table.title}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>{table.columns.map((col) => <th>{col}</th>)}</tr>
            </thead>
            <tbody>
              {table.rows.map((row) => (
                <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section aria-labelledby="blockers">
      <h2 id="blockers">Release Blockers</h2>
      <div class="blockers">
        {artifact.blockers.map((item) => (
          <article>
            <h3>{item.blocker}</h3>
            <p>{item.why}</p>
            <p><strong>Unblock:</strong> {item.unblock}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="evidence">
      <h2 id="evidence">Evidence</h2>
      <ul class="evidence-list">
        {artifact.evidence.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="next-action" aria-labelledby="next-action">
      <h2 id="next-action">Next Release Action</h2>
      <p>{artifact.nextAction}</p>
    </section>
  </main>
</Default>

<style>
  :root {
    --bg: #0a0c10;
    --panel: #11141a;
    --panel-2: #151922;
    --line: #252b36;
    --fg: #edf0f5;
    --muted: #b9c0ca;
    --faint: #7e8794;
    --accent: #49dfbd;
    --warn: #f4b860;
    --blue: #8ab4ff;
    --font-sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "Geist Mono Variable", ui-monospace, "SF Mono", Monaco, monospace;
  }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-sans); }
  a { color: var(--accent); text-decoration-color: color-mix(in srgb, var(--accent), transparent 55%); text-underline-offset: 3px; }
  a:hover { text-decoration-color: var(--accent); }
  .artifact-detail { max-width: 980px; margin: 0 auto; padding: 48px 24px 88px; }
  .hero { border-bottom: 1px solid var(--line); padding-bottom: 30px; margin-bottom: 38px; }
  .crumb { color: var(--faint); font: 12px/1.4 var(--font-mono); margin-bottom: 30px; }
  .meta-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .meta-row span { border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font: 12px/1 var(--font-mono); padding: 8px 10px; }
  .meta-row span:first-child { color: var(--accent); }
  .meta-row span[data-state="candidate-current-best"] { color: var(--warn); border-color: color-mix(in srgb, var(--warn), transparent 45%); }
  .meta-row span[data-state="report-only"] { color: var(--blue); border-color: color-mix(in srgb, var(--blue), transparent 45%); }
  h1 { max-width: 860px; font-size: clamp(40px, 7vw, 74px); line-height: .98; letter-spacing: 0; margin: 0 0 20px; }
  .lede { max-width: 760px; color: var(--muted); font-size: 18px; line-height: 1.65; margin: 0; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; list-style: none; margin: 24px 0 0; padding: 0; }
  .tags li { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; color: var(--muted); font: 12px/1 var(--font-mono); padding: 8px 9px; }
  section { margin-top: 44px; }
  h2 { font-size: 22px; line-height: 1.2; margin: 0 0 16px; }
  .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .metric-grid article { background: var(--panel); padding: 16px; min-width: 0; }
  .metric-grid p { color: var(--faint); font: 12px/1.3 var(--font-mono); margin: 0 0 10px; }
  .metric-grid strong { display: block; color: var(--accent); font: 700 28px/1 var(--font-mono); overflow-wrap: anywhere; margin-bottom: 10px; }
  .metric-grid span { color: var(--muted); line-height: 1.45; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); background: var(--panel); }
  table { width: 100%; border-collapse: collapse; min-width: 620px; }
  th, td { border-bottom: 1px solid var(--line); padding: 12px 14px; text-align: left; vertical-align: top; }
  th { color: var(--faint); font: 600 11px/1 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  td { color: var(--muted); line-height: 1.45; }
  td:first-child { color: var(--fg); }
  tr:last-child td { border-bottom: 0; }
  .compare-chip { border: 1px solid var(--line); border-radius: 999px; color: var(--muted); display: inline-block; font: 11px/1 var(--font-mono); padding: 6px 8px; white-space: nowrap; }
  .comparison-note { color: var(--faint); font: 13px/1.55 var(--font-mono); margin: 12px 0 0; }
  .blockers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .blockers article { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
  .blockers h3 { margin: 0 0 10px; font-size: 18px; }
  .blockers p { color: var(--muted); margin: 0 0 10px; line-height: 1.55; }
  .blockers p:last-child { margin-bottom: 0; }
  .blockers strong { color: var(--fg); }
  .evidence-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; list-style: none; margin: 0; padding: 0; }
  .evidence-list li { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px; }
  .next-action { border: 1px solid color-mix(in srgb, var(--accent), transparent 60%); background: color-mix(in srgb, var(--accent), transparent 93%); border-radius: 8px; padding: 18px; }
  .next-action h2 { margin-bottom: 10px; }
  .next-action p { color: var(--muted); font-size: 17px; line-height: 1.6; margin: 0; }
  @media (max-width: 820px) {
    .artifact-detail { padding: 32px 16px 64px; }
    .metric-grid, .blockers, .evidence-list { grid-template-columns: 1fr; }
  }
</style>
