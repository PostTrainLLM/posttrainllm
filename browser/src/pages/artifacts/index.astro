---
import Default from "../../layouts/Default.astro";
import "../../styles/system.css";
import { artifacts, outcomeLabel, stateLabel } from "../../artifacts";
import SiteHeader from "../../components/SiteHeader.astro";

const layoutProps = {
  title: "posttrainllm — public artifacts",
  description:
    "Public posttrainllm artifacts: measured model packages, routed specialists, benchmark reports, blockers, and release status.",
  ogTitle: "posttrainllm — public artifacts",
  ogDescription:
    "Measured model packages, routed specialists, benchmark reports, blockers, and release status.",
  themeColor: "#0a0c0f",
};

const primaryArtifacts = artifacts.filter((entry) => entry.state !== "parked");
const parkedArtifacts = artifacts.filter((entry) => entry.state === "parked");
const publishedModelArtifacts = artifacts.filter((entry) => entry.modelRepoId);
---

<Default {...layoutProps}>
  <SiteHeader mode="instrument" active="specialists" />
  <main id="main" class="artifact-page">
    <header class="hero">
      <nav class="crumb"><a href="/">posttrainllm</a> / artifacts</nav>
      <p class="kicker">Six published models · six case studies</p>
      <h1>Every public model, with the result and the failure mode.</h1>
      <p class="lede">
        Every PostTrainLLM model on Hugging Face now has a first-class case
        study, including routed wins, a sealed-eval rejection, a
        negative-transfer failure, a conversion-only release, and an unevaluated
        checkpoint. Hub request counters are not treated as users or adoption.
        The rest of the registry preserves benchmark reports and process
        artifacts.
      </p>
      <div class="summary-grid" aria-label="Artifact summary">
        <div>
          <span>{publishedModelArtifacts.length}</span><small
            >published model case studies</small
          >
        </div>
        <div>
          <span>{artifacts.length}</span><small>tracked public artifacts</small>
        </div>
        <div>
          <span>{parkedArtifacts.length}</span><small>parked but public</small>
        </div>
      </div>
    </header>

    <section class="artifact-list" aria-labelledby="active-artifacts">
      <h2 id="active-artifacts">Current Release Surface</h2>
      <div class="cards">
        {
          primaryArtifacts.map((entry) => (
            <article class="artifact-card">
              <div class="card-head">
                <p>{entry.eyebrow}</p>
                <span data-state={entry.state}>{stateLabel[entry.state]}</span>
              </div>
              <h3>
                <a href={`/artifacts/${entry.slug}`}>{entry.title}</a>
              </h3>
              <p class="summary">{entry.summary}</p>
              {entry.modelRepoId && (
                <p class="model-link">
                  <a href={`https://huggingface.co/${entry.modelRepoId}`}>
                    Hugging Face model ↗
                  </a>
                </p>
              )}
              <dl class="metric-strip">
                {entry.metrics.slice(0, 3).map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="competition">
                <strong>Competition:</strong>{" "}
                {`${entry.comparisons[0]?.name ?? "None"}${entry.comparisons[1] ? ` vs ${entry.comparisons[1].name}` : ""}`}
              </p>
              <p class="next">
                <strong>Next:</strong> {entry.nextAction}
              </p>
              {entry.reportCard && (
                <p class="report-card">
                  <span class="outcome" data-outcome={entry.reportCard.outcome}>
                    {outcomeLabel[entry.reportCard.outcome]}
                  </span>
                  <span
                    class="verified"
                    data-verified={String(entry.reportCard.verified)}
                  >
                    {entry.reportCard.verified
                      ? "fully verified"
                      : "not fully verified"}
                  </span>
                  <a href={entry.reportCard.href}>Report card →</a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="artifact-list" aria-labelledby="parked-artifacts">
      <h2 id="parked-artifacts">Parked Public Evidence</h2>
      <div class="cards compact">
        {
          parkedArtifacts.map((entry) => (
            <article class="artifact-card">
              <div class="card-head">
                <p>{entry.eyebrow}</p>
                <span data-state={entry.state}>{stateLabel[entry.state]}</span>
              </div>
              <h3>
                <a href={`/artifacts/${entry.slug}`}>{entry.title}</a>
              </h3>
              <p class="summary">{entry.summary}</p>
            </article>
          ))
        }
      </div>
    </section>
    <aside class="guide-link">
      <span>From package to decision</span>
      <a href="/evaluate-local-llm">Use the local-model evaluation workflow →</a
      >
    </aside>
  </main>
</Default>

<style>
  .artifact-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 60px) var(--gutter) var(--s-10);
  }
  .hero {
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--s-7);
    margin-bottom: var(--s-7);
  }
  .crumb {
    display: none;
  }
  .kicker {
    color: var(--live);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin: 0 0 var(--s-4);
  }
  .artifact-page h1 {
    max-width: 18ch;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 0 0 var(--s-5);
  }
  .lede {
    max-width: 62ch;
    color: var(--fg-soft);
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 0;
  }
  .model-link {
    margin: calc(var(--s-3) * -1) 0 var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .model-link a {
    color: var(--brand);
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-7);
  }
  .summary-grid div {
    padding-top: var(--s-4);
    border-top: 2px solid var(--ink);
  }
  .summary-grid span {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 620;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .summary-grid small {
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .artifact-list {
    margin-top: var(--s-8);
  }
  .artifact-page h2 {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-5);
    color: var(--ink);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .cards.compact {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .artifact-card {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--r-3);
    padding: var(--s-5);
    min-width: 0;
    box-shadow: var(--shadow-1);
    transition:
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .artifact-card:hover {
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .card-head p {
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin: 0;
  }
  .card-head span {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--fg-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 4px 10px;
    white-space: nowrap;
  }
  .card-head span[data-state="report-ready-candidate"],
  .card-head span[data-state="candidate-current-best"] {
    color: var(--brand);
    border-color: color-mix(in oklab, var(--brand) 38%, var(--line));
    background: var(--brand-wash);
  }
  .card-head span[data-state="release-ready-weights"],
  .card-head span[data-state="release-ready-metadata"] {
    color: var(--live);
    border-color: color-mix(in oklab, var(--live) 38%, var(--line));
    background: var(--live-wash);
  }
  .card-head span[data-state="report-only"] {
    color: var(--fg-soft);
  }
  .artifact-card h3 {
    font-size: var(--step-1);
    line-height: 1.15;
    margin: 0 0 var(--s-3);
  }
  .artifact-card h3 a {
    color: var(--ink);
  }
  .artifact-card h3 a:hover {
    color: var(--brand);
  }
  .summary {
    color: var(--fg-soft);
    line-height: 1.6;
    margin: 0 0 var(--s-5);
    font-size: var(--step-0);
  }
  .metric-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .metric-strip div {
    min-width: 0;
  }
  .metric-strip dt {
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin-bottom: 6px;
  }
  .metric-strip dd {
    color: var(--live);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--step-1);
    margin: 0;
    overflow-wrap: anywhere;
  }
  .competition {
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin: 0 0 var(--s-4);
  }
  .competition strong {
    color: var(--fg-soft);
  }
  .next {
    border-top: 1px solid var(--line);
    color: var(--fg-soft);
    padding-top: var(--s-4);
    margin: 0;
    line-height: 1.5;
    font-size: var(--step-0);
  }
  .report-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .report-card .outcome {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 8px;
    color: var(--ink);
  }
  .report-card .verified[data-verified="false"] {
    color: var(--fg-quiet);
  }
  .report-card .verified[data-verified="true"] {
    color: var(--live);
  }
  .next strong {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .summary-grid,
    .cards,
    .cards.compact {
      grid-template-columns: 1fr;
    }
    .metric-strip {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .card-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  .guide-link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-block: var(--s-5);
    border-block: 1px solid var(--line);
    color: var(--fg-quiet);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
