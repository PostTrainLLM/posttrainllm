---
import Default from "../../layouts/Default.astro";
import { artifacts, stateLabel } from "../../artifacts";

const layoutProps = {
  title: "TinyGPT — public artifacts",
  description:
    "Public TinyGPT artifacts: measured model packages, routed specialists, benchmark reports, blockers, and release status.",
  ogTitle: "TinyGPT — public artifacts",
  ogDescription:
    "Measured model packages, routed specialists, benchmark reports, blockers, and release status.",
  themeColor: "#0a0c10",
};

const primaryArtifacts = artifacts.filter((entry) => entry.state !== "parked");
const parkedArtifacts = artifacts.filter((entry) => entry.state === "parked");
---

<Default {...layoutProps}>
  <main class="artifact-page">
    <header class="hero">
      <nav class="crumb"><a href="/">TinyGPT</a> / artifacts</nav>
      <p class="kicker">Built-in artifact log</p>
      <h1>Public artifacts, with the numbers and the blockers.</h1>
      <p class="lede">
        These are the publishable units of the TinyGPT factory: model packages,
        routed candidates, benchmark reports, and process artifacts. Each entry
        carries measured evidence, competitive context, and the exact reason it
        is ready, blocked, or parked.
      </p>
      <div class="summary-grid" aria-label="Artifact summary">
        <div><span>{artifacts.length}</span><small>tracked artifacts</small></div>
        <div><span>{primaryArtifacts.length}</span><small>active/reportable</small></div>
        <div><span>{parkedArtifacts.length}</span><small>parked but public</small></div>
      </div>
    </header>

    <section class="artifact-list" aria-labelledby="active-artifacts">
      <h2 id="active-artifacts">Current Release Surface</h2>
      <div class="cards">
        {primaryArtifacts.map((entry) => (
          <article class="artifact-card">
            <div class="card-head">
              <p>{entry.eyebrow}</p>
              <span data-state={entry.state}>{stateLabel[entry.state]}</span>
            </div>
            <h3><a href={`/artifacts/${entry.slug}`}>{entry.title}</a></h3>
            <p class="summary">{entry.summary}</p>
            <dl class="metric-strip">
              {entry.metrics.slice(0, 3).map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
            <p class="competition">
              <strong>Competition:</strong>{" "}
              {`${entry.comparisons[0]?.name ?? "None"}${entry.comparisons[1] ? ` vs ${entry.comparisons[1].name}` : ""}`}
            </p>
            <p class="next"><strong>Next:</strong> {entry.nextAction}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="artifact-list" aria-labelledby="parked-artifacts">
      <h2 id="parked-artifacts">Parked Public Evidence</h2>
      <div class="cards compact">
        {parkedArtifacts.map((entry) => (
          <article class="artifact-card">
            <div class="card-head">
              <p>{entry.eyebrow}</p>
              <span data-state={entry.state}>{stateLabel[entry.state]}</span>
            </div>
            <h3><a href={`/artifacts/${entry.slug}`}>{entry.title}</a></h3>
            <p class="summary">{entry.summary}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Default>

<style>
  :root {
    --bg: #0a0c10;
    --panel: #11141a;
    --panel-2: #151922;
    --line: #252b36;
    --fg: #edf0f5;
    --muted: #b9c0ca;
    --faint: #7e8794;
    --accent: #49dfbd;
    --accent-2: #9dca72;
    --warn: #f4b860;
    --blue: #8ab4ff;
    --font-sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "Geist Mono Variable", ui-monospace, "SF Mono", Monaco, monospace;
  }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-sans); }
  a { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent), transparent 50%); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  .artifact-page { max-width: 1120px; margin: 0 auto; padding: 48px 24px 88px; }
  .hero { border-bottom: 1px solid var(--line); padding-bottom: 34px; margin-bottom: 38px; }
  .crumb { color: var(--faint); font: 12px/1.4 var(--font-mono); margin-bottom: 34px; }
  .kicker { color: var(--accent); font: 600 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 14px; }
  h1 { max-width: 820px; font-size: clamp(42px, 7vw, 76px); line-height: .96; letter-spacing: 0; margin: 0 0 22px; }
  .lede { max-width: 760px; color: var(--muted); font-size: 18px; line-height: 1.65; margin: 0; }
  .summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); margin-top: 34px; border: 1px solid var(--line); }
  .summary-grid div { background: var(--panel); padding: 18px; }
  .summary-grid span { display: block; font: 600 30px/1 var(--font-mono); color: var(--accent); }
  .summary-grid small { color: var(--faint); font: 12px/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .artifact-list { margin-top: 44px; }
  h2 { font-size: 22px; line-height: 1.2; margin: 0 0 18px; letter-spacing: 0; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .cards.compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .artifact-card { border: 1px solid var(--line); background: var(--panel); border-radius: 8px; padding: 18px; min-width: 0; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .card-head p { color: var(--faint); font: 600 11px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .card-head span { border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font: 12px/1 var(--font-mono); padding: 7px 9px; white-space: nowrap; }
  .card-head span[data-state="candidate-current-best"] { color: var(--warn); border-color: color-mix(in srgb, var(--warn), transparent 45%); }
  .card-head span[data-state="report-ready-candidate"] { color: var(--warn); border-color: color-mix(in srgb, var(--warn), transparent 45%); }
  .card-head span[data-state="release-ready-metadata"] { color: var(--accent-2); border-color: color-mix(in srgb, var(--accent-2), transparent 45%); }
  .card-head span[data-state="report-only"] { color: var(--blue); border-color: color-mix(in srgb, var(--blue), transparent 45%); }
  .artifact-card h3 { font-size: 24px; line-height: 1.15; margin: 0 0 10px; letter-spacing: 0; }
  .summary { color: var(--muted); line-height: 1.6; margin: 0 0 18px; }
  .metric-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin: 0 0 16px; }
  .metric-strip div { background: var(--panel-2); padding: 12px; min-width: 0; }
  .metric-strip dt { color: var(--faint); font: 11px/1.3 var(--font-mono); margin-bottom: 8px; }
  .metric-strip dd { color: var(--accent); font: 700 20px/1 var(--font-mono); margin: 0; overflow-wrap: anywhere; }
  .competition { color: var(--faint); font: 13px/1.5 var(--font-mono); margin: 0 0 14px; }
  .competition strong { color: var(--muted); }
  .next { border-top: 1px solid var(--line); color: var(--muted); padding-top: 14px; margin: 0; line-height: 1.5; }
  .next strong { color: var(--fg); }
  @media (max-width: 760px) {
    .artifact-page { padding: 32px 16px 64px; }
    .summary-grid, .cards, .cards.compact { grid-template-columns: 1fr; }
    .metric-strip { grid-template-columns: 1fr; }
    .card-head { align-items: flex-start; flex-direction: column; }
  }
</style>
