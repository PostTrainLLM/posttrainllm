---
import EvidenceDossier from "../../components/content/EvidenceDossier.astro";
import {
  experimentRecords,
  type KnowledgeRecord,
} from "../../data/knowledgeGraph";

export function getStaticPaths() {
  return experimentRecords.map((record) => ({
    params: { id: record.id },
    props: { record },
  }));
}

const { record } = Astro.props as { record: KnowledgeRecord };
---

<EvidenceDossier
  record={record}
  backHref="/experiments"
  backLabel="experiments"
  active="experiments"
/>
