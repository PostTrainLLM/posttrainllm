---
// Source of truth for this page (the convert_to_astro.mjs HTML pipeline was removed — edit here directly).
// Edit the HTML source then re-run the script, or edit this .astro file
// directly — both are valid. Keep IDs/attributes stable for src/main.ts and
// the popover system to keep wiring up correctly.
import Default from "../layouts/Default.astro";
import SiteHeader from "../components/SiteHeader.astro";

const layoutProps = {
  title: "posttrainllm — the performance journey",
  description:
    "The performance journey of posttrainllm — every speed lever, what's shipped, what's blocked, and why.",
  ogType: "article" as const,
  ogTitle: "posttrainllm — the performance journey",
  ogDescription:
    "Every speed lever, what's shipped, what's blocked, and why. Scalar → SIMD → threads → WebGPU naive → blocked-4×4, with verified measurements separated from the historical WebGPU curve that still needs a hardware receipt.",
  twitterTitle: "posttrainllm — the performance journey",
  twitterDescription:
    "Every speed lever in posttrainllm, what's shipped, what's blocked, and why — with reproducible numbers.",
  themeColor: "#0a0c0f",
};

const pageStyle = `
      :root {
        color-scheme: dark;
        --base: #0a0c0f;
        --panel: #0d0e10;
        --panel-2: #141518;
        --line: #1d1f23;
        --line-strong: #2c2f35;
        --fg: #e7e8ea;
        --muted: #9296a0;
        --faint: #787d88;
        --accent: #48e5c2;
        --accent-dim: #1f6f5f;
        --accent-glow: #48e5c233;
        --warn: #f5b14a;
        --danger: #ff6868;
        --font-sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-mono: "Geist Mono Variable", ui-monospace, "SF Mono", "JetBrains Mono", monospace;
        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      }
      * { box-sizing: border-box; }
      html, body { background: var(--base); }
      body {
        margin: 0;
        font: 15px/1.6 var(--font-sans);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: "";
        position: fixed; inset: 0;
        background:
          radial-gradient(ellipse 800px 400px at 30% -10%, rgba(72, 229, 194, 0.06), transparent 70%),
          radial-gradient(ellipse 600px 400px at 90% 10%, rgba(72, 229, 194, 0.04), transparent 70%);
        pointer-events: none; z-index: -1;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, pre { font-family: var(--font-mono); }

      .wrap { max-width: 820px; margin: 0 auto; padding: 64px 28px 160px; }

      /* Header */
      header { margin-bottom: 56px; }
      .nav-back {
        display: inline-flex; align-items: center; gap: 6px;
        font: 500 12px/1 var(--font-mono);
        color: var(--muted);
        padding: 7px 12px;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.18s ease;
        margin-bottom: 28px;
      }
      .nav-back:hover {
        color: var(--accent);
        border-color: var(--accent-dim);
        background: var(--accent-glow);
        text-decoration: none;
        transform: translateX(-2px);
      }
      .brand {
        display: flex; align-items: center; gap: 14px;
        margin: 0 0 18px;
      }
      .brand-mark svg {
        filter: drop-shadow(0 0 8px rgba(72, 229, 194, 0.18));
      }
      .brand h1 {
        font-size: 32px; font-weight: 600; letter-spacing: -0.015em;
        margin: 0;
        background: linear-gradient(135deg, var(--fg) 0%, var(--accent) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .brand .tag {
        font: 500 10.5px/1 var(--font-mono);
        color: var(--accent);
        border: 1px solid var(--accent-dim);
        background: var(--accent-glow);
        padding: 5px 9px; border-radius: 999px;
        letter-spacing: 0.06em; text-transform: uppercase;
      }
      .lede {
        color: var(--muted);
        font-size: 15.5px; line-height: 1.7;
        max-width: 680px;
      }
      .lede strong { color: var(--fg); font-weight: 500; }
      .lede em { color: var(--accent); font-style: normal; }

      /* Status legend */
      .legend {
        display: flex; gap: 12px; flex-wrap: wrap;
        margin: 36px 0 56px;
        padding: 18px 22px;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-radius: 10px;
      }
      .legend-item {
        display: inline-flex; align-items: center; gap: 8px;
        font: 500 12px/1 var(--font-mono);
        color: var(--muted);
      }
      .legend-item .dot {
        width: 8px; height: 8px; border-radius: 50%;
        display: inline-block;
      }

      /* Lever cards */
      .lever {
        margin-bottom: 32px;
        padding: 28px 32px;
        background: linear-gradient(180deg, var(--panel) 0%, color-mix(in srgb, var(--panel) 96%, var(--base)) 100%);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition: border-color 0.18s ease, transform 0.18s ease;
        animation: rise-in 0.5s var(--ease-out-expo) both;
      }
      .lever:hover {
        border-color: var(--line-strong);
        transform: translateY(-2px);
      }
      .lever:nth-of-type(2) { animation-delay: 0.03s; }
      .lever:nth-of-type(3) { animation-delay: 0.06s; }
      .lever:nth-of-type(4) { animation-delay: 0.09s; }
      .lever:nth-of-type(5) { animation-delay: 0.12s; }
      .lever:nth-of-type(6) { animation-delay: 0.15s; }
      .lever:nth-of-type(7) { animation-delay: 0.18s; }
      .lever:nth-of-type(8) { animation-delay: 0.21s; }
      .lever:nth-of-type(9) { animation-delay: 0.24s; }
      @keyframes rise-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .lever { animation: none; }
      }

      .lever-head {
        display: flex; align-items: flex-start; gap: 14px;
        margin-bottom: 16px;
        flex-wrap: wrap;
      }
      .lever-num {
        font: 600 11px/1 var(--font-mono);
        color: var(--accent);
        background: var(--accent-glow);
        border: 1px solid var(--accent-dim);
        border-radius: 50%;
        width: 28px; height: 28px;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .lever-title {
        flex: 1; min-width: 0;
        font: 500 17px/1.3 var(--font-sans);
        color: var(--fg);
        letter-spacing: -0.005em;
        margin: 4px 0 0;
      }

      .status {
        display: inline-flex; align-items: center; gap: 6px;
        font: 500 11px/1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 5px 10px;
        border-radius: 999px;
        white-space: nowrap;
      }
      .status .dot {
        width: 6px; height: 6px; border-radius: 50%;
        display: inline-block;
      }
      .status.shipped { color: var(--accent); background: var(--accent-glow); border: 1px solid var(--accent-dim); }
      .status.shipped .dot { background: var(--accent); }
      .status.partial { color: var(--warn); background: #f5b14a1f; border: 1px solid #5b4423; }
      .status.partial .dot { background: var(--warn); animation: pulse 1.6s ease-in-out infinite; }
      .status.blocked { color: var(--danger); background: #ff68681c; border: 1px solid #5b2a2a; }
      .status.blocked .dot { background: var(--danger); }
      .status.open { color: var(--muted); background: var(--panel-2); border: 1px solid var(--line-strong); }
      .status.open .dot { background: var(--muted); }
      .status.in-progress { color: var(--warn); background: #f5b14a1f; border: 1px solid #5b4423; }
      .status.in-progress .dot { background: var(--warn); animation: pulse 1.6s ease-in-out infinite; }
      .status.planned { color: var(--muted); background: var(--panel-2); border: 1px solid var(--line); }
      .status.planned .dot { background: var(--muted); }
      .status.withdrawn { color: var(--faint); background: transparent; border: 1px dashed var(--line); }
      .status.withdrawn .dot { background: var(--faint); opacity: 0.6; }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.4); }
      }

      .lever-meta {
        display: flex; gap: 16px; flex-wrap: wrap;
        margin: 4px 0 18px 42px;
        font: 500 12px/1 var(--font-mono);
        color: var(--faint);
      }
      .lever-meta strong { color: var(--accent); font-weight: 500; }

      .lever-body { color: var(--muted); font-size: 14.5px; line-height: 1.65; }
      .lever-body p { margin: 0 0 12px; }
      .lever-body p:last-child { margin-bottom: 0; }
      .lever-body strong { color: var(--fg); font-weight: 500; }
      .lever-body code {
        background: var(--panel-2);
        border: 1px solid var(--line);
        color: var(--accent);
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 12.5px;
      }
      .lever-body a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--accent-dim); }
      .lever-body .why { display: flex; gap: 10px; margin-top: 14px; }
      .lever-body .why-key {
        font: 500 11px/1.5 var(--font-mono);
        color: var(--faint);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        min-width: 80px;
        padding-top: 1px;
      }
      .lever-body .why-val { flex: 1; }
      .lever-body ul { margin: 8px 0 0 18px; padding: 0; }
      .lever-body li { margin: 4px 0; }

      /* Benchmark log + tables */
      .bench-log {
        background: linear-gradient(180deg, var(--panel) 0%, color-mix(in srgb, var(--panel) 92%, var(--accent-glow)) 100%);
        border-color: var(--accent-dim);
      }
      .bench-log .lever-num {
        background: var(--accent-glow);
        color: var(--accent);
        border-color: var(--accent-dim);
      }
      .bench-table {
        width: 100%;
        margin: 14px 0;
        border-collapse: collapse;
        font: 500 12.5px/1.4 var(--font-mono);
      }
      .bench-table thead th {
        text-align: left;
        font: 500 10.5px/1 var(--font-mono);
        color: var(--faint);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 8px 12px;
        border-bottom: 1px solid var(--line-strong);
      }
      .bench-table tbody td {
        padding: 8px 12px;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .bench-table tbody tr:last-child td { border-bottom: none; }
      .bench-table tbody td:first-child { color: var(--fg); font-weight: 500; }

      /* Speed-evolution chart */
      .evo-chart {
        margin-top: 6px;
        display: grid;
        gap: 8px;
      }
      .evo-row {
        display: grid;
        grid-template-columns: 200px 1fr 64px 78px;
        align-items: center;
        gap: 12px;
        font: 500 12.5px/1 var(--font-mono);
      }
      .evo-label {
        color: var(--muted);
        text-align: right;
        white-space: nowrap;
      }
      .evo-bar {
        height: 14px;
        width: var(--w);
        border-radius: 3px;
        transition: filter 0.18s ease;
      }
      .evo-bar.shipped {
        background: linear-gradient(90deg, var(--accent-dim), var(--accent));
        box-shadow: 0 0 12px var(--accent-glow);
      }
      .evo-bar.planned {
        background: repeating-linear-gradient(
          135deg,
          #3a3f4a 0px,
          #3a3f4a 6px,
          #4a4f5a 6px,
          #4a4f5a 12px
        );
        opacity: 0.78;
      }
      .evo-bar:hover { filter: brightness(1.15); }
      .evo-val {
        color: var(--fg);
        font-weight: 500;
        text-align: right;
      }
      .evo-tag {
        font: 500 10.5px/1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
        text-align: left;
      }
      .evo-row:has(.evo-bar.shipped) .evo-tag {
        color: var(--accent);
      }
      @media (max-width: 720px) {
        .evo-row {
          grid-template-columns: 1fr;
          gap: 4px;
          padding: 8px 0;
          border-bottom: 1px dashed var(--line);
        }
        .evo-row:last-child { border-bottom: none; }
        .evo-label { text-align: left; }
        .evo-bar { width: var(--w); }
        .evo-val { text-align: left; }
      }

      footer {
        margin-top: 80px;
        padding-top: 32px;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: 13px;
        display: flex; gap: 14px; flex-wrap: wrap;
      }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--accent); }
    `;

import pageBody from "../content/public/roadmap.html?raw";
---

<Default {...layoutProps}>
  <SiteHeader mode="instrument" active="changelog" />
  <style is:global slot="head" set:html={pageStyle}></style>
  <Fragment set:html={pageBody} />
</Default>
