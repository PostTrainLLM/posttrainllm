<style>
  .education-directory {
    max-width: 1040px;
    margin: var(--s-9) auto 0;
    padding: var(--s-7) var(--gutter);
    border-block: 1px solid var(--line);
  }
  .education-directory h2 {
    max-width: 18ch;
    margin-top: var(--s-3);
  }
  .education-directory > p:not(.section-label) {
    max-width: 60ch;
    margin-top: var(--s-4);
    color: var(--fg-soft);
  }
  .education-directory > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .education-directory a {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
  }
  .education-directory a:nth-child(odd) {
    padding-right: var(--s-5);
  }
  .education-directory a:nth-child(even) {
    padding-left: var(--s-5);
    border-left: 1px solid var(--line);
  }
  .education-directory a:hover {
    color: var(--live);
  }
  @media (max-width: 700px) {
    .education-directory > div {
      grid-template-columns: 1fr;
    }
    .education-directory a:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>

<style is:global>
  .landing {
    padding-bottom: 0;
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(40px, 6vw, 80px);
    background: radial-gradient(
      110% 70% at 18% 0%,
      rgba(72, 229, 194, 0.07),
      transparent 55%
    );
  }
  .hero-curve {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-curve-band {
    position: relative;
    height: clamp(190px, 20vw, 280px);
    margin-top: clamp(40px, 3.5vw, 48px);
  }
  .hero-curve-caption-wrap {
    position: relative;
    z-index: 1;
    height: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hc-line {
      stroke-dasharray: 2200;
      stroke-dashoffset: 2200;
      animation: draw 2.6s var(--ease-out-expo) 0.3s forwards;
    }
    .hc-fill {
      opacity: 0;
      animation: fadein 1.6s var(--ease-out) 1.6s forwards;
    }
    .hc-dot {
      opacity: 0;
      animation: fadein 0.5s ease 2.6s forwards;
      filter: drop-shadow(0 0 8px rgba(72, 229, 194, 0.8));
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes fadein {
      to {
        opacity: 1;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-dot {
      filter: drop-shadow(0 0 8px rgba(72, 229, 194, 0.8));
    }
  }
  .hero-inner {
    position: relative;
  }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: var(--s-3);
    color: var(--fg-soft);
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 0 var(--live);
    animation: pulse 2.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(72, 229, 194, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(72, 229, 194, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(72, 229, 194, 0);
    }
  }
  .hero-h1 {
    font-size: clamp(2.2rem, 1.75rem + 2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .hero-h1 .tl {
    color: var(--live);
    text-shadow: 0 0 34px rgba(72, 229, 194, 0.35);
  }
  .hero-lede {
    max-width: 65ch;
    margin-top: var(--s-4);
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .hero-lede em {
    color: var(--fg);
    font-style: normal;
    font-weight: 560;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .mac-release-entry {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: var(--s-4);
    color: var(--fg-quiet);
    font: 540 var(--step--1)/1.4 var(--font-mono);
  }
  .mac-release-entry > span:first-child {
    color: var(--fg-soft);
  }
  .mac-release-entry strong {
    color: var(--brand-bright);
    font-weight: 560;
  }
  .mac-release-entry:hover,
  .mac-release-entry:hover > span:first-child {
    color: var(--fg);
  }
  .mac-release-entry:hover strong {
    color: var(--brand-bright);
  }
  .mac-release-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }
  .mac-release-dot.ready {
    background: var(--live);
  }
  .mac-release-dot.ready + strong {
    color: var(--live);
  }
  .hero-curve-cap {
    position: absolute;
    right: 0;
    bottom: var(--s-3);
    max-width: min(100%, 58ch);
    text-align: right;
    color: var(--live);
    opacity: 0.85;
  }

  .hero-stats {
    list-style: none;
    padding: var(--s-6) 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-5);
    border-top: 1px solid var(--line);
    position: relative;
  }
  .hero-stats b {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 680;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .hero-stats b i {
    font-style: normal;
    color: var(--live);
    font-size: 0.7em;
  }
  .hero-stats span {
    display: block;
    margin-top: 5px;
    font-size: var(--step--1);
    color: var(--fg-quiet);
  }
  @media (max-width: 720px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-curve-cap {
      font-size: 0.67rem;
    }
  }

  /* ---------- entry map ---------- */
  .entry-map {
    padding: var(--s-8) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-sunken);
  }
  .entry-map-head {
    display: grid;
    grid-template-columns: minmax(180px, 0.65fr) 1fr 1.25fr;
    gap: var(--s-6);
    align-items: end;
    margin-bottom: var(--s-6);
  }
  .entry-map-head .mono-label {
    color: var(--live);
  }
  .entry-map-head h2 {
    font-size: var(--step-2);
  }
  .entry-map-head > p:last-child {
    color: var(--fg-soft);
    line-height: 1.55;
  }
  .entry-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line-strong);
  }
  .entry-rail > a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-3);
    align-items: start;
    padding: var(--s-5) var(--s-4);
    border-right: 1px solid var(--line);
    color: var(--fg);
    transition: background var(--dur-2) var(--ease-out);
  }
  .entry-rail > a:first-child {
    padding-left: 0;
  }
  .entry-rail > a:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .entry-rail > a:hover {
    background: var(--brand-wash);
  }
  .entry-rail > a > span:last-child {
    color: var(--live);
  }
  .entry-number {
    padding-top: 3px;
    color: var(--fg-quiet);
    font: 500 var(--step--1)/1 var(--font-mono);
  }
  .entry-copy {
    display: grid;
    gap: 7px;
  }
  .entry-copy b {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .entry-copy small {
    color: var(--fg-soft);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  @media (max-width: 900px) {
    .entry-map-head {
      grid-template-columns: 1fr 1.4fr;
    }
    .entry-map-head .mono-label {
      grid-column: 1 / -1;
    }
    .entry-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .entry-rail > a:nth-child(2) {
      border-right: 0;
    }
    .entry-rail > a:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .entry-rail > a:first-child,
    .entry-rail > a:last-child {
      padding-inline: var(--s-4);
    }
  }
  @media (max-width: 560px) {
    .entry-map-head,
    .entry-rail {
      grid-template-columns: 1fr;
    }
    .entry-map-head .mono-label {
      grid-column: auto;
    }
    .entry-rail > a:nth-child(n) {
      padding-inline: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .entry-rail > a:last-child {
      border-bottom: 0;
    }
  }

  /* ---------- manifesto ---------- */
  .manifesto {
    position: relative;
    padding: var(--s-10) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(
        80% 90% at 82% 8%,
        rgba(72, 229, 194, 0.09),
        transparent 58%
      ),
      linear-gradient(180deg, var(--paper-sunken), var(--paper));
  }
  .man-eyebrow {
    color: var(--live);
    margin-bottom: var(--s-5);
  }
  .man-h2 {
    font-size: var(--step-3);
    font-weight: 640;
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }
  .man-h2 .tl {
    color: var(--live);
  }
  .man-grid {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6) var(--s-8);
    max-width: 1000px;
  }
  @media (max-width: 760px) {
    .man-grid {
      grid-template-columns: 1fr;
    }
  }
  .man-grid p {
    color: var(--fg-soft);
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .man-grid b {
    color: var(--ink);
    font-weight: 620;
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .man-grid code {
    color: var(--live);
  }

  /* ---------- bands ---------- */
  .band {
    padding: var(--s-9) 0;
    border-top: 1px solid var(--line);
  }
  .band-alt {
    background: var(--paper-sunken);
  }
  .band-head {
    max-width: 60ch;
    margin-bottom: var(--s-7);
  }
  .band-head h2 {
    margin-bottom: var(--s-3);
  }
  .band-sub {
    font-size: var(--step-1);
    color: var(--fg-soft);
    line-height: 1.5;
  }
  .band-sub code,
  .band-sub strong {
    color: var(--ink);
  }
  .band-sub code {
    color: var(--live);
    font-size: 0.92em;
  }
  .band-more {
    display: inline-block;
    margin-top: var(--s-6);
    font-weight: 550;
    color: var(--live);
  }
  .band-more:hover {
    color: var(--live-bright);
  }

  /* ---------- loop ---------- */
  .loop-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--paper-raised);
  }
  .loop-steps li {
    padding: var(--s-5) var(--s-4);
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-right: 1px solid var(--line);
    position: relative;
  }
  .loop-steps li:last-child {
    border-right: 0;
  }
  .loop-steps li.dec {
    background: var(--brand-wash);
  }
  .ls-n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--live);
  }
  .ls-k {
    font-size: var(--step--1);
    color: var(--fg-soft);
    font-weight: 500;
  }
  .loop-steps code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--fg);
  }
  .loop-steps code.ok {
    color: var(--live);
  }
  .loop-steps li.dec code {
    color: var(--brand);
  }
  @media (max-width: 760px) {
    .loop-steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .loop-steps li {
      border-bottom: 1px solid var(--line);
    }
  }
  .loop-latest {
    margin-top: var(--s-5);
    line-height: 1.7;
    color: var(--fg-soft);
    max-width: 96ch;
  }
  .loop-latest .dec-t {
    color: var(--brand);
  }
  .loop-latest .ship {
    color: var(--live);
  }

  /* ---------- specialists ---------- */
  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
  }
  @media (max-width: 860px) {
    .spec-grid {
      grid-template-columns: 1fr;
    }
  }
  .spec {
    position: relative;
    background: linear-gradient(180deg, var(--paper-2), var(--surface) 42%);
    border: 1px solid var(--line);
    border-radius: var(--r-4);
    padding: clamp(var(--s-5), 3vw, var(--s-6));
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .spec::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--r-4);
    right: var(--r-4);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(72, 229, 194, 0.35),
      transparent
    );
  }
  .spec:hover {
    border-color: var(--live-dim);
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
  }
  .spec-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-4);
  }
  .mono-label.live {
    color: var(--live);
  }
  .mono-label.brand {
    color: var(--brand);
  }
  .spec-badge {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-quiet);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .spec-body {
    color: var(--fg-soft);
    margin: var(--s-2) 0 var(--s-5);
  }
  .spec-body strong {
    color: var(--ink);
  }
  .spec-body em {
    font-style: normal;
    color: var(--brand);
    font-weight: 560;
  }
  .spec-limit {
    margin: 0 0 var(--s-5);
    color: var(--fg-quiet);
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .spec-metrics {
    display: flex;
    gap: var(--s-6);
    margin: 0 0 var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .spec-metrics dt {
    font-size: var(--step--1);
    color: var(--fg-quiet);
    margin-bottom: 3px;
  }
  .spec-metrics dd {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--fg);
  }
  .spec-metrics dd b {
    color: var(--live);
  }
  .spec-metrics dd.down {
    color: var(--brand);
  }
  .spec-link {
    margin-top: auto;
    font-weight: 550;
    color: var(--ink);
  }
  .spec-link:hover {
    color: var(--live);
  }

  /* ---------- metrics ---------- */
  .metric-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 860px) {
    .metric-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .metric-row > div {
    padding: var(--s-5) 0;
    border-top: 2px solid var(--live);
  }
  .metric-row b {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 680;
    letter-spacing: -0.03em;
    display: block;
  }
  .metric-row .mu {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--live);
    display: block;
    margin-top: 2px;
  }
  .metric-row small {
    display: block;
    margin-top: var(--s-3);
    font-size: var(--step--1);
    color: var(--fg-quiet);
  }

  /* ---------- pillars ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6) var(--s-7);
  }
  @media (max-width: 860px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  .pillar {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--s-4);
  }
  .pillar-i {
    display: block;
    color: var(--live);
    font-weight: 600;
    margin-bottom: var(--s-3);
    font-size: var(--step-0);
    letter-spacing: 0;
  }
  .pillar p {
    color: var(--fg-soft);
    font-size: var(--step-0);
  }
  .pillar em {
    font-style: normal;
    color: var(--ink);
    font-weight: 560;
  }

  /* ---------- logs ---------- */
  .outcome-ledger {
    display: grid;
    grid-template-columns: 1.35fr repeat(3, minmax(110px, 0.55fr)) auto;
    gap: var(--s-5);
    align-items: center;
    padding: var(--s-5) 0;
    border-block: 1px solid var(--line-strong);
    color: var(--fg);
  }
  .outcome-ledger:hover .outcome-go {
    transform: translateX(4px);
  }
  .outcome-intro,
  .outcome-count {
    display: grid;
    gap: 4px;
  }
  .outcome-intro .mono-label {
    color: var(--live);
  }
  .outcome-intro strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .outcome-count {
    padding-left: var(--s-4);
    border-left: 2px solid var(--line-strong);
  }
  .outcome-count.positive {
    border-color: var(--live);
  }
  .outcome-count.caveat {
    border-color: var(--brand-bright);
  }
  .outcome-count.negative {
    border-color: var(--brand);
  }
  .outcome-count b {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }
  .outcome-count small {
    color: var(--fg-quiet);
    font-size: var(--step--1);
