---
/** Home: validated Workbench content, retaining the original head and #195 footer. */
import Base from "@saas-maker/templates/Base.astro";
import { WorkbenchPage } from "@saas-maker/templates/workbench-page";
import { baseProps } from "@saas-maker/templates/page";
import { workbenchContent } from "@saas-maker/templates/schema";
import { z } from "astro/zod";
import StudioFooter from "../components/StudioFooter.astro";
import HomeHead from "../components/HomeHead.astro";
import json from "../content/home.json";
import attemptLedger from "../../../docs/attempts.json";
import { macReleaseRecord } from "../data/mac-release";
import { evaluateMacRelease, macReleaseStatusLabel } from "../lib/mac-release";

const counts = {
  attemptCount: attemptLedger.attempts.length,
  workedCount: attemptLedger.attempts.filter((a) => a.status === "worked")
    .length,
  caveatCount: attemptLedger.attempts.filter(
    (a) => a.status === "worked-with-caveat",
  ).length,
  nonPositiveCount: attemptLedger.attempts.filter(
    (a) => !["worked", "worked-with-caveat"].includes(a.status),
  ).length,
};
const homeContent = workbenchContent.extend({
  directories: z.array(
    z
      .object({
        id: z.string(),
        title: z.string(),
        lede: z.string(),
        links: z.array(
          z.object({ label: z.string(), href: z.string() }).strict(),
        ),
      })
      .strict(),
  ),
  head: z.object({ jsonLd: z.array(z.string()).length(2) }).strict(),
  sources: z.array(
    z
      .object({ section: z.string(), label: z.string(), href: z.string() })
      .strict(),
  ),
});
const content = homeContent.parse({
  ...json,
  page: {
    ...json.page,
    jsonLd: json.head.jsonLd.map((raw) => JSON.parse(raw)),
  },
  hero: {
    ...json.hero,
    status: {
      label: `native Mac app · ${macReleaseStatusLabel(evaluateMacRelease(macReleaseRecord))}`,
      href: "/download",
    },
  },
  sections: json.sections.map((section) => ({
    ...section,
    blocks: section.blocks.map((block) => ({
      ...block,
      ...("lede" in block && {
        lede: block.lede?.replace(/\{(\w+)\}/g, (_, key: string) => {
          if (!(key in counts)) throw new Error(`Unknown home count: ${key}`);
          return String(counts[key as keyof typeof counts]);
        }),
      }),
    })),
  })),
});
---

<Base {...baseProps(content)} jsonLd={undefined} footerScript={false}>
  <!-- Base serializes JSON-LD as one block; the head slot preserves both original byte strings. -->
  <HomeHead slot="head" jsonLd={content.head.jsonLd} />
  <div class="home-workbench">
    <WorkbenchPage content={content}>
      <Fragment slot="footer">
        <!-- Spread has no source-link field. These remain reachable without JS;
             the inline script places them beside their result before paint. -->
        <nav class="home-sources" aria-label="published result sources">
          {
            content.sources.map((source) => (
              <a data-home-source={source.section} href={source.href}>
                {source.label} →
              </a>
            ))
          }
        </nav>
        {
          content.directories.map((directory) => (
            <section
              class="home-directory"
              id={directory.id}
              aria-labelledby={`${directory.id}-title`}
            >
              <h2 id={`${directory.id}-title`}>{directory.title}</h2>
              <p>{directory.lede}</p>
              <nav aria-label={directory.title}>
                {directory.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </nav>
            </section>
          ))
        }
        <StudioFooter groups={content.footer ? content.footer.groups : []} />
      </Fragment>
    </WorkbenchPage>
  </div>
  <script is:inline>
    document.querySelectorAll("[data-home-source]").forEach((link) => {
      const section = document.getElementById(link.dataset.homeSource);
      const copy = section?.querySelector(".grid > div:first-child");
      const lede = section?.querySelector("p.lede");
      (lede?.parentElement ?? copy)?.append(link);
    });
    const sources = document.querySelector(".home-sources");
    if (sources && !sources.children.length) sources.remove();
    // Template links have no attribute passthrough. Attach before the deferred shared logger handles clicks.
    document
      .querySelectorAll('.home-workbench a[href="/docs/quickstart"]')
      .forEach((link) => link.setAttribute("data-log", "quickstart_opened"));
    document
      .querySelector('.identity-actions a[href="/artifacts"]')
      ?.setAttribute("data-log", "specialist_proof_opened");
    addEventListener("hashchange", () =>
      document
        .querySelectorAll(":popover-open")
        .forEach((menu) => menu.hidePopover()),
    );
  </script>
  <script>
    import { initVitals } from "../lib/vitals";
    import { initApiTiming } from "../lib/api-timing";
    initVitals();
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(() => initApiTiming(), { timeout: 5_000 });
    } else {
      window.setTimeout(() => initApiTiming(), 1_000);
    }
  </script>
</Base>

<style is:global>
  .home-workbench .identity-copy h1 {
    max-width: 17ch;
  }
  .home-workbench .identity-issue {
    text-transform: none;
  }
  .home-workbench
    :is(#factory-loop, #run, #file-ops-proof, #sql-proof)
    .eyebrow {
    color: var(--muted-foreground);
  }
  /* Diff counters count changed lines, not benchmark outcomes. */
  .home-workbench
    :is(#file-ops-proof, #sql-proof)
    figure
    figcaption
    > span:last-child {
    display: none;
  }
  .home-workbench [data-home-source] {
    display: block;
    width: fit-content;
    margin-top: 1.5rem;
    font: inherit;
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .home-workbench [data-home-source]:hover {
    color: var(--brand-ink);
  }
  .home-sources {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3.5rem);
  }
  @media (min-width: 768px) {
    .home-workbench :is(#factory-loop, #run) .grid > div:first-child {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .home-workbench :is(#factory-loop, #run) .grid > div:last-child {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
  }
  .home-workbench pre {
    max-width: 100%;
    overflow-x: auto;
  }
  .home-directory {
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 4vw, 3.5rem);
    border-top: 1px solid var(--border);
  }
  .home-directory h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .home-directory p {
    max-width: 65ch;
    margin-block: 1rem 2rem;
    color: var(--muted-foreground);
  }
  .home-directory nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
  }
  .home-directory a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .home-directory a:hover {
    color: var(--brand-ink);
  }
  .home-directory a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
  .home-directory a span {
    color: var(--brand-ink);
  }
  @media (max-width: 640px) {
    .home-directory nav {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
