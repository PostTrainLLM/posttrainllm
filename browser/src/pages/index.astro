  .metric dt {
    font: 400 12px/1.3 var(--font-mono);
    color: var(--muted);
    margin: 0 0 var(--s-2);
    letter-spacing: 0;
  }
  .metric dd {
    margin: 0 0 var(--s-2);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--fg);
  }
  .m-val {
    font: 500 clamp(30px, 4vw, 38px)/1 var(--font-mono);
    letter-spacing: -0.03em;
  }
  .m-unit {
    font: 400 14px/1 var(--font-mono);
    color: var(--fg-quiet);
  }
  .m-pct {
    font: 400 11px/1 var(--font-mono);
    color: var(--muted);
    background: var(--bg-3);
    padding: 3px 6px;
    border-radius: 4px;
    margin-left: 4px;
  }
  .m-note {
    margin: 0;
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--muted);
  }

  /* ========== COST ========== */
  .cost { margin-top: var(--s-7); }
  .cost-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
  }
  .cost-side {
    background: var(--bg-1);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .cost-local {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-1));
  }
  .cost-tag {
    font: 400 12px/1.3 var(--font-mono);
    color: var(--muted);
  }
  .cost-local .cost-tag { color: var(--accent); }
  .cost-val {
    font: 500 clamp(30px, 4vw, 40px)/1 var(--font-mono);
    letter-spacing: -0.03em;
    color: var(--fg);
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }
  .cost-unit {
    font: 400 14px/1 var(--font-mono);
    color: var(--fg-quiet);
  }
  .cost-note {
    margin: 0;
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--muted);
  }
  .cost-fineprint {
    margin: var(--s-3) 0 0;
    font: 400 11.5px/1.5 var(--font-sans);
    color: var(--faint);
  }
  .cost-fineprint a { color: var(--muted); }

  /* ========== PIPELINE ========== */
  .pipeline {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--line);
    counter-reset: step;
  }
  .step {
    background: var(--bg-1);
    padding: var(--s-4) var(--s-4) calc(var(--s-4) + 4px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    transition: background 140ms ease;
  }
  .step:hover { background: var(--bg-2); }
  .step-loop { background: color-mix(in oklab, var(--warm) 6%, var(--bg-1)); }
  .step-loop:hover { background: color-mix(in oklab, var(--warm) 9%, var(--bg-2)); }
  .step-num {
    font: 500 11px/1 var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .step-loop .step-num { color: var(--warm); }
  .step-name {
    font: 500 15px/1.3 var(--font-sans);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .step-cmd {
    font: 400 12px/1.4 var(--font-mono);
    color: var(--accent);
    background: var(--bg-2);
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    align-self: flex-start;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .step-loop .step-cmd { color: var(--warm); }
  .step-detail {
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--fg-quiet);
  }
  .step-detail code {
    background: var(--bg-3);
    font-size: 0.92em;
    padding: 0 4px;
    border-color: var(--line);
  }

  /* arrow between steps - hidden on wrap rows, on by hover for affordance */
  @media (min-width: 720px) {
    .step::after {
      content: "";
      position: absolute;
      right: -10px;
      top: 50%;
      width: 20px;
      height: 1px;
      background: var(--line-strong);
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 1;
    }
    .step:nth-last-child(1)::after { display: none; }
  }

  /* ========== PILLARS ========== */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 14px;
  }
  .pillar {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    transition: border-color 140ms ease, background 140ms ease, transform 240ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .pillar:hover {
    border-color: var(--line-strong);
    background: var(--bg-2);
    transform: translateY(-1px);
  }
  .pillar header { display: flex; flex-direction: column; gap: var(--s-2); }
  .pillar-tag {
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
    background: var(--accent-glow);
    border: 1px solid var(--accent-dim);
    padding: 4px 8px;
    border-radius: 999px;
    align-self: flex-start;
  }
  .pillar-tag-warm {
    color: var(--warm);
    background: color-mix(in oklab, var(--warm) 12%, transparent);
    border-color: var(--warm-dim);
  }
  .pillar h3 {
    margin: 0;
    font: 500 17px/1.3 var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: balance;
  }
  .pillar ul {
    list-style: none;
    margin: 0; padding: 0;
  }
  .pillar li {
    font: 400 13.5px/1.6 var(--font-sans);
    color: var(--fg-soft);
    padding: 8px 0;
    border-top: 1px solid var(--line-soft);
  }
  .pillar li:first-child { border-top: none; padding-top: 0; }
  .pillar li strong { color: var(--fg); font-weight: 500; }
  .pillar li em { color: var(--fg-quiet); }
  .pillar-prose {
    margin: 0;
    font: 400 14px/1.7 var(--font-sans);
    color: var(--fg-soft);
  }
  .pillar-browser {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--warm) 5%, var(--bg-1)) 0%, var(--bg-1) 100%);
    border-color: var(--warm-dim);
  }
  .pillar-browser:hover { border-color: var(--warm); background: var(--bg-2); }
  .pillar-cta {
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
  }
  .inline-cta {
    text-decoration: none;
    color: var(--warm);
    font-weight: 500;
    border-bottom: 1px solid var(--warm-dim);
    padding-bottom: 1px;
    transition: border-color 120ms ease;
  }
  .inline-cta:hover { border-bottom-color: var(--warm); color: var(--warm); }
  .inline-cta-quiet { color: var(--fg-quiet); border-bottom-color: var(--line-strong); }
  .inline-cta-quiet:hover { color: var(--fg); border-bottom-color: var(--accent); }
  .inline-cta-divider { color: var(--faint); margin: 0 4px; }

  /* ========== RUN ========== */
  .run-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 16px;
  }
  @media (max-width: 780px) {
    .run-grid { grid-template-columns: 1fr; }
  }
  .run-card {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: var(--s-4) var(--s-4) calc(var(--s-4) + 4px);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .run-card-primary {
    border-color: color-mix(in oklab, var(--accent) 38%, var(--line-strong));
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--accent) 4%, var(--bg-1)) 0%, var(--bg-1) 100%);
  }
  .run-card header h3 {
    margin: 0;
    font: 500 18px/1.2 var(--font-sans);
    letter-spacing: -0.015em;
  }
  .run-tag {
    margin: 4px 0 0;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--muted);
  }
  .run-prose {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--fg-soft);
  }
  .run-bullets {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .run-bullets li {
    position: relative;
    padding-left: 18px;
    font-size: 13.5px;
    color: var(--fg-soft);
    line-height: 1.55;
  }
  .run-bullets li::before {
    content: "";
    position: absolute;
    left: 0; top: 9px;
    width: 8px; height: 1px;
    background: var(--accent);
  }
  .code-block {
    margin: 0;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-2);
    padding: 16px 18px;
    overflow-x: auto;
    font: 400 12.5px/1.7 var(--font-mono);
    color: var(--fg-soft);
    -webkit-overflow-scrolling: touch;
  }
  .code-block code { background: transparent; border: none; padding: 0; white-space: pre; color: inherit; }
  .code-block .cm { color: var(--muted); }
  .run-card-cta { margin: var(--s-2) 0 0; font-size: 13.5px; }
  .run-card-cta .inline-cta { color: var(--accent); border-bottom-color: var(--accent-dim); }
  .run-card-cta .inline-cta:hover { color: var(--accent-strong); border-bottom-color: var(--accent); }

  /* ========== HONEST ========== */
  .honest-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .honest-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  .honest-col h3 {
    margin: 0 0 var(--s-3);
    font: 500 16px/1.3 var(--font-sans);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .honest-col ul {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .honest-col li {
    font-size: 14px;
    line-height: 1.7;
    color: var(--fg-soft);
    padding-left: 16px;
    position: relative;
  }
  .honest-col li::before {
    content: "";
    position: absolute;
    left: 0; top: 11px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--fg-quiet);
  }
  .honest-col:last-child li::before { background: var(--warm); }

  /* ========== LEARN ========== */
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
  }
  .doc-link {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px 20px;
    background: var(--bg-1);
    text-decoration: none;
    color: var(--fg);
    transition: background 140ms ease, transform 240ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .doc-link:hover {
    background: var(--bg-2);
    transform: translateY(-1px);
  }
  .doc-title {
    font: 500 14px/1.4 var(--font-sans);
    color: var(--fg);
    letter-spacing: -0.005em;
  }
  .doc-sub {
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--muted);
  }

  /* ========== FOOTER ========== */
  .site-footer {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 2vw, 22px);
    justify-content: center;
    margin-bottom: var(--s-4);
    font-size: 13px;
  }
  .footer-nav a {
    color: var(--fg-quiet);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .footer-nav a:hover { color: var(--fg); border-bottom-color: var(--accent); }
  .footnote {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0 auto var(--s-3);
  }
  .signed {
    font-size: 12.5px;
    color: var(--fg-quiet);
    max-width: 60ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ========== FUTURE SYSTEM OVERRIDE ========== */
  :root {
    --bg: #050608;
    --bg-1: #090d12;
    --bg-2: #0e141b;
    --bg-3: #141d26;
    --bg-hover: #17212b;
    --line: rgba(162, 190, 210, 0.14);
    --line-soft: rgba(162, 190, 210, 0.09);
    --line-strong: rgba(162, 190, 210, 0.24);
    --fg: #f4f7f7;
    --fg-soft: #c7d1d3;
    --fg-quiet: #91a0a5;
    --muted: #6f7c84;
    --faint: #48525a;
    --accent: #61f4d4;
    --accent-strong: #a8fff0;
    --accent-dim: rgba(97, 244, 212, 0.34);
    --accent-glow: rgba(97, 244, 212, 0.12);
    --violet: #b59cff;
    --violet-dim: rgba(181, 156, 255, 0.24);
    --warm: #ffcf7a;
    --warm-dim: rgba(255, 207, 122, 0.24);
    --danger: #ff887d;
    --r-2: 8px;
    --r-3: 8px;
    --r-4: 8px;
  }

  html,
  body {
    min-height: 100%;
    background:
      linear-gradient(116deg, rgba(97, 244, 212, 0.08) 0%, transparent 22%, rgba(181, 156, 255, 0.07) 49%, transparent 72%),
      linear-gradient(180deg, #050608 0%, #071017 44%, #050608 100%);
  }

  body {
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(97, 244, 212, 0.055) 1px, transparent 1px),
      linear-gradient(180deg, rgba(97, 244, 212, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, transparent 0 44%, rgba(255, 255, 255, 0.035) 45%, transparent 46% 100%);
    background-size: 72px 72px, 72px 72px, 100% 8px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.56) 62%, transparent);
  }

  code {
    background: rgba(255, 255, 255, 0.035);
    border-color: var(--line-strong);
    color: var(--fg-soft);
  }

  .topbar {
    position: fixed;
    top: 12px;
    left: 50%;
    width: min(calc(100% - 24px), 1220px);
    transform: translateX(-50%);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: rgba(5, 6, 8, 0.72);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.28);
    padding: 10px clamp(12px, 2vw, 20px);
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    clip-path: polygon(0 0, 86% 0, 100% 14%, 100% 100%, 14% 100%, 0 86%);
    background:
      linear-gradient(135deg, rgba(97, 244, 212, 0.28), rgba(181, 156, 255, 0.16)),
      var(--bg-2);
    border-color: var(--accent-dim);
    color: var(--accent-strong);
    text-shadow: 0 0 18px var(--accent-dim);
  }

  .brand-name {
    font: 650 13px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .topnav {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topnav a {
    color: var(--fg-quiet);
    padding: 9px 8px;
    border: 1px solid transparent;
    border-radius: 6px;
  }

  .topnav a:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.035);
    border-color: var(--line-strong);
  }

  .landing {
    max-width: 1220px;
    padding: 92px clamp(16px, 4vw, 36px) 104px;
  }

  section {
    margin-bottom: clamp(76px, 10vw, 132px);
    scroll-margin-top: 112px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(360px, 0.78fr);
    grid-template-rows: auto auto auto auto 1fr;
    column-gap: clamp(30px, 5vw, 76px);
    align-items: center;
    min-height: calc(100svh - 112px);
    padding: clamp(38px, 6vw, 74px) 0 clamp(34px, 5vw, 64px);
    border-bottom-color: var(--line-soft);
    margin-bottom: clamp(72px, 9vw, 116px);
  }

  .hero::before {
    display: none;
  }

  .hero-kicker,
  .hero h1,
  .hero-lede,
  .cta-row,
  .hero-fineprint {
    grid-column: 1;
  }

  .hero-kicker {
    width: fit-content;
    margin-bottom: 18px;
    padding: 8px 10px;
    border: 1px solid var(--accent-dim);
    border-radius: 6px;
    background: rgba(97, 244, 212, 0.07);
    color: var(--accent-strong);
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 13ch;
    margin-bottom: 24px;
    font-size: clamp(44px, 7vw, 86px);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .hero h1 .highlight {
    display: block;
    color: var(--accent-strong);
    font-style: normal;
    font-weight: 650;
    text-shadow: 0 0 36px var(--accent-glow);
  }

  .hero-lede {
    max-width: 62ch;
    margin-bottom: 28px;
    color: var(--fg-soft);
  }

  .hero-visual {
    grid-column: 2;
    grid-row: 1 / span 5;
    position: relative;
    min-height: 560px;
    display: grid;
    place-items: center;
  }

  .signal-grid {
    position: absolute;
    inset: 0;
    clip-path: polygon(7% 0, 100% 0, 100% 91%, 91% 100%, 0 100%, 0 9%);
    border: 1px solid var(--line-strong);
    background:
      linear-gradient(90deg, rgba(97, 244, 212, 0.09) 1px, transparent 1px),
      linear-gradient(180deg, rgba(181, 156, 255, 0.07) 1px, transparent 1px),
      linear-gradient(135deg, rgba(97, 244, 212, 0.08), rgba(255, 207, 122, 0.045) 42%, rgba(181, 156, 255, 0.08));
    background-size: 34px 34px, 34px 34px, 100% 100%;
    opacity: 0.72;
  }

  .signal-grid::before,
  .signal-grid::after {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.55;
  }

  .signal-grid::before { top: 22%; }
  .signal-grid::after { bottom: 24%; background: linear-gradient(90deg, transparent, var(--violet), transparent); }

  .holo-frame {
    position: relative;
    width: min(100%, 460px);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: rgba(6, 9, 12, 0.86);
    box-shadow:
      0 0 0 1px rgba(97, 244, 212, 0.04) inset,
      0 30px 90px rgba(0, 0, 0, 0.48),
      0 0 70px rgba(97, 244, 212, 0.11);
    overflow: hidden;
  }

  .holo-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.08), transparent 26%),
      linear-gradient(180deg, transparent 0 70%, rgba(97, 244, 212, 0.06));
  }

  .holo-header {
    position: relative;
    display: grid;
    grid-template-columns: 8px 8px 8px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .holo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent-dim);
  }

  .holo-dot.is-warm { background: var(--warm); box-shadow: 0 0 16px var(--warm-dim); }
  .holo-dot.is-violet { background: var(--violet); box-shadow: 0 0 16px var(--violet-dim); }

  .holo-title,
  .holo-pill,
  .holo-label,
  .holo-value,
  .chip,
  .package-title,
  .package-path,
  .package-grid {
    font-family: var(--font-mono);
  }

  .holo-title {
    color: var(--fg-quiet);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .holo-pill {
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    padding: 4px 8px;
    color: var(--accent-strong);
    background: rgba(97, 244, 212, 0.08);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .holo-stack {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 18px 16px;
  }

  .holo-row {
    display: grid;
    grid-template-columns: minmax(104px, 1fr) auto;
    gap: 8px 14px;
