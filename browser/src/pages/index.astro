---
import Default from "../layouts/Default.astro";
import Logo from "../components/Logo.astro";
import "../styles/system.css";

const REPO = "https://github.com/sarthak-fleet/tinygpt";
---

<Default
  title="posttrainllm — a Mac-local LLM specialist factory"
  description="An open research lab in one file: distill routed specialists, gate them on real evals (BFCL / τ-bench / lm-eval / SQL), package for MLX, and inspect with SAE / MEMIT / patching — all on one Apple Silicon machine. Trains in a browser tab too. MIT, built in the open."
  themeColor="#0a0c0f"
  ogTitle="posttrainllm — a Mac-local LLM specialist factory"
  ogDescription="Distill, fine-tune, evaluate, serve, and inspect LLMs on a single Mac. An open research lab, built in the open. MIT."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="topbar" role="banner">
    <a class="brand-lockup" href="/" aria-label="posttrainllm home">
      <Logo size={28} />
      <span class="brand-name">posttrainllm</span>
    </a>
    <nav class="topnav" aria-label="Primary">
      <a href="/artifacts">specialists</a>
      <a href="/devlog">devlog</a>
      <a href="/docs/learn/curriculum">learn</a>
      <a href="/leaderboard">evals</a>
      <a href="/playground">playground</a>
      <a href={REPO} rel="noopener">github ↗</a>
    </nav>
  </header>

  <main class="landing" id="main">

    <!-- ================= HERO ================= -->
    <section class="hero wrap">
      <div class="hero-copy reveal">
        <p class="hero-kicker mono-label"><span class="pulse"></span> a one-machine research lab · MIT</p>
        <h1 class="hero-h1">The LLM factory<br />that fits on <span class="tl">one Mac</span>.</h1>
        <p class="hero-lede">
          posttrainllm turns a stock open model into a <em>routed specialist</em> that
          earns its keep — then shows you exactly where it fails. Distill, fine-tune,
          gate on real evals, package for MLX, and open the model up with
          interpretability. One Apple&nbsp;Silicon machine. No cloud. No hand-waving.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/artifacts">See the specialists</a>
          <a class="btn btn-ghost" href="/playground">Train one in your browser →</a>
        </div>
      </div>

      <figure class="hero-fig reveal" aria-label="A training loss curve descending — the mark of the lab">
        <Logo size={64} glow={true} class="hero-logo" />
        <svg class="losscurve" viewBox="0 0 420 220" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="lc" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#48e5c2" stop-opacity="0.22" />
              <stop offset="1" stop-color="#48e5c2" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path class="lc-fill" d="M0,26 C70,30 110,150 200,175 C280,196 340,200 420,203 L420,220 L0,220 Z" fill="url(#lc)" />
          <path class="lc-line" d="M0,26 C70,30 110,150 200,175 C280,196 340,200 420,203" fill="none" stroke="#48e5c2" stroke-width="2.4" stroke-linecap="round" />
          <circle class="lc-dot" cx="420" cy="203" r="4" fill="#48e5c2" />
        </svg>
        <figcaption class="hero-fig-cap">
          <span>loss</span><span>huge-base-v1 · 200k steps · 0 spikes · loss 4.16</span>
        </figcaption>
      </figure>

      <ul class="hero-stats reveal" role="list">
        <li><b>0.920</b><span>SQL execution, on-device</span></li>
        <li><b>100<i>%</i></b><span>file-ops hard gate — from 58%</span></li>
        <li><b>100<i>+</i></b><span>CLI subcommands, one binary</span></li>
        <li><b>0</b><span>data leaves the laptop</span></li>
      </ul>
    </section>

    <!-- ================= MANIFESTO ================= -->
    <section class="manifesto">
      <div class="wrap">
        <p class="man-eyebrow mono-label">the thesis</p>
        <h2 class="man-h2">
          Not trying to win the frontier. Trying to reach frontier
          <span class="tl">capability</span> at a fraction of the compute — and to
          understand the whole machine while doing it.
        </h2>
        <div class="man-grid">
          <p><b>Win on the Mac.</b> Be best-in-class at what one Apple&nbsp;Silicon machine can actually do — train, post-train, evaluate, serve, inspect — with no cluster and no cloud dependency.</p>
          <p><b>Learn the whole space.</b> From <code>y = mx + b</code> to a self-improving factory. Every technique is built from scratch, anchored to the paper, and mapped to the file where it lives.</p>
          <p><b>Show the scars.</b> Failed runs are first-class. Every attempt is logged with the decision it forced. A number without its regression is marketing, not a result.</p>
          <p><b>Build everything buildable here.</b> If it fits on this Mac, it gets built — and packaged so that when compute arrives, the lab scales from a running start.</p>
        </div>
      </div>
    </section>

    <!-- ================= FACTORY LOOP ================= -->
    <section class="band loop-band">
      <div class="wrap">
        <header class="band-head">
          <h2>The loop the runtime closes.</h2>
          <p class="band-sub">Each surface emits the input the next one needs. Every run ends in a schema-valid folder — config, dataset, eval, decision, report — that <code>factory-run</code> validates.</p>
        </header>
        <ol class="loop-steps" role="list">
          <li><span class="ls-n">01</span><span class="ls-k">target</span><code>frozen</code></li>
          <li><span class="ls-n">02</span><span class="ls-k">data</span><code>5,675 rows</code></li>
          <li><span class="ls-n">03</span><span class="ls-k">post-train</span><code>dpo · 200 steps</code></li>
          <li><span class="ls-n">04</span><span class="ls-k">eval</span><code class="ok">exec 0.920</code></li>
          <li><span class="ls-n">05</span><span class="ls-k">package</span><code>tgla · mlx</code></li>
          <li class="dec"><span class="ls-n">06</span><span class="ls-k">decide</span><code>retry-data</code></li>
        </ol>
        <p class="loop-latest mono-label">
          latest · 2026-07-11 · qwen06-sql-hygiene-dpo · reference-anchored DPO fixed an earlier collapse, execution 0.860→0.920 with no regression — but output hygiene is a base-model prior, so the decision is <span class="dec-t">retry-data</span>. the one proof still missing is a run whose decision is <span class="ship">ship</span>.
        </p>
      </div>
    </section>

    <!-- ================= SPECIALISTS ================= -->
    <section class="band">
      <div class="wrap">
        <header class="band-head">
          <h2>Specialists, honest by design.</h2>
          <p class="band-sub">A specialist beats a generalist on its target and routes away when it shouldn't answer. Every result ships with the regression it costs.</p>
        </header>
        <div class="spec-grid">
          <article class="spec">
            <div class="spec-top"><span class="mono-label live">released · weights</span><span class="spec-badge">4B · MLX</span></div>
            <h3>Qwen3-4B, file-ops distilled</h3>
            <p class="spec-body">Distilled to <strong>100%</strong> on the multi-turn file-ops hard gate (BFCL), up from 58%. The honest cost: out-of-domain breadth dropped <strong>59.6% → 42.3%</strong> — real catastrophic forgetting. It ships <em>routed</em>, never as a general planner.</p>
            <dl class="spec-metrics">
              <div><dt>file-ops gate</dt><dd>58 → <b>100%</b></dd></div>
              <div><dt>OOD breadth</dt><dd class="down">59.6 → 42.3%</dd></div>
            </dl>
            <a class="spec-link" href="/docs/learn/tool-calling-frontier-parity">The distillation write-up →</a>
          </article>
          <article class="spec">
            <div class="spec-top"><span class="mono-label brand">report-only candidate</span><span class="spec-badge">0.6B · routed</span></div>
            <h3>Qwen3-0.6B, routed SQL</h3>
            <p class="spec-body">Two adapters behind a router. Two reference-anchored DPO retries cured a policy collapse and pushed execution to <strong>0.920</strong> — but output hygiene is a base-model prior a small adapter can't strip. Decision: <em>retry-data</em>.</p>
            <dl class="spec-metrics">
              <div><dt>synthetic exec</dt><dd>0.860 → <b>0.920</b></dd></div>
              <div><dt>clean-SQL</dt><dd class="down">0.000</dd></div>
            </dl>
            <a class="spec-link" href="/artifacts/qwen06-sql-routed-v1">Full artifact + blockers →</a>
          </article>
        </div>
        <a class="band-more" href="/artifacts">Every artifact, with evidence and blockers →</a>
      </div>
    </section>

    <!-- ================= MEASURED ================= -->
    <section class="band band-alt">
      <div class="wrap">
        <header class="band-head">
          <h2>Measured, on one machine.</h2>
          <p class="band-sub">Every figure below was recorded on a single Apple <strong>M5&nbsp;Pro / 48&nbsp;GB</strong>. No estimates, no extrapolation.</p>
        </header>
        <div class="metric-row" role="list">
          <div role="listitem"><b>76</b><span class="mu">tok/s</span><small>4B decode, MLX</small></div>
          <div role="listitem"><b>12.1×</b><span class="mu">speedup</span><small>WebGPU vs WASM, XL</small></div>
          <div role="listitem"><b>&lt;45s</b><span class="mu">per pass</span><small>50-row SQL eval</small></div>
          <div role="listitem"><b>0</b><span class="mu">spikes</span><small>200k pretrain steps</small></div>
          <div role="listitem"><b>½</b><span class="mu">memory</span><small>ref-free vs DPO</small></div>
        </div>
      </div>
    </section>

    <!-- ================= THE STACK ================= -->
    <section class="band">
      <div class="wrap">
        <header class="band-head">
          <h2>The whole stack — audited against the code.</h2>
          <p class="band-sub">Not a wrapper. Every capability is a real subcommand with tests behind it.</p>
        </header>
        <div class="pillars">
          <div class="pillar"><span class="pillar-i mono-label">train</span><p>Pretrain, SFT, DPO / SimPO / KTO / ORPO, distillation, ES. Full PEFT — LoRA, LoRA+, DoRA, VeRA, LoftQ, AdaLoRA, PISSA. WSD schedules, spike recovery, z-loss.</p></div>
          <div class="pillar"><span class="pillar-i mono-label">eval</span><p>BFCL, τ-bench, lm-eval (MLX adapter), HumanEval + sandbox, SQL execution, router, MILU, MTEB. Frozen baselines, slice metrics, non-zero-exit gates.</p></div>
          <div class="pillar"><span class="pillar-i mono-label">serve</span><p>OpenAI- and Ollama-compatible on one socket. Agent loop, tool dispatch, FSM-constrained JSON, persistent KV cache, speculative decoding, optional cloud escalation.</p></div>
          <div class="pillar"><span class="pillar-i mono-label">package</span><p>Export to MLX, safetensors, CoreML. Quantize (GGUF / AWQ / GPTQ / HQQ), prune, merge, bake-LoRA with DoRA magnitudes. Specialist model cards.</p></div>
          <div class="pillar"><span class="pillar-i mono-label">inspect</span><p>SAE features, ROME, MEMIT, tuned / logit lens, activation patching, linear probes, attention heatmaps. Know <em>where</em> the model decides.</p></div>
          <div class="pillar"><span class="pillar-i mono-label">browser</span><p>The same model trains in a browser tab via hand-written WebGPU kernels — Memory64, FlashAttention-2, blocked matmul. A from-scratch learning track, honest negative results included.</p></div>
        </div>
      </div>
    </section>

    <!-- ================= LAB LOGS ================= -->
    <section class="band band-alt">
      <div class="wrap">
        <header class="band-head">
          <h2>The lab keeps a paper trail.</h2>
          <p class="band-sub">Every experiment, lesson, and recipe is written down — with the decision it forced and the file it lives in.</p>
        </header>
        <div class="logs">
          <a class="log log-lead" href="/docs/learn/curriculum">
            <span class="mono-label live">learning log</span>
            <h3>Ground-up, in 10 modules</h3>
            <p>From <code>y = mx + b</code> to a self-improving factory. Every subsystem maps to an anchor in the coverage map — nothing is a black box.</p>
            <span class="log-go">Open the curriculum →</span>
          </a>
          <a class="log" href="/docs/attempt-ledger"><span class="mono-label">attempt ledger</span><h4>What we tried</h4><p>Worked · failed · regressed · retried — each with a decision.</p></a>
          <a class="log" href="/devlog"><span class="mono-label">devlog</span><h4>How it was built</h4><p>Kernels, bugs, and the surprises worth more than the code.</p></a>
          <a class="log" href="/recipes"><span class="mono-label">recipes</span><h4>Method → recipe</h4><p>Not "try DPO" — a named failure mode, data, gate, and stop rule.</p></a>
          <a class="log" href="/docs/interpretability"><span class="mono-label">interpretability</span><h4>Where it decides</h4><p>Lens, patching, SAE, ROME, MEMIT.</p></a>
        </div>
      </div>
    </section>

    <!-- ================= HONEST + RUN ================= -->
    <section class="band">
      <div class="wrap honest-wrap">
        <div>
          <h2>Honest scope.</h2>
          <ul class="honest-list is">
            <li>A single-developer project, shipping in public, MIT.</li>
            <li>Mac-first — M-series, unified memory, MLX-Swift.</li>
            <li>A factory for <em>specialists</em>, not a general assistant.</li>
            <li>An OpenAI-compatible runtime any client already speaks.</li>
          </ul>
          <ul class="honest-list isnt">
            <li>Not a proven ship loop yet — the missing proof is a run that decides <strong>ship</strong>.</li>
            <li>Not multi-GPU or distributed. One device, one Mac.</li>
            <li>Not a cloud product. Nothing leaves the laptop unless you ask.</li>
          </ul>
        </div>
        <aside class="run-col">
          <span class="mono-label live">run it — one Mac, from source</span>
          <pre class="run-block"><code><span class="c"># build the native factory</span>
git clone …/tinygpt && cd native-mac
swift build --product posttrainllm

<span class="c"># distill a specialist, gate it, serve it</span>
posttrainllm distill --teacher qwen3 --student …
posttrainllm eval-gate --spec sql.json --candidate …
posttrainllm serve --port 8080  <span class="c"># OpenAI-compatible</span></code></pre>
          <a class="btn btn-primary" href="/docs/quickstart">Full quickstart →</a>
        </aside>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-top">
        <a class="brand-lockup" href="/"><Logo size={26} /><span class="brand-name">posttrainllm</span></a>
        <nav class="foot-links" aria-label="Footer">
          <a href="/artifacts">specialists</a>
          <a href="/devlog">devlog</a>
          <a href="/docs/learn/curriculum">learn</a>
          <a href="/docs/attempt-ledger">experiments</a>
          <a href="/docs/README">docs</a>
          <a href={REPO} rel="noopener">github ↗</a>
        </nav>
      </div>
      <p class="foot-disclaimer">
        Every performance figure on this site was measured on a single Apple
        <strong>M5&nbsp;Pro (18-core GPU) with 48&nbsp;GB unified memory</strong> —
        one machine, no cluster, no cloud. Model-quality numbers are on frozen,
        documented evals; where a result is a candidate and not shipped, the page
        says so. Built in the open by one developer. MIT-licensed.
      </p>
    </div>
  </footer>
</Default>

<style is:global>
  .landing { padding-bottom: 0; }

  /* ---------- hero ---------- */
  .hero {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 64px);
    align-items: center; padding-top: clamp(48px, 8vw, 104px); padding-bottom: var(--s-9);
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
  .hero-kicker { display: inline-flex; align-items: center; gap: 9px; margin-bottom: var(--s-5); color: var(--fg-soft); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 0 var(--live); animation: pulse 2.6s var(--ease-out) infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(72,229,194,0.5); } 70% { box-shadow: 0 0 0 8px rgba(72,229,194,0); } 100% { box-shadow: 0 0 0 0 rgba(72,229,194,0); } }
  .hero-h1 { font-size: var(--step-5); font-weight: 700; letter-spacing: -0.04em; }
  .hero-h1 .tl { color: var(--live); }
  .hero-lede { max-width: 54ch; margin-top: var(--s-5); font-size: var(--step-1); line-height: 1.55; color: var(--fg-soft); }
  .hero-lede em { color: var(--fg); font-style: normal; font-weight: 560; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .hero-fig { position: relative; border: 1px solid var(--line); border-radius: var(--r-4); background: linear-gradient(180deg, var(--paper-raised), var(--paper)); padding: var(--s-6); box-shadow: var(--shadow-3); overflow: hidden; min-height: 260px; display: flex; flex-direction: column; }
  .hero-fig::after { content: ""; position: absolute; inset: 0; background: radial-gradient(90% 60% at 80% 0%, rgba(72,229,194,0.10), transparent 60%); pointer-events: none; }
  .hero-logo { position: relative; z-index: 2; }
  .losscurve { position: absolute; left: 0; right: 0; bottom: 34px; width: 100%; height: 62%; }
  @media (prefers-reduced-motion: no-preference) {
    .lc-line { stroke-dasharray: 620; stroke-dashoffset: 620; animation: draw 1.8s var(--ease-out-expo) 0.2s forwards; }
    .lc-fill { opacity: 0; animation: fadein 1.2s var(--ease-out) 1.1s forwards; }
    .lc-dot { opacity: 0; animation: fadein 0.4s ease 1.9s forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes fadein { to { opacity: 1; } }
  }
  .hero-fig-cap { position: relative; z-index: 2; margin-top: auto; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: var(--step--1); color: var(--fg-quiet); }
  .hero-fig-cap span:first-child { color: var(--live); }

  .hero-stats { grid-column: 1 / -1; list-style: none; padding: var(--s-6) 0 0; margin: var(--s-6) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-5); border-top: 1px solid var(--line); }
  .hero-stats b { display: block; font-family: var(--font-display); font-size: var(--step-3); font-weight: 680; letter-spacing: -0.03em; color: var(--ink); }
  .hero-stats b i { font-style: normal; color: var(--live); font-size: 0.7em; }
  .hero-stats span { display: block; margin-top: 5px; font-size: var(--step--1); color: var(--fg-quiet); }
  @media (max-width: 720px) { .hero-stats { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- manifesto ---------- */
  .manifesto { padding: var(--s-9) 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--paper-sunken), var(--paper)); }
  .man-eyebrow { color: var(--live); margin-bottom: var(--s-5); }
  .man-h2 { font-size: var(--step-3); font-weight: 640; line-height: 1.12; letter-spacing: -0.025em; max-width: 24ch; }
  .man-h2 .tl { color: var(--live); }
  .man-grid { margin-top: var(--s-7); display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-6) var(--s-8); max-width: 1000px; }
  @media (max-width: 760px) { .man-grid { grid-template-columns: 1fr; } }
  .man-grid p { color: var(--fg-soft); font-size: var(--step-0); line-height: 1.6; }
  .man-grid b { color: var(--ink); font-weight: 620; display: block; margin-bottom: 4px; font-family: var(--font-display); font-size: var(--step-1); letter-spacing: -0.01em; }
  .man-grid code { color: var(--live); }

  /* ---------- bands ---------- */
  .band { padding: var(--s-9) 0; border-top: 1px solid var(--line); }
  .band-alt { background: var(--paper-sunken); }
  .band-head { max-width: 60ch; margin-bottom: var(--s-7); }
  .band-head h2 { margin-bottom: var(--s-3); }
  .band-sub { font-size: var(--step-1); color: var(--fg-soft); line-height: 1.5; }
  .band-sub code, .band-sub strong { color: var(--ink); }
  .band-sub code { color: var(--live); font-size: 0.92em; }
  .band-more { display: inline-block; margin-top: var(--s-6); font-weight: 550; color: var(--live); }
  .band-more:hover { color: var(--live-bright); }

  /* ---------- loop ---------- */
  .loop-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); border: 1px solid var(--line); border-radius: var(--r-3); overflow: hidden; background: var(--paper-raised); }
  .loop-steps li { padding: var(--s-5) var(--s-4); display: flex; flex-direction: column; gap: 8px; border-right: 1px solid var(--line); position: relative; }
  .loop-steps li:last-child { border-right: 0; }
  .loop-steps li.dec { background: var(--brand-wash); }
  .ls-n { font-family: var(--font-mono); font-size: 11px; color: var(--live-dim); }
  .ls-k { font-size: var(--step--1); color: var(--fg-soft); font-weight: 500; }
  .loop-steps code { font-family: var(--font-mono); font-size: 12.5px; color: var(--fg); }
  .loop-steps code.ok { color: var(--live); }
  .loop-steps li.dec code { color: var(--brand); }
  @media (max-width: 760px) { .loop-steps { grid-template-columns: repeat(2, 1fr); } .loop-steps li { border-bottom: 1px solid var(--line); } }
  .loop-latest { margin-top: var(--s-5); line-height: 1.7; color: var(--fg-soft); max-width: 96ch; }
  .loop-latest .dec-t { color: var(--brand); } .loop-latest .ship { color: var(--live); }

  /* ---------- specialists ---------- */
  .spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  @media (max-width: 860px) { .spec-grid { grid-template-columns: 1fr; } }
  .spec { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-3); padding: clamp(var(--s-5), 3vw, var(--s-6)); display: flex; flex-direction: column; transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out); }
  .spec:hover { border-color: var(--live-dim); transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .spec-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-4); }
  .mono-label.live { color: var(--live); } .mono-label.brand { color: var(--brand); }
  .spec-badge { font-family: var(--font-mono); font-size: var(--step--1); color: var(--fg-quiet); border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 10px; }
  .spec-body { color: var(--fg-soft); margin: var(--s-2) 0 var(--s-5); }
  .spec-body strong { color: var(--ink); } .spec-body em { font-style: normal; color: var(--brand); font-weight: 560; }
  .spec-metrics { display: flex; gap: var(--s-6); margin: 0 0 var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .spec-metrics dt { font-size: var(--step--1); color: var(--fg-quiet); margin-bottom: 3px; }
  .spec-metrics dd { font-family: var(--font-mono); font-size: var(--step-0); color: var(--fg); }
  .spec-metrics dd b { color: var(--live); } .spec-metrics dd.down { color: var(--brand); }
  .spec-link { margin-top: auto; font-weight: 550; color: var(--ink); }
  .spec-link:hover { color: var(--live); }

  /* ---------- metrics ---------- */
