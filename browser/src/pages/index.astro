<style is:global>
  :root {
    color-scheme: dark;

    /* Surfaces */
    --bg: #08090a;
    --bg-1: #0b0d10;
    --bg-2: #0f1217;
    --bg-3: #141821;
    --bg-hover: #161a23;

    /* Lines */
    --line: #1a1e26;
    --line-soft: #14171e;
    --line-strong: #262b35;

    /* Ink */
    --fg: #ecedf0;
    --fg-soft: #c4c8d0;
    --fg-quiet: #98a0ad;
    --muted: #7a8290;
    --faint: #565d68;

    /* Brand */
    --accent: #8db4ff;          /* cool blue */
    --accent-strong: #a8c5ff;
    --accent-dim: rgba(141, 180, 255, 0.32);
    --accent-glow: rgba(141, 180, 255, 0.12);
    --warm: #ffb072;            /* warm orange */
    --warm-dim: rgba(255, 176, 114, 0.32);

    /* Type */
    --font-sans: "Geist Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: "Geist Mono Variable", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;

    /* Rhythm */
    --r-1: 6px;
    --r-2: 10px;
    --r-3: 14px;
    --r-4: 20px;

    /* Spacing scale, varied for rhythm */
    --s-1: 6px;
    --s-2: 10px;
    --s-3: 16px;
    --s-4: 24px;
    --s-5: 36px;
    --s-6: 56px;
    --s-7: 88px;
    --s-8: 128px;

    /* z scale */
    --z-skip: 100;
    --z-topbar: 50;
  }

  * { box-sizing: border-box; }
  *:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
    border-radius: 4px;
  }

  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--fg);
    font: 400 16px/1.65 var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection { background: var(--accent-dim); color: var(--fg); }

  code {
    font: 400 0.86em/1.4 var(--font-mono);
    background: var(--bg-2);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--fg-soft);
    white-space: nowrap;
  }
  em { font-style: italic; color: var(--fg-soft); }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 140ms ease, color 140ms ease;
  }
  a:hover { text-decoration-color: var(--accent); color: var(--accent-strong); }

  .skip-link {
    position: absolute;
    top: -100px; left: 12px;
    z-index: var(--z-skip);
    background: var(--bg-2);
    border: 1px solid var(--line-strong);
    color: var(--fg);
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13px;
  }
  .skip-link:focus-visible { top: 12px; }

  /* ========== TOPBAR ========== */
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 14px clamp(16px, 4vw, 32px);
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg);
  }
  .brand-lockup:hover { color: var(--fg); }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 30px; height: 30px;
    border-radius: 7px;
    background:
      linear-gradient(145deg, color-mix(in oklab, var(--accent) 32%, var(--bg-3)),
                              color-mix(in oklab, var(--warm) 18%, var(--bg-3)));
    border: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
    box-shadow: 0 0 24px var(--accent-glow);
    color: var(--fg);
    font: 600 15px/1 var(--font-mono);
  }
  .brand-name {
    font: 600 15px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .topnav {
    display: flex;
    gap: clamp(10px, 2.5vw, 22px);
    align-items: center;
    font: 400 13px/1 var(--font-sans);
  }
  .topnav a {
    color: var(--fg-quiet);
    text-decoration: none;
    padding: 8px 2px;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .topnav a:hover { color: var(--fg); border-bottom-color: var(--accent); }
  @media (max-width: 560px) {
    .topnav { gap: 14px; font-size: 12px; }
    .topnav a:nth-child(n + 4) { display: none; } /* keep playground, leaderboard, github */
  }

  /* ========== LANDING SHELL ========== */
  .landing {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(36px, 8vw, 80px) clamp(18px, 5vw, 36px) 96px;
  }

  /* ========== HERO ========== */
  .hero {
    position: relative;
    padding: 0 0 var(--s-6);
    margin-bottom: var(--s-7);
    border-bottom: 1px solid var(--line);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -40px -10% auto;
    height: 380px;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 14% 18%, var(--accent-glow), transparent 55%),
      radial-gradient(ellipse at 78% 6%, color-mix(in oklab, var(--warm) 16%, transparent), transparent 55%);
    opacity: 0.85;
    z-index: -1;
  }
  .hero-kicker {
    margin: 0 0 var(--s-3);
    font: 500 13.5px/1.4 var(--font-mono);
    color: var(--warm);
    letter-spacing: -0.005em;
  }
  .hero h1 {
    margin: 0 0 var(--s-4);
    font: 600 clamp(34px, 6.4vw, 68px)/1.05 var(--font-sans);
    letter-spacing: -0.035em;
    color: var(--fg);
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero h1 .highlight {
    color: var(--fg-soft);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.025em;
  }
  .hero-lede {
    margin: 0 0 var(--s-5);
    font-size: clamp(15.5px, 1.7vw, 18px);
    line-height: 1.7;
    color: var(--fg-soft);
    max-width: 68ch;
    text-wrap: pretty;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: var(--s-4);
  }
  .cta {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 20px;
    border-radius: var(--r-2);
    text-decoration: none;
    transition: transform 160ms cubic-bezier(0.2, 0.7, 0.1, 1),
                background 140ms ease, border-color 140ms ease;
    min-width: 240px;
  }
  .cta-label { font-size: 14.5px; font-weight: 500; }
  .cta-sub { font-size: 12px; color: var(--muted); font-weight: 400; }
  .cta code {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    white-space: normal;
  }
  .cta.primary {
    background: var(--accent);
    color: #06080c;
    border: 1px solid var(--accent);
  }
  .cta.primary .cta-sub { color: rgba(6, 8, 12, 0.7); }
  .cta.primary:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    transform: translateY(-1px);
  }
  .cta.secondary {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--line-strong);
  }
  .cta.secondary:hover {
    border-color: var(--accent-dim);
    background: var(--bg-2);
    transform: translateY(-1px);
  }
  .hero-fineprint {
    font: 400 12.5px/1.6 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }

  /* ========== SECTION SCAFFOLD ========== */
  section { margin-bottom: var(--s-7); }
  .section-h2 {
    font: 500 clamp(22px, 3vw, 30px)/1.2 var(--font-sans);
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-3);
    color: var(--fg);
    text-wrap: balance;
  }
  .section-blurb {
    font-size: 15px;
    color: var(--fg-soft);
    line-height: 1.7;
    margin: 0 0 var(--s-5);
    max-width: 68ch;
    text-wrap: pretty;
  }

  /* ========== NUMBER CARD ========== */
  .number-card {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--accent) 4%, var(--bg-1)) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: var(--r-4);
    padding: clamp(22px, 4vw, 40px);
    position: relative;
    overflow: hidden;
  }
  .number-card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: var(--r-4);
    padding: 1px;
    background: linear-gradient(160deg, var(--accent-dim), transparent 40%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
  .num-eyebrow {
    margin: 0 0 var(--s-2);
    font: 500 12.5px/1.4 var(--font-mono);
    color: var(--warm);
  }
  .num-h2 {
    margin: 0 0 var(--s-5);
    font: 500 clamp(22px, 3vw, 30px)/1.25 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--fg);
    max-width: 28ch;
    text-wrap: balance;
  }
  .num-figure {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 2.2fr);
    gap: clamp(20px, 4vw, 44px);
    align-items: start;
  }
  @media (max-width: 720px) {
    .num-figure { grid-template-columns: 1fr; gap: 28px; }
  }
  .num-figure-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 1px solid var(--line); /* allowed: gutter, not stripe-accent */
    padding-left: clamp(14px, 2vw, 22px);
  }
  @media (max-width: 720px) {
    .num-figure-left { border-left: none; padding-left: 0; }
  }
  .num-hero {
    font: 600 clamp(72px, 14vw, 132px)/0.95 var(--font-mono);
    letter-spacing: -0.04em;
    color: var(--accent);
    display: inline-flex;
    align-items: baseline;
  }
  .num-hero .num-pct {
    font-size: 0.5em;
    color: var(--accent-strong);
    margin-left: 2px;
  }
  .num-hero-label {
    font: 400 13px/1.4 var(--font-mono);
    color: var(--muted);
    margin-top: 2px;
  }
  .num-bars {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr) auto;
    align-items: center;
    gap: 14px;
  }
  @media (max-width: 540px) {
    .bar-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .bar-value { justify-self: end; }
  }
  .bar-label {
    font: 400 13.5px/1.4 var(--font-sans);
    color: var(--fg-soft);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .is-us .bar-label { color: var(--fg); font-weight: 500; }
  .bar-tag {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg-2);
    border: 1px solid var(--line);
    padding: 3px 6px;
    border-radius: 999px;
  }
  .bar-tag-accent {
    color: var(--accent-strong);
    background: var(--accent-glow);
    border-color: var(--accent-dim);
  }
  .bar-track {
    position: relative;
    height: 8px;
    background: var(--bg-3);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w, 0%);
    background: linear-gradient(90deg, var(--fg-quiet), var(--fg-soft));
    border-radius: 999px;
    transform-origin: left center;
    animation: barIn 900ms cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  .bar-fill-accent {
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
    box-shadow: 0 0 24px var(--accent-glow);
  }
  .bar-value {
    font: 500 14px/1 var(--font-mono);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .bar-value .pct { color: var(--muted); font-weight: 400; margin-left: 1px; }
  .is-us .bar-value { color: var(--accent-strong); }
  @keyframes barIn {
    from { transform: scaleX(0); opacity: 0.4; }
    to   { transform: scaleX(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar-fill { animation: none; }
  }
  .num-caption {
    margin: var(--s-5) 0 0;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 72ch;
  }
  .num-caption a { color: var(--accent); }

  /* ========== METRICS ========== */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
    margin: 0;
  }
  .metric {
    background: var(--bg-1);
    padding: var(--s-4) var(--s-4);
    transition: background 140ms ease;
  }
  .metric:hover { background: var(--bg-2); }
  .metric dt {
    font: 400 12px/1.3 var(--font-mono);
    color: var(--muted);
    margin: 0 0 var(--s-2);
    letter-spacing: 0;
  }
  .metric dd {
    margin: 0 0 var(--s-2);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--fg);
  }
  .m-val {
    font: 500 clamp(30px, 4vw, 38px)/1 var(--font-mono);
    letter-spacing: -0.03em;
  }
  .m-unit {
    font: 400 14px/1 var(--font-mono);
    color: var(--fg-quiet);
  }
  .m-pct {
    font: 400 11px/1 var(--font-mono);
    color: var(--muted);
    background: var(--bg-3);
    padding: 3px 6px;
    border-radius: 4px;
    margin-left: 4px;
  }
  .m-note {
    margin: 0;
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--muted);
  }

  /* ========== PIPELINE ========== */
  .pipeline {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--line);
    counter-reset: step;
  }
  .step {
    background: var(--bg-1);
    padding: var(--s-4) var(--s-4) calc(var(--s-4) + 4px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    transition: background 140ms ease;
  }
  .step:hover { background: var(--bg-2); }
  .step-loop { background: color-mix(in oklab, var(--warm) 6%, var(--bg-1)); }
  .step-loop:hover { background: color-mix(in oklab, var(--warm) 9%, var(--bg-2)); }
  .step-num {
    font: 500 11px/1 var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .step-loop .step-num { color: var(--warm); }
  .step-name {
    font: 500 15px/1.3 var(--font-sans);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .step-cmd {
    font: 400 12px/1.4 var(--font-mono);
    color: var(--accent);
    background: var(--bg-2);
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    align-self: flex-start;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .step-loop .step-cmd { color: var(--warm); }
  .step-detail {
    font: 400 12.5px/1.55 var(--font-sans);
    color: var(--fg-quiet);
  }
  .step-detail code {
    background: var(--bg-3);
    font-size: 0.92em;
    padding: 0 4px;
    border-color: var(--line);
  }

  /* arrow between steps - hidden on wrap rows, on by hover for affordance */
  @media (min-width: 720px) {
    .step::after {
      content: "";
      position: absolute;
      right: -10px;
      top: 50%;
      width: 20px;
      height: 1px;
      background: var(--line-strong);
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 1;
    }
    .step:nth-last-child(1)::after { display: none; }
  }

  /* ========== PILLARS ========== */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 14px;
  }
  .pillar {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    transition: border-color 140ms ease, background 140ms ease, transform 240ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .pillar:hover {
    border-color: var(--line-strong);
    background: var(--bg-2);
    transform: translateY(-1px);
  }
  .pillar header { display: flex; flex-direction: column; gap: var(--s-2); }
  .pillar-tag {
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
    background: var(--accent-glow);
    border: 1px solid var(--accent-dim);
    padding: 4px 8px;
    border-radius: 999px;
    align-self: flex-start;
  }
  .pillar-tag-warm {
    color: var(--warm);
    background: color-mix(in oklab, var(--warm) 12%, transparent);
    border-color: var(--warm-dim);
  }
  .pillar h3 {
    margin: 0;
    font: 500 17px/1.3 var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: balance;
  }
  .pillar ul {
    list-style: none;
    margin: 0; padding: 0;
  }
  .pillar li {
    font: 400 13.5px/1.6 var(--font-sans);
    color: var(--fg-soft);
    padding: 8px 0;
    border-top: 1px solid var(--line-soft);
  }
  .pillar li:first-child { border-top: none; padding-top: 0; }
  .pillar li strong { color: var(--fg); font-weight: 500; }
  .pillar li em { color: var(--fg-quiet); }
  .pillar-prose {
    margin: 0;
    font: 400 14px/1.7 var(--font-sans);
    color: var(--fg-soft);
  }
  .pillar-browser {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--warm) 5%, var(--bg-1)) 0%, var(--bg-1) 100%);
    border-color: var(--warm-dim);
  }
  .pillar-browser:hover { border-color: var(--warm); background: var(--bg-2); }
  .pillar-cta {
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
  }
  .inline-cta {
    text-decoration: none;
    color: var(--warm);
