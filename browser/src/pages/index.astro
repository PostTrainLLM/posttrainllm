---
import Default from "../layouts/Default.astro";
import Logo from "../components/Logo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import attemptLedger from "../../../docs/attempts.json";
import artifactJourney from "../../../docs/learn/artifact-journey.json";
import learningPaths from "../../../docs/learn/path-registry.json";
import recipeRegistry from "../../../docs/recipes/registry.json";
import { artifacts } from "../artifacts";
import { macReleaseRecord } from "../data/mac-release";
import { evaluateMacRelease, macReleaseStatusLabel } from "../lib/mac-release";
import "../styles/system.css";

const REPO = "https://github.com/PostTrainLLM/posttrainllm";
const macRelease = evaluateMacRelease(macReleaseRecord);
const macReleaseLabel = macReleaseStatusLabel(macRelease);
const attemptCount = attemptLedger.attempts.length;
const workedCount = attemptLedger.attempts.filter(
  (attempt) => attempt.status === "worked",
).length;
const caveatCount = attemptLedger.attempts.filter(
  (attempt) => attempt.status === "worked-with-caveat",
).length;
const nonPositiveCount = attemptCount - workedCount - caveatCount;
const learningPathCount = learningPaths.paths.length;
const recipeCount = recipeRegistry.recipes.length;
const buildableArtifactCount = artifactJourney.stages.flatMap(
  (stage) => stage.artifacts,
).length;
---

<Default
  title="PostTrainLLM — Build and measure specialist LLMs on a Mac"
  description="Build bounded specialist language models sized to one Apple Silicon machine, then distill, fine-tune, evaluate, package, and inspect them with reproducible evidence."
  themeColor="#0a0c0f"
  ogTitle="PostTrainLLM — Build and measure specialist LLMs on a Mac"
  ogDescription="A one-machine research lab for bounded specialists: fine-tune, evaluate honestly, package for MLX, and publish the evidence."
>
  <SiteHeader mode="instrument" />

  <main class="landing" id="main">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="wrap hero-inner">
        <p class="hero-kicker mono-label reveal">
          <span class="pulse"></span> a one-machine research lab · MIT
        </p>
        <h1 class="hero-h1">
          Build a specialist.<br /><span class="tl">Prove it on one Mac.</span>
        </h1>
        <p class="hero-lede reveal">
          Turn a stock open model into a <em>routed specialist</em> on one Mac — then
          measure every win and regression. Distill, fine-tune, evaluate, package
          for MLX, and inspect the result.
        </p>
        <div class="hero-cta reveal">
          <a class="btn btn-primary" href="/docs/quickstart">Run the factory</a>
          <a class="btn btn-ghost" href="/artifacts"
            >Inspect specialist proof →</a
          >
        </div>
        <a class="mac-release-entry reveal" href="/download">
          <span>Native Mac app</span>
          <span
            class:list={["mac-release-dot", { ready: macRelease.downloadable }]}
            aria-hidden="true"></span>
          <strong>{macReleaseLabel}</strong>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- The trace gets its own evidence band so it can never cross a hero action. -->
      <div class="hero-curve-band" aria-hidden="true">
        <svg
          class="hero-curve"
          viewBox="0 0 1440 260"
          preserveAspectRatio="none"
        >
          <defs>
            <linearGradient id="lcv" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#48e5c2" stop-opacity="0.14"></stop>
              <stop offset="1" stop-color="#48e5c2" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path
            class="hc-fill"
            d="M0,10 C190,16 330,58 480,104 C720,176 1040,155 1440,155 L1440,260 L0,260 Z"
            fill="url(#lcv)"></path>
          <path
            class="hc-line"
            d="M0,10 C190,16 330,58 480,104 C720,176 1040,155 1440,155"
            fill="none"
            stroke="#48e5c2"
            stroke-width="2"
            stroke-linecap="round"></path>
          <circle class="hc-dot" cx="1440" cy="155" r="5" fill="#48e5c2"
          ></circle>
        </svg>
        <div class="wrap hero-curve-caption-wrap">
          <p class="hero-curve-cap mono-label">
            historical learning run · huge-base-v1 · 200k steps · loss 4.16
          </p>
        </div>
      </div>

      <div class="wrap">
        <ul class="hero-stats reveal" role="list">
          <li>
            <b>100<i>%</i></b><span>file ops · 12/12 · stock 9/12</span>
          </li>
          <li>
            <b>55.6<i>%</i></b><span>breadth · 25/45 · stock 30/45</span>
          </li>
          <li>
            <b>0</b><span>unexpected side effects · stock 8</span>
          </li>
          <li>
            <b>2.42<i>×</i></b><span>depth wall speed · 360.50s → 148.91s</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= ENTRY MAP ================= -->
    <section class="entry-map" aria-labelledby="entry-map-title">
      <div class="wrap">
        <header class="entry-map-head">
          <p class="mono-label">choose an entry point</p>
          <h2 id="entry-map-title">One lab, four ways in.</h2>
          <p>
            Build locally, work in the browser, inspect the evidence, or follow
            a structured learning path. Each route leads to something runnable
            or source-linked — not a feature claim without an artifact.
          </p>
        </header>
        <div class="entry-rail">
          <a href="/docs/quickstart">
            <span class="entry-number">01</span>
            <span class="entry-copy"
              ><b>Native factory</b><small
                >Train · evaluate · package · report on Apple Silicon</small
              ></span
            ><span aria-hidden="true">→</span>
          </a>
          <a href="/playground">
            <span class="entry-number">02</span>
            <span class="entry-copy"
              ><b>Web Lab</b><small
                >Browser training, inference, WebGPU tests, and dashboards</small
              ></span
            ><span aria-hidden="true">→</span>
          </a>
          <a href="/experiments">
            <span class="entry-number">03</span>
            <span class="entry-copy"
              ><b>Evidence</b><small
                >{attemptCount} attempts · {artifacts.length} public artifacts · frozen
                gates</small
              ></span
            ><span aria-hidden="true">→</span>
          </a>
          <a href="/learn">
            <span class="entry-number">04</span>
            <span class="entry-copy"
              ><b>Learning journey</b><small
                >{learningPathCount} paths · {recipeCount} recipes · {
                  buildableArtifactCount
                } things to build</small
              ></span
            ><span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= MANIFESTO ================= -->
    <section class="manifesto">
      <div class="wrap">
        <p class="man-eyebrow mono-label">the thesis</p>
        <h2 class="man-h2">
          Not trying to win the frontier. Trying to reach frontier
          <span class="tl">capability</span> at a fraction of the compute — and to
          understand the whole machine while doing it.
        </h2>
        <div class="man-grid">
          <p>
            <b>Win on the Mac.</b> Be best-in-class at what one Apple&nbsp;Silicon
            machine can actually do — train, post-train, evaluate, serve, inspect
            — with no cluster and no cloud dependency.
          </p>
          <p>
            <b>Learn the whole space.</b> From <code>y = mx + b</code> to a self-improving
            factory. Techniques are reproduced locally or integrated from the best
            available tools, anchored to evidence, and mapped to the files where they
            live.
          </p>
          <p>
            <b>Show the scars.</b> Failed runs are first-class. Every attempt is logged
            with the decision it forced. A number without its regression is marketing,
            not a result.
          </p>
          <p>
            <b>Build everything buildable here.</b> If it fits on this Mac, it gets
            built — and packaged so that when compute arrives, the lab scales from
            a running start.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= FACTORY LOOP ================= -->
    <section class="band loop-band">
      <div class="wrap">
        <header class="band-head">
          <h2>The loop the runtime closes.</h2>
          <p class="band-sub">
            Each surface emits the input the next one needs. Every run ends in a
            schema-valid folder — config, dataset, eval, decision, report — that <code
              >factory-run</code
            > validates.
          </p>
        </header>
        <ol class="loop-steps" role="list">
          <li>
            <span class="ls-n">01</span><span class="ls-k">target</span><code
              >file operations</code
            >
          </li>
          <li>
            <span class="ls-n">02</span><span class="ls-k">data</span><code
              >interleaved + depth anchor</code
            >
          </li>
          <li>
            <span class="ls-n">03</span><span class="ls-k">post-train</span
            ><code>teacher-free ReST</code>
          </li>
          <li>
            <span class="ls-n">04</span><span class="ls-k">eval</span><code
              class="ok">depth 12/12 · breadth 25/45</code
            >
          </li>
          <li>
            <span class="ls-n">05</span><span class="ls-k">package</span><code
              >fused bf16 · HF/MLX</code
            >
          </li>
          <li class="dec">
            <span class="ls-n">06</span><span class="ls-k">decide</span><code
              class="ship">routed-ship</code
            >
          </li>
        </ol>
        <p class="loop-latest mono-label">
          fresh paired proof · evaluated 2026-09-03 · qwen3-4b-rest-fused moved
          file operations from 9/12 to 12/12, removed eight side effects, and
          ran that slice 2.42× faster. breadth fell from 30/45 to 25/45, so the
          decision is <span class="ship">retain behind the file-ops route</span
          >, not promote as the general successor.
        </p>
      </div>
    </section>

    <!-- ================= SPECIALISTS ================= -->
    <section class="band">
      <div class="wrap">
        <header class="band-head">
          <h2>Specialists, honest by design.</h2>
          <p class="band-sub">
            A specialist beats a generalist on its target and routes away when
            it shouldn't answer. Every result ships with the regression it
            costs.
          </p>
        </header>
        <div class="spec-grid">
          <article class="spec">
            <div class="spec-top">
              <span class="mono-label live">research routed-ship · weights</span
              ><span class="spec-badge">4B · MLX</span>
            </div>
            <h3>Qwen3-4B, ReST fused</h3>
            <p class="spec-body">
              Fresh requalification moved file-operations depth from <strong
                >9/12</strong
              > to <strong>12/12</strong>, removed eight side effects, and ran
              the slice 2.42× faster. Breadth fell to <strong>25/45</strong> versus
              stock's 30/45, so it remains an explicit routed specialist.
            </p>
            <dl class="spec-metrics">
              <div><dt>file-ops gate</dt><dd>9/12 → <b>12/12</b></dd></div>
              <div><dt>breadth gate</dt><dd>30/45 → <b>25/45</b></dd></div>
            </dl>
            <p class="spec-limit">
              This is a depth, safety, and speed win—not a general-capability
              win. The frozen breadth regression forces routed-only use.
            </p>
            <a class="spec-link" href="/artifacts/qwen3-4b-rest-fused"
              >Artifact, evidence, and limits →</a
            >
          </article>
          <article class="spec">
            <div class="spec-top">
              <span class="mono-label brand">report-only candidate</span><span
                class="spec-badge">0.6B · routed</span
              >
            </div>
            <h3>Qwen3-0.6B, routed SQL</h3>
            <p class="spec-body">
              Two adapters behind a router. Two reference-anchored DPO retries
              cured a policy collapse and pushed execution to <strong
                >0.920</strong
              > — but output hygiene is a base-model prior a small adapter can't strip.
              Decision: <em>retry-data</em>.
            </p>
            <dl class="spec-metrics">
              <div><dt>synthetic exec</dt><dd>0.860 → <b>0.920</b></dd></div>
              <div><dt>clean-SQL</dt><dd class="down">0.000</dd></div>
            </dl>
            <a class="spec-link" href="/artifacts/qwen06-sql-routed-v1"
              >Full artifact + blockers →</a
            >
          </article>
        </div>
        <a class="band-more" href="/artifacts"
          >Every artifact, with evidence and blockers →</a
        >
      </div>
    </section>

    <!-- ================= CURRENT PROOF ================= -->
    <section class="band band-alt">
      <div class="wrap">
        <header class="band-head">
          <h2>Current specialist evidence.</h2>
          <p class="band-sub">
            These figures belong to <code>qwen3-4b-rest-fused</code>. The
            breadth set passed its frontier-ceiling calibration. Fresh paired
            traces support speed and memory reporting; the route stays narrow
            because the candidate lost five net breadth cases.
          </p>
        </header>
        <div class="metric-row" role="list">
          <div role="listitem">
            <b>100%</b><span class="mu">file ops</span><small
              >hard gate · n=12</small
            >
          </div>
          <div role="listitem">
            <b>55.6%</b><span class="mu">breadth</span><small
              >frontier-qualified · n=45</small
            >
          </div>
          <div role="listitem">
            <b>−11.1</b><span class="mu">points</span><small
              >versus stock breadth · reject general</small
            >
          </div>
          <div role="listitem">
            <b>HF + MLX</b><span class="mu">package</span><small
              >fused bf16 weights</small
            >
          </div>
          <div role="listitem">
            <b>2.42×</b><span class="mu">depth wall speed</span><small
              >360.50s → 148.91s</small
            >
          </div>
        </div>
        <a class="band-more" href="/artifacts/qwen3-4b-rest-fused"
          >Read the scorecard, evidence, and limits →</a
        >
      </div>
    </section>

    <!-- ================= THE STACK ================= -->
    <section class="band">
      <div class="wrap">
        <header class="band-head">
          <h2>The whole stack — audited against the code.</h2>
          <p class="band-sub">
            Not a landing-page inventory. The capabilities below map to real
            subcommands and repository test or evaluation evidence.
          </p>
        </header>
        <div class="pillars">
          <div class="pillar">
            <span class="pillar-i mono-label">train</span><p>
              Pretrain, SFT, DPO / SimPO / KTO / ORPO, distillation, ES. Full
              PEFT — LoRA, LoRA+, DoRA, VeRA, LoftQ, AdaLoRA, PISSA. WSD
              schedules, spike recovery, z-loss.
            </p>
          </div>
          <div class="pillar">
            <span class="pillar-i mono-label">eval</span><p>
              BFCL, τ-bench, lm-eval (MLX adapter), HumanEval + sandbox, SQL
              execution, router, MILU, MTEB. Frozen baselines, slice metrics,
              non-zero-exit gates.
            </p>
          </div>
          <div class="pillar">
            <span class="pillar-i mono-label">serve</span><p>
              OpenAI- and Ollama-compatible on one socket. Agent loop, tool
              dispatch, FSM-constrained JSON, persistent KV cache, speculative
              decoding, optional cloud escalation.
            </p>
          </div>
          <div class="pillar">
            <span class="pillar-i mono-label">package</span><p>
              Export to MLX, safetensors, CoreML. Quantize (GGUF / AWQ / GPTQ /
              HQQ), prune, merge, bake-LoRA with DoRA magnitudes. Specialist
              model cards.
            </p>
          </div>
          <div class="pillar">
            <span class="pillar-i mono-label">inspect</span><p>
              SAE features, ROME, MEMIT, tuned / logit lens, activation
              patching, linear probes, attention heatmaps. Know <em>where</em> the
              model decides.
            </p>
          </div>
          <div class="pillar">
            <span class="pillar-i mono-label">browser</span><p>
              The same model trains in a browser tab via hand-written WebGPU
              kernels — Memory64, FlashAttention-2, blocked matmul. A
              from-scratch learning track, honest negative results included.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= LAB LOGS ================= -->
    <section class="band band-alt">
      <div class="wrap">
        <header class="band-head">
          <h2>The lab keeps a paper trail.</h2>
          <p class="band-sub">
            Most attempts are not clean wins. That is the useful shape of the
            evidence: caveated mechanism proofs and non-positive boundary
            results stay visible, with the decision they forced and the files
            where the evidence lives.
          </p>
        </header>
        <a
          class="outcome-ledger"
          href="/experiments"
          aria-label="Open all experiment results"
        >
          <span class="outcome-intro">
            <span class="mono-label">all {attemptCount} attempts resolved</span>
            <strong>The result distribution, without spin.</strong>
          </span>
          <span class="outcome-count positive"
            ><b>{workedCount}</b><small>worked cleanly</small></span
          >
          <span class="outcome-count caveat"
            ><b>{caveatCount}</b><small>worked with caveat</small></span
          >
          <span class="outcome-count negative"
            ><b>{nonPositiveCount}</b><small
              >failed, regressed, rejected, inconclusive, or superseded</small
            ></span
          >
          <span class="outcome-go" aria-hidden="true">→</span>
        </a>
        <p class="outcome-note">
          “Worked with caveat” means the mechanism was demonstrated inside a
          stated boundary; it is not a positive product result. The {
            nonPositiveCount
          }
          non-positive or mixed attempts are retained as boundary maps, not hidden
          as unsuccessful demos.
        </p>
        <div class="logs">
          <a class="log log-lead" href="/learn">
            <span class="mono-label live">learning log</span>
            <h3>Ground-up, in 10 modules</h3>
            <p>
              From <code>y = mx + b</code> to a self-improving factory. Each curriculum
              subsystem maps to an anchor in the coverage map so the learning path
              stays inspectable.
            </p>
            <span class="log-go">Open the curriculum →</span>
          </a>
          <a class="log" href="/experiments"
            ><span class="mono-label">attempt ledger</span><h4>
              What we tried
            </h4><p>
              Worked · failed · regressed · retried — each with a decision.
            </p></a
          >
          <a class="log" href="/devlog"
            ><span class="mono-label">devlog</span><h4>How it was built</h4><p>
              Kernels, bugs, and the surprises worth more than the code.
            </p></a
          >
          <a class="log" href="/recipes"
            ><span class="mono-label">recipes</span><h4>Method → recipe</h4><p>
              Not "try DPO" — a named failure mode, data, gate, and stop rule.
            </p></a
          >
          <a class="log" href="/docs/techniques/interpretability"
            ><span class="mono-label">interpretability</span><h4>
              Where it decides
            </h4><p>Lens, patching, SAE, ROME, MEMIT.</p></a
          >
        </div>
      </div>
    </section>

    <!-- ================= HONEST + RUN ================= -->
    <section class="band">
      <div class="wrap honest-wrap">
        <div>
          <h2>Honest scope.</h2>
          <ul class="honest-list is">
            <li>A single-developer project, shipping in public, MIT.</li>
            <li>Mac-first — M-series, unified memory, MLX-Swift.</li>
            <li>
              Models and runs are deliberately bounded to the available
              hardware.
            </li>
            <li>
              One research-only routed ship, with missing evidence disclosed.
            </li>
            <li>
              A factory for <em>specialists</em>, not a general assistant.
            </li>
            <li>An OpenAI-compatible runtime any client already speaks.</li>
          </ul>
          <ul class="honest-list isnt">
            <li>
              Not a product-default proof. The ReST package still needs a fresh,
              Pace-specific gate before any runtime promotion.
            </li>
            <li>Not multi-GPU or distributed. One device, one Mac.</li>
            <li>
              Not a cloud product. Nothing leaves the laptop unless you ask.
            </li>
          </ul>
        </div>
        <aside class="run-col">
          <span class="mono-label live">run it — one Mac, from source</span>
          <pre
            class="run-block"
            tabindex="0"
            aria-label="PostTrainLLM build and validation commands"><code><span class="c"># build the native factory</span>
git clone https://github.com/PostTrainLLM/posttrainllm.git
cd posttrainllm/native-mac
xcrun swift build -c release
BIN=.build/release/posttrainllm

<span class="c"># inspect the current factory surface</span>
$BIN --help
$BIN factory-run validate ../runs/&lt;run-id&gt;</code></pre>
          <a class="btn btn-primary" href="/docs/quickstart"
            >Full quickstart →</a
          >
        </aside>
      </div>
    </section>

    <!-- ================= CLOSING ================= -->
    <section class="closer" aria-labelledby="closer-h2">
      <svg
        class="closer-curve"
        viewBox="0 0 1440 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M0,30 C240,38 380,190 700,232 C980,268 1240,274 1440,278"
          fill="none"
          stroke="#48e5c2"
          stroke-opacity="0.25"
          stroke-width="1.5"></path>
      </svg>
      <div class="wrap closer-inner">
        <h2 id="closer-h2">
          See the training loop.<br /><span class="tl">On a tiny model.</span>
        </h2>
        <p>
          The browser playground is a bounded learning demo, not the specialist
          factory. Train a tiny GPT there, or use the native quickstart for a
          real Mac-local factory run.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/docs/quickstart">Run the factory</a>
          <a class="btn btn-ghost" href="/playground">Open the tiny demo →</a>
        </div>
      </div>
    </section>
    <section class="education-directory" aria-labelledby="education-title">
      <p class="section-label">FIELD GUIDES / MAC-LOCAL PRACTICE</p>
      <h2 id="education-title">Build the specialist, then prove it.</h2>
      <p>
        Five evidence-first guides connect the public factory to concrete Apple
        Silicon workflows.
      </p>
      <div>
        <a href="/how-to-train-your-own-llm"
          >How to train your own LLM <span>→</span></a
        >
        <a href="/fine-tune-llm-on-mac"
          >Fine-tune an LLM on Mac <span>→</span></a
        >
        <a href="/mlx-lora-fine-tuning">MLX LoRA and QLoRA <span>→</span></a>
        <a href="/evaluate-local-llm">Evaluate a local LLM <span>→</span></a>
        <a href="/agent-trajectory-dataset"
          >Build a trajectory dataset <span>→</span></a
        >
        <a href="/build-small-language-model-specialist"
          >Build a routed specialist <span>→</span></a
        >
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap foot-grid">
      <div class="foot-intro">
        <a class="brand-lockup" href="/"
          ><Logo size={26} /><span class="brand-name">posttrainllm</span></a
        >
        <p>Build the specialist. Measure the tradeoff. Keep the evidence.</p>
      </div>
      <nav class="foot-group" aria-label="Build">
        <p>Build</p>
        <a href="/docs/quickstart">Native factory</a>
        <a href="/docs/cli-reference">CLI reference</a>
        <a href="/download">Verified Mac app</a>
        <a href="/playground">Browser training</a>
        <a href="/inference">Browser inference</a>
        <a href="/webgpu-test">WebGPU tests</a>
      </nav>
      <nav class="foot-group" aria-label="Measure">
        <p>Measure</p>
        <a href="/experiments">{attemptCount} experiments</a>
        <a href="/artifacts">Evidence artifacts</a>
        <a href="/benchmarks">Benchmarks</a>
        <a href="/leaderboard">Eval leaderboard</a>
        <a href="/training-dashboard">Training dashboard</a>
      </nav>
      <nav class="foot-group" aria-label="Learn">
        <p>Learn</p>
        <a href="/learn">{learningPathCount} learning paths</a>
        <a href="/recipes">{recipeCount} recipes</a>
        <a href="/docs">Documentation</a>
        <a href="/docs/architecture/how-it-works">Architecture</a>
        <a href="/devlog">Devlog</a>
        <a href="/changelog">Changelog</a>
      </nav>
      <nav class="foot-group" aria-label="Agents and source">
        <p>Agents + source</p>
        <a href="/llms.txt">Agent index</a>
