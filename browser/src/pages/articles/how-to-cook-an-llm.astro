  }
  .ingredient input {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    margin-top: 3px;
    accent-color: var(--live);
  }
  .ingredient strong {
    display: block;
    font-size: 14px;
    margin-bottom: 6px;
    font-weight: 500;
  }
  .sample-text {
    display: block;
    font: 12px/1.7 var(--font-mono);
    color: var(--ink-70);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .primary,
  .secondary,
  .text-button {
    display: inline-block;
    padding: 11px 16px;
    min-height: 44px;
    border-radius: 7px;
    font: 500 12px/1.65 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }
  .primary {
    background: var(--live);
    color: var(--paper);
    border: 1px solid var(--live);
  }
  .secondary {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .text-button {
    background: transparent;
    border: 0;
    color: var(--live);
    padding-inline: 4px;
  }
  button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .secondary[aria-pressed="true"] {
    background: var(--live-wash);
    border-color: var(--live);
    color: var(--live);
  }
  .state-receipt {
    font: 12px/1.8 var(--font-mono);
    color: var(--ink-70);
    padding: 17px 0;
    margin-top: 14px;
    border-top: 1px solid var(--line-strong);
  }
  .state-receipt strong {
    color: var(--ink);
  }
  .inspection {
    margin-top: 12px;
  }
  .inspection summary {
    font-size: 12px;
    color: var(--ink-70);
    cursor: pointer;
    padding: 10px 0;
    min-height: 44px;
  }
  .inspection pre {
    font: 12px/1.7 var(--font-mono);
    background: var(--sunken);
    padding: 16px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 260px;
    overflow: auto;
    border-radius: 5px;
    margin: 10px 0;
  }
  .inspection p {
    font-size: 12px;
    line-height: 1.65;
    color: var(--ink-70);
  }
  .exercise-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .small-note {
    font-size: 12px;
    color: var(--ink-70);
    line-height: 1.7;
    margin-top: 14px;
  }
  .takeaway {
    font: 18px/1.7 var(--font-display);
    border-left: 2px solid var(--live);
    padding-left: 20px;
  }
  .exercise blockquote {
    font-size: 18px;
    line-height: 1.6;
    margin: 12px 0 16px;
  }
  .illustrative {
    font: 11px/1.7 var(--font-mono);
    color: var(--brand);
    margin-bottom: 22px;
  }
  .checkpoint-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .checkpoint-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 20px 0;
  }
  .checkpoint-pair p {
    font-size: 12px;
    color: var(--ink-70);
    margin-top: 6px;
  }
  .output {
    font-size: 19px;
    line-height: 1.6;
    border-left: 2px solid var(--live-dim);
    padding: 12px 0 12px 18px;
    margin: 4px 0 16px;
