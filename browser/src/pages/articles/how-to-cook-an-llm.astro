    font-size: 13px;
    color: var(--ink-70);
    line-height: 1.8;
    margin-bottom: 14px;
  }
  .optimization {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }
  .optimization span {
    color: var(--live);
    margin: 0 7px;
  }
  .finish {
    padding-top: 22px;
  }
  .finish > p:not(.eyebrow) {
    color: var(--ink-70);
    font-size: 15px;
    line-height: 1.7;
  }
  .sources h2 {
    font-size: 27px;
  }
  .sources p,
  .sources li {
    font-size: 13px;
    color: var(--ink-70);
    line-height: 1.8;
  }
  .sources ul {
    padding-left: 20px;
    margin-top: 16px;
  }
  .sources a {
    color: var(--ink-70);
  }
  .sources a:hover {
    color: var(--live);
  }
  [hidden] {
    display: none !important;
  }
  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--live);
    outline-offset: 5px;
  }
  @media (max-width: 1100px) {
    .reading-grid {
      grid-template-columns: 120px minmax(0, 700px);
      gap: 28px;
    }
    .technical-margin {
      display: none;
    }
    .process-row,
    .lane-labels {
      grid-template-columns: 1fr 0.6fr 1fr;
      gap: 16px;
    }
    .process-side {
      gap: 10px;
    }
    .process-side h3 {
      font-size: 17px;
    }
  }
  @media (max-width: 768px) {
    .reading-grid {
      display: block;
      margin-top: 50px;
    }
    .chapter-nav {
      position: static;
      margin-bottom: 35px;
    }
    .chapter-nav nav {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }
    .aside-note {
      display: none;
    }
    .process-side {
      display: block;
    }
    .process-side h3 {
      font-size: 16px;
    }
    .bridge {
      gap: 3px;
    }
    .bridge p {
      font-size: 11px;
    }
    .connecting-rule {
      min-width: 4px;
    }
    .edition span:last-child {
      display: none;
    }
    .essay-head h1 {
      letter-spacing: -3px;
    }
    .essay-head > .eyebrow {
      padding-top: 40px;
    }
    .article-meta {
      margin-bottom: 40px;
    }
    .exercise {
      padding: 20px;
    }
    .chapter h2 {
      font-size: 31px;
    }
  }
  @media (max-width: 500px) {
