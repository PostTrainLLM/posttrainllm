  .prompt-reminder {
    font-size: 13px;
    color: var(--ink-70);
    margin-bottom: 18px;
  }
  .taste-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .taste-choice {
