  }
  .analogy-note strong {
    color: var(--brand);
  }
  .reading-grid {
    display: grid;
    grid-template-columns: 150px minmax(0, 700px) 150px;
    gap: 38px;
    justify-content: center;
    margin-top: 80px;
  }
  .chapter-nav,
  .technical-margin {
    font-size: 12px;
    line-height: 1.7;
    color: var(--ink-70);
    align-self: start;
    position: sticky;
    top: 100px;
  }
  .chapter-nav nav {
    display: grid;
    gap: 12px;
  }
  .chapter-nav a {
    color: var(--ink-70);
  }
  .aside-note {
    margin-top: 32px;
