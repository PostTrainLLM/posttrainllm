    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 26px;
  }
  .exercise h3,
  .finish h3 {
    font: 500 23px/1.3 var(--font-display);
    letter-spacing: -0.5px;
    margin-bottom: 20px;
  }
  .exercise fieldset {
