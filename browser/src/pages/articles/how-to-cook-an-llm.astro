---
import Default from "../../layouts/Default.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import KitchenScene from "../../components/content/KitchenScene.astro";
import KitchenDrawing from "../../components/content/KitchenDrawing.astro";
import KitchenWelcome from "../../components/content/KitchenWelcome.astro";
import "../../styles/system.css";
import {
  checkpoints,
  dinnerPrompt,
  ingredients,
  tasteResponses,
} from "../../kitchen/model";
const journey = [
  { id: "ingredients", scene: "harvest", name: "Harvest", model: "Find data" },
  { id: "chopping", scene: "chop", name: "Chop", model: "Inspect tokens" },
  { id: "cleaning", scene: "clean", name: "Clean", model: "Prepare the batch" },
  { id: "base-recipe", scene: "cook", name: "Cook", model: "Pre-train" },
  {
    id: "refine",
    scene: "serve",
    name: "Refine & serve",
    model: "Post-train → infer",
  },
  { id: "chat", scene: "serve", name: "Talk", model: "Live inference" },
] as const;
const title = "How to cook an LLM";
const description =
  "A hands-on journey from garden to table: gather data, inspect tokens, clean a batch, explore pre-training, then refine and serve. Kitchen and model-building steps travel together.";
const canonical = "https://posttrainllm.com/articles/how-to-cook-an-llm";
---

<Default
  title={`${title} | posttrainllm`}
  description={description}
  ogType="article"
  ogUrl={canonical}
  telemetry={false}
>
  <SiteHeader mode="instrument" active="learn" />
  <main id="main" class="cook-article journey-article">
    <KitchenWelcome journey={journey} />
    <nav class="journey-nav" aria-label="Journey stops">
      <span class="journey-reading" id="journey-current-label"
        >01 / Harvest</span
      ><div>
        {
          journey.map((stop, i) => (
            <a
              href={`#${stop.id}`}
              data-journey-link={i}
              aria-current={i === 0 ? "step" : undefined}
            >
              <span>0{i + 1}</span> {stop.name}
            </a>
          ))
        }
      </div>
    </nav>
    <noscript
      ><p class="small-note">
        The full reading journey is available below. Enable JavaScript for token
        previews, data preparation, and the training illustrations.
      </p></noscript
    >
    <div id="scene-controls" hidden>
      <a id="scene-back" class="text-button" href="#welcome">← Back</a><span
        id="scene-count"
        aria-live="polite">Choose a scene</span
      ><a id="scene-forward" class="text-button" href="#ingredients">Next →</a>
    </div>
    <article class="essay-body journey-body">
      <section
        id="ingredients"
        class="chapter journey-stop"
        data-journey-stage="0"
      >
        <p class="eyebrow">01 / In the garden</p><h2>Find your ingredients.</h2>
        <div class="scene-pair">
          <div class="scene-art">
            <KitchenScene kind="harvest" /><span
              >Kitchen / harvest what you need</span
            >
          </div><div class="scene-explanation">
            <span class="eyebrow">Model / gather training data</span>
            <KitchenDrawing kind="select" technical /><p>
              A model’s ingredients are text. Walk through the available sources
              and choose what belongs in your basket.
            </p><p class="scene-state">
              You’re collecting material.<br /><strong
                >No weights have changed.</strong
              >
            </p>
          </div>
        </div>
        <p>
          You’re making a three-ingredient dinner without dairy: rice, beans,
          and tomatoes. You don’t begin with the stove. You begin by finding
          ingredients that can make the dish you want.
        </p><p>
          Model-building starts the same way. You gather explanations,
          conversations, code, or other material from relevant sources. What you
          pick shapes what the model will have a chance to learn. These small,
          handwritten samples are our teaching harvest.
        </p>
        <div class="exercise harvest-exercise">
          <p class="eyebrow">Your first decision</p><h3>
            What goes in your basket?
          </h3><fieldset tabindex="0">
            <legend>Choose which text samples to keep</legend>{
              ingredients.map((sample) => (
                <label class="ingredient">
                  <>
                    <input
                      type="checkbox"
                      data-ingredient
                      value={sample.id}
                      checked={sample.keep}
                    />
                    <span>
                      <>
                        <strong>{sample.title}</strong>
                        <span class="sample-text">
                          {sample.id === "broken"
                            ? "Dinner[NUL][replacement character]"
                            : sample.text}
                        </span>
                      </>
                    </span>
                  </>
                </label>
              ))
            }
          </fieldset><p class="state-receipt" id="harvest-status" role="status">
            Your basket: empty. Nothing has been cleaned or trained yet.
          </p><p class="small-note">
            Read the samples before deciding. The sink removes exact repeats and
            malformed text. A recipe with cheese or an unrelated forecast can
            still be structurally clean; choosing relevant material is your
            decision.
          </p>
        </div>
        <a class="journey-next" href="#chopping"
          ><span>Take your basket inside</span><strong
            >Next: the cutting board →</strong
          ></a
        >
      </section>
      <section
        id="chopping"
        class="chapter journey-stop"
        data-journey-stage="1"
      >
        <p class="eyebrow">02 / At the cutting board</p><h2>
          Turn text into workable pieces.
        </h2>
        <div class="scene-pair">
          <div class="scene-art">
            <KitchenScene kind="chop" /><span>Kitchen / cut and portion</span>
          </div><div class="scene-explanation">
            <span class="eyebrow">Model / inspect preprocessing & tokens</span>
            <KitchenDrawing kind="prepare" technical /><p>
              A model processes token IDs. See how a sentence becomes smaller
              units it can work with.
            </p><p class="scene-state">
              You’re changing the representation.<br /><strong
                >The model stays unchanged.</strong
              >
            </p>
          </div>
        </div>
        <p>
          Put a sentence on the board. In our tiny trainer, cutting it into
          model inputs means encoding its UTF-8 bytes. Larger LLMs often use
          subword pieces instead. The knife is a way to understand tokenization,
          not how every tokenizer literally works.
        </p>
        <div class="exercise">
          <p class="eyebrow">Try the knife / real byte tokenization</p><label
            for="chop-text"
            class="input-label">Put some text on the cutting board</label
          ><input
            id="chop-text"
            class="chop-input"
            type="text"
            value="Rice and beans"
            maxlength="80"
          /><button type="button" id="chop-preview" class="primary"
            >Cut into tokens →</button
          ><div
            id="chopped-pieces"
            tabindex="0"
            class="token-pieces"
            aria-label="Byte token pieces"
          >
          </div><p id="chop-status" class="state-receipt" role="status">
            A preview of the tool, not a prepared training batch. Try “café” to
            see one character occupy multiple bytes.
          </p>
        </div>
        <p>
          We’re inspecting tokenization before preparing the full harvest. In
          the actual data pipeline, clean the source text first, then encode the
          finished batch. That is what we’ll do at the next stop.
        </p>
        <a class="journey-next" href="#cleaning"
          ><span>The pieces still need checking</span><strong
            >Next: wash and sort →</strong
          ></a
        >
      </section>
      <section
        id="cleaning"
        class="chapter journey-stop"
        data-journey-stage="2"
      >
        <p class="eyebrow">03 / At the sink</p><h2>
          Wash and sort your batch.
        </h2>
        <div class="scene-pair">
          <div class="scene-art">
            <KitchenScene kind="clean" /><span
              >Kitchen / wash, trim, and sort</span
            >
          </div><div class="scene-explanation">
            <span class="eyebrow">Model / clean, deduplicate, encode</span>
            <KitchenDrawing kind="prepare" technical /><p>
              Inspect the harvest. Remove exact repeats and deliberately broken
              samples, then tokenize what remains.
            </p><p class="scene-state">
              The batch is becoming usable.<br /><strong
                >Only the data changes.</strong
              >
            </p>
          </div>
        </div>
        <p>
          Now your earlier choices matter. Did you pick the same sample twice?
          Did a broken one slip into the basket? Clean the text before the final
          encoding and inspect what survives.
        </p>
        <div class="exercise" aria-labelledby="prep-title">
          <header>
            <p class="eyebrow">At the sink / real data preparation</p><h3
              id="prep-title"
            >
              Wash, sort, and check your batch.
            </h3>
          </header>

          <button type="button" id="prepare-batch" class="primary"
            >Prepare selected text →</button
          >
          <p id="prepare-status" class="state-receipt" role="status">
            What changed? Nothing yet. Model weights unchanged.
          </p>
          <details open class="inspection">
            <summary>Under the hood: prepared text & actual tokens</summary><pre
              id="prepared-text">Choose your text, then prepare a batch.</pre><pre
              id="token-preview">No batch prepared yet.</pre><p>
              This trainer uses one token per UTF-8 byte, with a vocabulary of
              256. “Rice” → [82, 105, 99, 101]. Non-ASCII characters can take
              several bytes. Larger LLMs commonly use subword tokenizers.
            </p>
          </details>
          <div class="exercise-actions">
            <button type="button" id="open-trainer" class="primary" disabled
              >Open this batch in the trainer →</button
            ><button
              type="button"
              id="download-batch"
              class="secondary"
              disabled>Download text</button
            >
          </div><p class="small-note">
            Handwritten teaching samples, not a production dataset. The trainer
            will offer an import; it won’t start training automatically. A tiny
            batch shows the mechanism, not general assistant capability.
          </p><p id="handoff-status" role="status" class="small-note"></p>
        </div>

        <p class="takeaway">
          You have ingredients ready for cooking. <strong
            >You still don’t have a trained model.</strong
          >
        </p>
        <a class="journey-next" href="#base-recipe"
          ><span>Carry the prepared batch to the stove</span><strong
            >Next: start cooking →</strong
          ></a
        >
      </section>
      <section
        id="base-recipe"
        class="chapter journey-stop"
        data-journey-stage="3"
      >
        <p class="eyebrow">04 / At the stove</p><h2>
          Start cooking the base recipe.
        </h2>
        <div class="scene-pair">
          <div class="scene-art">
            <KitchenScene kind="cook" /><span
              >Kitchen / cook, check, adjust</span
            >
          </div><div class="scene-explanation">
            <span class="eyebrow">Model / pre-training</span>
            <KitchenDrawing kind="pretrain" technical /><p>
              Predict the next token. Compare with the text’s actual next token.
              Use the error to guide a weight update.
            </p><p class="scene-state">
              Cook trains on your batch.<br /><strong
                >Your model’s weights change here.</strong
              >
            </p>
          </div>
        </div>
        <p>
          Chopping wasn’t cooking. Washing wasn’t cooking. Pre-training is the
          cooking: repeated practice develops the foundation. A generative model
          commonly learns by predicting the next token in a sequence.
        </p>
        <div class="exercise">
          <p class="eyebrow">Your batch → your weights</p><h3>Turn on the heat.</h3>
          <p>Train on your batch, right here in your browser.</p>
          <div class="cook-readings"><span>Training steps <strong id="cook-counter">0 / 256</strong></span><span>Prediction loss <strong id="cook-loss">—</strong></span></div>
          <svg class="cook-loss-chart" viewBox="0 0 320 76" role="img" aria-label="Actual training loss over time"><path d="M0 70H320" stroke="#30343b"/><polyline id="cook-curve" fill="none" stroke="#78dec6" stroke-width="2"/></svg>
          <progress id="cook-progress" max="256" value="0" aria-label="Training progress"></progress>
          <div class="exercise-actions"><button type="button" id="cook-step" class="primary">Cook my model →</button><button type="button" id="stop-cook" class="secondary" disabled>Turn off the heat</button><button type="button" id="reset-cook" class="text-button" disabled>Keep cooking · 256 steps</button></div>
          <p id="cook-status" class="state-receipt" role="status">Prepare your ingredients at the sink first. Nothing trains automatically.</p>
          <details><summary>What is in the pot?</summary><pre id="cook-corpus">No prepared batch yet.</pre><p>One transformer layer, byte tokens, existing WASM trainer. Up to 256 optimizer steps per click, with a 30-second stop. This small recipe teaches training; it does not create a general assistant.</p></details>
        </div>
        <p>
          A real optimizer repeats this cycle across many batches. Lower
          training loss is a signal about the objective, not a guarantee of
          usefulness. Set aside evaluation data to test whether the learning
          carries beyond the training examples.
        </p>
        <p class="paired-story">
          <strong>What the processes share:</strong> repeated trials can change the
          recipe. The difference is that a model learns numerical weights through
          an objective; it isn’t a cook understanding the dish.
        </p>
        <a class="journey-next" href="#refine"
          ><span>The foundation is cooked. Make it fit the brief.</span><strong
            >Next: taste, refine, and serve →</strong
          ></a
        >
      </section>
      <section id="refine" class="chapter journey-stop" data-journey-stage="4">
        <p class="eyebrow">05 / At the tasting and serving table</p><h2>
          Refine it. Then serve it.
        </h2>
        <div class="scene-pair">
          <div class="scene-art">
            <KitchenScene kind="serve" /><span
              >Kitchen / refine, plate, garnish, serve</span
            >
          </div><div class="scene-explanation">
            <span class="eyebrow">Model / post-training, then inference</span>
            <KitchenDrawing kind="sft" technical /><p>
              Worked examples and tasting feedback guide further training. A new
              order then uses the resulting model.
            </p><p class="scene-state">
              Refining can change weights.<br /><strong
                >Plating and serving do not.</strong
              >
            </p>
          </div>
        </div>
        <p>
          You’ve developed a base recipe, but the brief is specific: three
          ingredients, no dairy, a short answer. Learn from a worked example,
          taste two versions, and revise toward that brief. That is the
          post-training part of our journey.
        </p>
        <h3 class="subchapter">First, learn from a worked recipe.</h3><p>
          Supervised fine-tuning continues training on demonstrations of the
          desired response. Like practicing a particular recipe, it teaches the
          result you want to serve. With LoRA, that update can be carried in
          adapter weights while the base stays frozen.
        </p>
        <div class="exercise">
          <p class="eyebrow">Illustrative checkpoints</p><blockquote>
            {dinnerPrompt}
          </blockquote><p class="illustrative">
            Authored teaching outputs. No model was trained here.
          </p><div
            class="checkpoint-controls"
            role="group"
            aria-label="Choose an illustrative checkpoint"
          >
            {
              checkpoints.map((checkpoint, i) => (
                <button
                  type="button"
                  data-checkpoint={checkpoint.id}
                  aria-pressed={i === 0}
                  class="secondary"
                >
                  {checkpoint.title}
                </button>
              ))
            }
          </div><div class="checkpoint-pair">
            <div>
              <span>Kitchen</span><p id="checkpoint-kitchen">
                {checkpoints[0].kitchen}
              </p>
            </div><div>
              <span>Model</span><p id="checkpoint-method">
                {checkpoints[0].method}
              </p>
            </div>
          </div><div class="output" id="checkpoint-output">
            {checkpoints[0].output}
          </div><details class="inspection" open>
            <summary>Inspect the example or training objective</summary><pre
              id="checkpoint-evidence">{checkpoints[0].evidence}</pre>
          </details><p
            class="state-receipt"
            id="checkpoint-change"
            role="status"
          >
            Real run: {checkpoints[0].changed}. Here: illustrative output only.
          </p>
        </div>

        <div id="taste" class="subchapter-anchor">
          <h3 class="subchapter">Then taste two versions.</h3><p>
            The tasting table gives you a comparison. Choosing an answer records
            a preference; a separate optimization step uses it to change
            trainable weights. Both SFT and preference optimization belong
            within post-training.
          </p>
        </div>
        <div class="exercise">
          <p class="eyebrow">Your turn / become the taste tester</p><h3>
            Which meets the brief?
          </h3><p class="prompt-reminder">{dinnerPrompt}</p><div
            class="taste-options"
          >
            {
              (["a", "b"] as const).map((key) => (
                <button
                  type="button"
                  class="taste-choice"
                  data-taste={key}
                  aria-pressed="false"
                >
                  <>
                    <span class="eyebrow">Response {key.toUpperCase()}</span>
                    <span>{tasteResponses[key]}</span>
                    <span class="choose-label">Prefer this response</span>
                  </>
                </button>
              ))
            }
          </div><p id="preference-status" class="state-receipt" role="status">
            No preference collected. Model weights unchanged.
          </p><details class="inspection" open>
            <summary>Your preference tray / collected data</summary><pre
              id="preference-tray">Your tray is empty. Choose a response to collect a preference pair.</pre>
          </details><div class="exercise-actions">
            <button
              type="button"
              id="simulate-feedback"
              class="primary"
              disabled>Simulate training →</button
            ><button
              type="button"
              id="download-preference"
              class="secondary"
              disabled>Export pair</button
            ><button type="button" id="reset-feedback" class="text-button"
              >Reset</button
            >
          </div><div id="feedback-demo" class="feedback-demo" hidden>
            <p class="eyebrow">Illustration only / no model optimized</p><p
              class="optimization"
            >
              Pair collected <span aria-hidden="true">→</span> Optimization step
              <span aria-hidden="true">→</span> Candidate weights <span
                aria-hidden="true">→</span
              > Held-out evaluation
            </p><p id="feedback-example"></p><p class="small-note">
              DPO can optimize on preference pairs directly. RLHF can first fit
              a reward model and use it during reinforcement learning. This is a
              conceptual illustration of the separation, not a numerical
              simulation of either algorithm.
            </p>
          </div>
        </div>

        <div id="serve" class="subchapter-anchor">
          <h3 class="subchapter">Finally, plate, garnish, and serve.</h3><p>
            A finished recipe can fulfil another order without being rewritten.
            That is ordinary inference: fixed weights, a new prompt, a new
            response. Garnish is presentation—it can make an answer easier to
            read, but presentation alone isn’t post-training.
          </p><div class="exercise">
            <p class="eyebrow">
              A last distinction / same answer, different presentation
            </p><pre
              id="served-output"
              class="served-output">{tasteResponses.b}</pre><button
              type="button"
              id="add-garnish"
              class="secondary"
              aria-pressed="false">Add a heading / garnish the answer</button
            ><p id="garnish-status" class="state-receipt" role="status">
              Illustrative answer, not live generation. Model weights unchanged.
            </p>
          </div>
        </div>
        <p class="takeaway">
          Gather. Prepare. Cook. Refine. Serve. <strong
            >Now you know which steps change data, weights, or the answer’s
            presentation.</strong
          >
        </p>
        <a class="journey-next" href="#chat"
          ><span>Your model is ready at the table</span><strong
            >Take an order →</strong
          ></a
        >
        <div class="finish">
          <p class="eyebrow">Take your harvest into the real lab</p><h3>
            Your next dish can be a real run.
          </h3><p>
            Return to your prepared batch and offer it to the existing browser
            trainer. It demonstrates tiny next-token training from scratch, not
            the SFT or preference scenes above.
          </p><div class="exercise-actions">
            <a class="primary" href="#cleaning">Return to your batch ↑</a><a
              class="secondary"
              href="/playground">Explore the trainer →</a
            ><a class="text-button" href="/fine-tune-llm-on-mac"
              >Real post-training on a Mac →</a
            >
          </div>
        </div>
      </section>
      <section
        id="chat"
        class="chapter journey-stop chat-scene"
        data-journey-stage="5"
      >
        <p class="eyebrow">06 / Dinner is served</p>
        <h2>Meet the model you cooked.</h2>
        <div class="scene-pair"><div class="scene-art"><KitchenScene kind="serve" /><span>Kitchen / taste your own dish</span></div><div class="scene-explanation"><span class="eyebrow">Model / your trained weights</span><p>Start a sentence. Your model predicts what comes next using what it learned from your batch.</p><p class="scene-state">Same model. Same weights.<br/><strong>No pretrained assistant behind the curtain.</strong></p></div></div>
        <div class="live-chat">
          <div class="chat-topline"><span class="eyebrow" id="chat-model-name">Your kitchen model</span><span id="chat-engine">Not cooked yet</span></div>
          <p>This is a tiny byte-level text generator. Short training may produce fragments or nonsense; more practice can lower training loss without proving useful generalization. Its weights stay in this tab until you download them or leave the page.</p>
          <div class="exercise-actions"><a id="return-stove" class="primary" href="#base-recipe">Back to the stove →</a><button id="download-cooked" class="secondary" disabled>Take my model home ↓</button></div>
          <p id="chat-status" class="state-receipt" role="status">Cook your batch first, then try the model here.</p>
          <div id="chat-log" class="chat-log" role="log" aria-label="Your model’s completions" aria-live="off" tabindex="0"><p class="chat-empty">Your own model will be served here.</p></div>
          <form id="chat-form"><div class="prompt-label"><label for="chat-prompt">Start a sentence</label><button id="try-dinner" type="button" class="text-button" disabled>Use my batch’s opening</button></div><textarea id="chat-prompt" rows="2" maxlength="128" placeholder="Cook rice" disabled></textarea><div class="exercise-actions"><button id="send-chat" class="primary" disabled>Let it finish →</button><button id="stop-chat" type="button" class="secondary" disabled>Stop</button><button id="clear-chat" type="button" class="text-button">Clear plate</button></div></form>
          <details><summary>What is running?</summary><p>The same isolated WASM worker trained at the stove generates 48 new byte tokens. No external model downloads, no system prompt, and no canned replies. Download exports the trainer’s .tinygpt format for the Web Lab. Your existing saved Web Lab model is untouched. Changing ingredients does not silently retrain or replace this model.</p></details>
        </div>
        <a class="journey-next" href="/playground"><span>Explore a bigger recipe</span><strong>Open the browser trainer →</strong></a>
      </section>
      <section class="sources">
        <h2>Read the technical sources.</h2><p>
          The kitchen is a metaphor. These sources explain the mechanisms.
        </p><ul>
          <li>
            <a href="https://huggingface.co/learn/llm-course/chapter1/4"
              >Hugging Face: pre-training and fine-tuning</a
            >
          </li><li>
            <a href="https://arxiv.org/abs/2203.02155"
              >InstructGPT: demonstrations, preferences, and RLHF</a
            >
          </li><li>
            <a href="https://arxiv.org/abs/2305.18290"
              >Direct Preference Optimization</a
            >
          </li><li>
            <a href="/docs/learn/llm-kitchen"
              >Lesson notes and trainer integration contract</a
            >
          </li><li>
            <a href="/learn">Continue with the hands-on learning paths</a>
          </li>
        </ul>
      </section>
    </article>
  </main>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description,
      url: canonical,
    })}
  />
</Default>
<script>
  import "../../kitchen/article";
  import "../../kitchen/cooker";
  import "../../kitchen/motion.css";
  import "../../kitchen/welcome.css";
</script>
<style>
  .cook-article {
    max-width: 1320px;
    margin: auto;
    padding: 0 clamp(20px, 4vw, 60px) 100px;
  }
  .essay-head {
    text-align: center;
  }
  .edition {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--line-strong);
    padding: 30px 0;
    font: 11px var(--font-mono);
    color: var(--ink-70);
  }
  .edition a {
    color: var(--ink-70);
  }
  .eyebrow {
    font: 11px/1.6 var(--font-mono);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--live);
    margin-bottom: 14px;
  }
  .essay-head > .eyebrow {
    padding-top: 60px;
  }
  .essay-head h1 {
    font-family: var(--font-display);
    font-size: clamp(58px, 7.4vw, 104px);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: -5px;
    margin: 22px 0 28px;
  }
  .dek {
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.6;
    color: var(--ink-70);
    margin: auto;
