---
import Default from "../layouts/Default.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/system.css";
import pathRegistry from "../../../docs/learn/path-registry.json";
import artifactJourney from "../../../docs/learn/artifact-journey.json";
import recipeRegistry from "../../../docs/recipes/registry.json";

const REPO = "https://github.com/PostTrainLLM/posttrainllm";
const source = (path: string) => `${REPO}/blob/main/${path}`;

const fieldGuides = [
  { href: "/docs/cli-reference", label: "CLI lab reference" },
  { href: "/how-to-train-your-own-llm", label: "How to train your own LLM" },
  { href: "/fine-tune-llm-on-mac", label: "Fine-tune an LLM on a Mac" },
  { href: "/mlx-lora-fine-tuning", label: "MLX LoRA fine-tuning" },
  { href: "/docs/learn/competitive-landscape", label: "Competitive landscape" },
];

const learningPaths = pathRegistry.paths;
const docHref = (path: string) => `/${path.replace(/\.md$/, "")}`;
const evidenceHref = (path: string) => {
  if (/^https?:\/\//.test(path)) return path;
  return path.endsWith(".md") ? docHref(path) : source(path);
};
const artifactHref = (path: string) =>
  path.startsWith("/") ? path : evidenceHref(path);
const pathCards = learningPaths.map((path) => ({
  ...path,
  recipes: recipeRegistry.recipes.filter(
    (recipe) => recipe.learning_path === path.id,
  ),
}));
const readinessLegend = artifactJourney.readiness as Record<string, string>;
const artifactStages = artifactJourney.stages.map((stage) => ({
  ...stage,
  artifacts: stage.artifacts.map((artifact) => ({
    ...artifact,
    actions: [
      { name: "Build", ...artifact.build },
      { name: "Modify", ...artifact.modify },
      { name: "Tune", ...artifact.tune },
      { name: "Prove", ...artifact.evaluate },
      { name: "Package", ...artifact.package },
    ],
  })),
}));

const chapters = [
  {
    number: "01",
    id: "target",
    title: "Choose a target worth compressing.",
    question: "Can a narrow capability be specified tightly enough to measure?",
    body: "Start with the task, the incumbent, and a frozen success bar—not a model. A frontier model first proves the ruler can represent the capability at all.",
    emits: "target.json + frozen baseline",
    docs: [
      { label: "Factory contract", href: "/docs/factory/overview" },
      { label: "Method vs recipe", href: "/docs/techniques/method-vs-recipe" },
    ],
    code: [
      {
        label: "FactoryRunCommand.swift",
        href: source("native-mac/Sources/TinyGPT/FactoryRunCommand.swift"),
      },
      {
        label: "EvalGate.swift",
        href: source("native-mac/Sources/TinyGPT/EvalGate.swift"),
      },
    ],
  },
  {
    number: "02",
    id: "data",
    title: "Build data for the failure, not the benchmark name.",
    question:
      "Which decisions are missing, and where did each training row come from?",
    body: "Trace review turns misses into slices. Synthetic teachers are useful only when provenance, deduplication, contamination checks, and a held-out gate stay attached to the rows.",
    emits: "dataset + manifest + provenance",
    docs: [
      { label: "Dataset inventory", href: "/docs/dataset-inventory" },
      {
        label: "Distillation recipe",
        href: "/docs/recipes/distill-specialist",
      },
    ],
    code: [
      {
        label: "DatasetRegistry.swift",
        href: source("native-mac/Sources/TinyGPTData/DatasetRegistry.swift"),
      },
      {
        label: "SFTCorpus.swift",
        href: source("native-mac/Sources/TinyGPTModel/SFTCorpus.swift"),
      },
    ],
  },
  {
    number: "03",
    id: "post-train",
    title: "Change the smallest model that can plausibly close the gap.",
    question:
      "Does SFT, preference training, or rejection sampling improve the frozen target?",
    body: "The readable Swift + MLX path remains the local reference. Every intervention is a recipe with exact data, adapter, optimizer, steps, and composition—not just a technique name.",
    emits: "adapter + recipe + training trace",
    docs: [
      {
        label: "Post-training factory",
        href: "/docs/factory/post-training-factory",
      },
      {
        label: "Tool-calling case study",
        href: "/docs/learn/tool-calling-frontier-parity",
      },
    ],
    code: [
      {
        label: "SFT.swift",
        href: source("native-mac/Sources/TinyGPT/SFT.swift"),
      },
      {
        label: "FactoryRunLifecycle.swift",
        href: source("native-mac/Sources/TinyGPTIO/FactoryRunLifecycle.swift"),
      },
    ],
  },
  {
    number: "04",
    id: "evaluate",
    title: "Make the candidate earn the claim.",
    question:
      "Did capability rise on the frozen target without unacceptable regressions?",
    body: "The same evaluator scores baseline and candidate. Slice metrics, legality, raw outputs, latency, RAM, throughput, and uncertainty stay visible; a benchmark whose frontier ceiling fails is rejected.",
    emits: "metrics + traces + regression gate",
    docs: [
      { label: "Evaluation protocol", href: "/docs/factory/eval-protocol" },
      { label: "Benchmark archive", href: "/benchmarks" },
    ],
    code: [
      {
        label: "EvalCompare.swift",
        href: source("native-mac/Sources/TinyGPT/EvalCompare.swift"),
      },
      {
        label: "EvalBFCL.swift",
        href: source("native-mac/Sources/TinyGPT/EvalBFCL.swift"),
      },
    ],
  },
  {
    number: "05",
    id: "package",
    title: "Package the boundary, not just the weights.",
    question:
      "Where is this specialist allowed to answer, and when must it redirect?",
    body: "A specialist artifact includes identity, base model, adapter, prompt contract, eval evidence, resource measurements, and routing constraints. Narrow depth can ship only with an honest boundary.",
    emits: "validated specialist package",
    docs: [
      { label: "Packaging contract", href: "/docs/factory/packaging" },
      { label: "Public specialists", href: "/artifacts" },
    ],
    code: [
      {
        label: "FactoryRun.swift",
        href: source("native-mac/Sources/TinyGPTIO/FactoryRun.swift"),
      },
      {
        label: "FineTuneReportCard.swift",
        href: source("native-mac/Sources/TinyGPTIO/FineTuneReportCard.swift"),
      },
    ],
  },
  {
    number: "06",
    id: "report",
    title: "End every run with a decision.",
    question: "Should this candidate ship, retry, redirect, or be rejected?",
    body: "The report binds score delta to regressions, cost, latency, RAM, throughput, missing measurements, and source hashes. Failed attempts remain part of the system because they change what gets tried next.",
    emits: "report card + ship / retry / reject",
    docs: [
      { label: "Reporting contract", href: "/docs/factory/reports" },
      { label: "Attempt ledger", href: "/docs/attempt-ledger" },
    ],
    code: [
      {
        label: "build_fine_tune_report_card.py",
        href: source("scripts/factory/build_fine_tune_report_card.py"),
      },
      {
        label: "factory_run_lifecycle.py",
        href: source("scripts/factory/factory_run_lifecycle.py"),
      },
    ],
  },
];

const cases = [
  {
    state: "improved",
    tone: "live",
    title: "Tool calling: training helps a weak base",
    metric: "56 → 76 → 78",
    text: "The 1.7B arc moved from stock to SFT to GRPO. SFT did most of the work; GRPO added two points, then the approach plateaued below the stronger 4B.",
    href: "/docs/learn/tool-calling-frontier-parity",
    link: "Read the full arc",
  },
  {
    state: "routed",
    tone: "amber",
    title: "File ops: depth won, breadth regressed",
    metric: "58 → 100 / 59.6 → 42.3",
    text: "The distilled 4B aced the narrow hard gate while losing out-of-domain breadth. That is a routed specialist result, not a general model upgrade.",
    href: "/artifacts/qwen3-4b-file-ops-distilled",
    link: "Inspect the package",
  },
  {
    state: "rejected ruler",
    tone: "fail",
    title: "Character 2048: no intelligence gradient",
    metric: "1.058× best frontier ratio",
    text: "The strongest completed frontier attempt did not clear the frozen 1.10× bar over paired random legal play. Training was stopped and the replay was retained.",
    href: "/benchmarks/game-2048",
    link: "Watch the failed attempt",
  },
  {
    state: "candidate",
    tone: "amber",
    title: "Character Chess: promising, not frozen",
    metric: "65% frontier development score",
    text: "The first suite showed a real gradient, but the frontier did not approach the required ceiling. The expanded candidate pool remains for human review—not small-model grading.",
    href: "/benchmarks/chess",
    link: "Inspect candidate evidence",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "How the posttrainllm specialist factory works",
  description:
    "A source-linked walkthrough from target selection to data, post-training, evaluation, packaging, and an honest ship, retry, or reject report.",
  url: "https://posttrainllm.com/learn",
  isPartOf: { "@id": "https://posttrainllm.com/#app" },
  hasPart: chapters.map((chapter) => ({
    "@type": "TechArticle",
    position: Number(chapter.number),
    headline: chapter.title,
    url: `https://posttrainllm.com/learn#${chapter.id}`,
  })),
};
---

<Default
  title="Mac-local LLM specialist factory | PostTrainLLM"
  description="Follow the source-linked loop from target and data through post-training, evaluation, packaging, and an honest ship, retry, or reject report."
  ogType="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(structuredData)}
  />
  <SiteHeader mode="instrument" active="learn" />

  <main id="main">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <span aria-hidden="true"></span> The factory, end to end
        </p>
        <h1>Build the ruler.<br />Then build the model.</h1>
        <p class="lede">
          A small specialist earns its place one artifact at a time. This is the
          shortest path through the system—from choosing a capability to
          deciding whether the result should ship, redirect, retry, or stop.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="#artifact-journey">Start building</a>
          <a class="secondary-action" href="/docs">Open the complete docs</a>
        </div>
      </div>

      <ol class="loop" aria-label="Specialist factory loop">
        {
          chapters.map((chapter) => (
            <li>
              <a href={`#${chapter.id}`}>
                <span>{chapter.number}</span>
                {chapter.id.replace("post-train", "post-train")}
              </a>
            </li>
          ))
        }
      </ol>
    </header>

    <section
      class="field-guides wrap"
      style="padding:2rem 0;border-bottom:1px solid var(--line);"
    >
      <p class="mono-label" style="margin-bottom:0.75rem;">Field guides</p>
      <ul
        style="display:flex;flex-wrap:wrap;gap:1rem;list-style:none;padding:0;margin:0;"
      >
        {
          fieldGuides.map((g) => (
            <li>
              <a href={g.href}>{g.label} →</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="artifact-journey"
      id="artifact-journey"
      aria-labelledby="artifact-journey-title"
    >
      <header class="section-heading">
        <p class="section-index">nine stages / thirteen things you can make</p>
        <h2 id="artifact-journey-title">Learn by leaving artifacts behind.</h2>
        <p>
          Theory becomes useful when you can change a real system and prove what
          the change did. Each stage ends in something inspectable: a model,
          adapter, benchmark, agent, package, runtime decision, or causal probe.
        </p>
      </header>

      <div class="readiness-legend" aria-label="Artifact readiness legend">
        {
          Object.entries(readinessLegend).map(([status, meaning]) => (
            <div>
              <span>{status.replaceAll("-", " ")}</span>
              <p>{meaning}</p>
            </div>
          ))
        }
      </div>

      <nav class="artifact-map" aria-label="Buildable artifact journey stages">
        <ol>
          {
            artifactStages.map((stage) => (
              <li>
                <a href={`#artifact-stage-${stage.id}`}>
                  <span>{String(stage.order).padStart(2, "0")}</span>
                  {stage.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="artifact-stage-list">
        {
          artifactStages.map((stage) => (
            <article class="artifact-stage" id={`artifact-stage-${stage.id}`}>
              <header class="artifact-stage-heading">
                <p>{String(stage.order).padStart(2, "0")}</p>
                <div>
                  <p class="artifact-question">{stage.question}</p>
                  <h3>{stage.title}</h3>
                  <p>{stage.outcome}</p>
                  <a href={`#path-${stage.path_id}`}>
                    Open the learning path →
                  </a>
                </div>
              </header>

              <div class="journey-artifact-grid">
                {stage.artifacts.map((artifact) => (
                  <section class="journey-artifact">
                    <header>
                      <div>
                        <p class="artifact-kind">{artifact.kind}</p>
                        <h4>{artifact.title}</h4>
                      </div>
                      <span class={`readiness ${artifact.readiness}`}>
                        {artifact.readiness.replaceAll("-", " ")}
                      </span>
                    </header>
                    <p class="artifact-summary">{artifact.summary}</p>
                    <p class="artifact-workload">
                      <span>workload</span>
                      {artifact.workload}
                    </p>

                    <dl class="artifact-actions">
                      {artifact.actions.map((action) => (
                        <div>
                          <dt>{action.name}</dt>
                          <dd>
                            <a href={artifactHref(action.href)}>
                              {action.label} →
                            </a>
                          </dd>
                        </div>
                      ))}
                    </dl>

                    <div class="artifact-foot">
                      <div class="artifact-anchors">
                        <span>Inspect</span>
                        {artifact.anchors.map((anchor) => (
                          <a href={evidenceHref(anchor)} rel="noopener">
                            {anchor.split("/").at(-1)} ↗
                          </a>
                        ))}
                      </div>
                      {artifact.cli_commands.length > 0 && (
                        <div class="artifact-commands">
                          <span>Run</span>
                          {artifact.cli_commands.map((command) => (
                            <a href="/docs/cli-reference">
                              <code>{command}</code>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </section>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="learning-lab" aria-labelledby="learning-lab-title">
      <header class="section-heading">
        <p class="section-index">learning lab / nine ready paths</p>
        <h2 id="learning-lab-title">Learn it, inspect it, then run it.</h2>
        <p>
          Each path has prerequisites, a repository lab, and a mastery gate.
          Start with foundations; use the others when their prerequisites are
          earned.
        </p>
      </header>
      <div class="path-grid">
        {
          pathCards.map((path, index) => (
            <article class="path-card" id={`path-${path.id}`}>
              <div class="path-number">
                {String(index + 1).padStart(2, "0")}
              </div>
              <div>
                <p class="path-prereq">
                  {path.prerequisites.length
                    ? `after ${path.prerequisites.join(" + ")}`
                    : "start here"}
                </p>
                <h3>{path.title}</h3>
                <ol>
                  {path.sequence.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
                <dl>
                  <div>
                    <>
                      <dt>Lab</dt>
                      <dd>{path.lab}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Mastery gate</dt>
                      <dd>{path.mastery_gate}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>CLI entry points</dt>
                      <dd class="command-list">
                        {path.cli_commands.map((command) => (
                          <a href="/docs/cli-reference">
                            <code>{command}</code>
                          </a>
                        ))}
                      </dd>
                    </>
                  </div>
                </dl>
                <div class="path-actions">
                  <a href={docHref(path.anchors[0])}>Open the path →</a>
                  {path.recipes.map((recipe) => (
                    <a href={docHref(recipe.technique_path)}>
                      Recipe: {recipe.title} →
                    </a>
                  ))}
                  {path.recipes.length === 0 && (
                    <span>
                      Foundation prerequisite; applied recipes begin in later
                      paths.
                    </span>
                  )}
                </div>
                <details class="path-evidence">
                  <summary>{path.anchors.length} evidence anchors</summary>
                  <ul>
                    {path.anchors.map((anchor) => (
                      <li>
                        <a
                          href={evidenceHref(anchor)}
                          rel={anchor.endsWith(".md") ? undefined : "noopener"}
                        >
                          {anchor.replace(/^docs\//, "").replace(/\.md$/, "")}
                          {anchor.endsWith(".md") ? " →" : " ↗"}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="principle" aria-labelledby="principle-title">
      <p class="section-index">00 / admission rule</p>
      <div>
        <h2 id="principle-title">
          Frontier is the calibration anchor, not the opponent.
        </h2>
        <p>
          If a strong frontier model cannot nearly ace a benchmark, that
          benchmark cannot grade the Mac model. Fix or drop the ruler first. The
          objective is frontier capability retained per unit of model size, RAM,
          latency, and cost.
        </p>
      </div>
    </section>

    <section class="chapters" aria-labelledby="chapters-title">
      <header class="section-heading">
        <p class="section-index">01–06 / the retained lab loop</p>
        <h2 id="chapters-title">Six questions. Six durable artifacts.</h2>
        <p>
          The narrative is the index. The linked docs and code remain the source
          of truth.
        </p>
      </header>

      <div class="chapter-rail">
        {
          chapters.map((chapter) => (
            <article class="chapter" id={chapter.id}>
              <div class="chapter-number" aria-hidden="true">
                {chapter.number}
              </div>
              <div class="chapter-copy">
                <p class="chapter-question">{chapter.question}</p>
                <h3>{chapter.title}</h3>
                <p>{chapter.body}</p>
              </div>
              <div class="chapter-evidence">
                <p class="emits">
                  <span>emits</span>
                  {chapter.emits}
                </p>
                <div class="link-group">
                  <span>Read</span>
                  {chapter.docs.map((link) => (
                    <a href={link.href}>{link.label} →</a>
                  ))}
                </div>
                <div class="link-group">
                  <span>Source</span>
                  {chapter.code.map((link) => (
                    <a href={link.href} rel="noopener">
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="case-files" aria-labelledby="cases-title">
      <header class="section-heading">
        <p class="section-index">case files / decisions, not demos</p>
        <h2 id="cases-title">What the loop has actually taught us.</h2>
        <p>
          An improvement, a regression, and a failed ruler are all useful when
          they force a clear next decision.
        </p>
      </header>
      <div class="case-list">
        {
          cases.map((item) => (
            <article class:list={["case", item.tone]}>
              <div class="case-state">{item.state}</div>
              <div class="case-copy">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a href={item.href}>{item.link} →</a>
              </div>
              <p class="case-metric">{item.metric}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="source-index" aria-labelledby="source-title">
      <div class="source-intro">
        <p class="section-index">annotated source / where to begin</p>
        <h2 id="source-title">Read the system in the same order it runs.</h2>
        <p>
          Qwen Chess made its implementation approachable by naming the modules
          behind each lesson. These are the equivalent entrypoints here; the
          repository contains the complete implementation and history.
        </p>
      </div>
      <ol class="source-list">
        <li>
          <span>01</span><div>
            <a
              href={source(
                "native-mac/Sources/TinyGPT/FactoryRunCommand.swift",
              )}
              rel="noopener">FactoryRunCommand.swift ↗</a
            ><p>CLI composition and the top-level run boundary.</p>
          </div>
        </li>
        <li>
          <span>02</span><div>
            <a
              href={source(
                "native-mac/Sources/TinyGPTIO/FactoryRunLifecycle.swift",
              )}
              rel="noopener">FactoryRunLifecycle.swift ↗</a
            ><p>
              State transitions, locks, manifests, and durable run identity.
            </p>
          </div>
        </li>
        <li>
          <span>03</span><div>
            <a
              href={source("native-mac/Sources/TinyGPT/SFT.swift")}
              rel="noopener">SFT.swift ↗</a
            ><p>The readable Mac-local supervised fine-tuning path.</p>
          </div>
        </li>
        <li>
          <span>04</span><div>
            <a
              href={source("native-mac/Sources/TinyGPT/EvalCompare.swift")}
              rel="noopener">EvalCompare.swift ↗</a
            ><p>Baseline-versus-candidate comparison under one contract.</p>
          </div>
        </li>
        <li>
          <span>05</span><div>
            <a
              href={source("scripts/factory/build_fine_tune_report_card.py")}
              rel="noopener">build_fine_tune_report_card.py ↗</a
            ><p>
              Offline compiler from validated evidence to the public
              before/after report.
            </p>
          </div>
        </li>
        <li>
          <span>06</span><div>
            <a href="/docs/attempt-ledger">attempt-ledger.md →</a><p>
              The durable memory of shipped, retried, rejected, and incomplete
              attempts.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <footer class="next-step">
      <p class="section-index">continue</p>
      <h2>Inspect the proof, then reproduce it.</h2>
      <div>
        <a class="primary-action" href="/artifacts">Open the specialists</a>
        <a class="secondary-action" href="/benchmarks">Replay the benchmarks</a>
        <a class="secondary-action" href="/docs/learn/curriculum"
          >Study from first principles</a
        >
      </div>
    </footer>
  </main>
</Default>

<style is:global>
  :root {
    color-scheme: dark;
    --amber: #ffb454;
  }
  html {
    scroll-padding-top: 90px;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
  }
  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(64px, 9vw, 118px) 0 110px;
  }
  .eyebrow,
  .section-index,
  .chapter-question,
  .emits span,
  .link-group > span,
  .case-state {
    font: 600 12px/1.25 var(--font-mono);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: end;
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--live);
    margin-bottom: 24px;
  }
  .eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 18px rgba(72, 229, 194, 0.65);
  }
  .learning-lab {
    padding: clamp(72px, 10vw, 128px) 0;
  }
  .artifact-journey {
    padding: clamp(72px, 10vw, 128px) 0 0;
    scroll-margin-top: 90px;
  }
  .readiness-legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 32px;
