---
import EvidenceDossier from "../../../components/content/EvidenceDossier.astro";
import {
  learningPathRecords,
  type KnowledgeRecord,
} from "../../../data/knowledgeGraph";

export function getStaticPaths() {
  return learningPathRecords.map((record) => ({
    params: { id: record.id },
    props: { record },
  }));
}

const { record } = Astro.props as { record: KnowledgeRecord };
---

<EvidenceDossier
  record={record}
  backHref="/learn"
  backLabel="learning paths"
  active="learn"
/>
