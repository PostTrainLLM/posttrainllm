---
import Default from "../../layouts/Default.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/system.css";
import { learningCaseStudies, learningUnits } from "../../learning/content";
import { inferenceSessions } from "../../learning/inference-content";
import { inferenceWeeks } from "../../learning/inference-weeks";
import pathRegistry from "../../../../docs/learn/path-registry.json";
import artifactJourney from "../../../../docs/learn/artifact-journey.json";

const current = inferenceSessions[0];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: "PostTrainLLM learning workspace",
  description:
    "A self-contained course from model parameters to post-training and evaluation, with browser-local exercises and delayed recall.",
  educationalLevel: "Beginner to advanced",
  teaches: [...inferenceSessions, ...learningUnits].map((unit) => unit.title),
  isAccessibleForFree: true,
};
---

<Default
  title="Learn language models from first principles | PostTrainLLM"
  description="Learn parameters, gradients, tensors, transformers, post-training, and evaluation through public lessons, browser-local exercises, and delayed recall."
  ogType="article"
  telemetry={false}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <SiteHeader mode="instrument" active="learn" />

  <main id="main" data-learning-workspace data-ph-no-capture>
    <header class="session-hero wrap">
      <div>
        <p class="mono-label current-label">
          <span data-current-route>Loading saved session</span> · <span
            data-current-number>{current.number}</span
          >
        </p>
        <h1>Learn it here.<br />Prove it to yourself.</h1>
        <p class="session-lede">
          Read the lesson, work one exercise, explain it in your own words, and
          return for two short recall checks. AI chat is optional. Your answers
          stay in this browser.
        </p>
      </div>
      <aside class="session-state" aria-label="Learning status">
        <span data-module-position>Opening course…</span>
        <strong data-learning-status>reading</strong>
        <p data-save-status aria-live="polite">Opening browser storage…</p>
      </aside>
    </header>

    <nav class="session-steps wrap" aria-label="Session steps">
      <a href="#read"><span>1</span> Read</a>
      <a href="#try"><span>2</span> Try</a>
      <a href="#explain"><span>3</span> Explain</a>
      <a href="#review"><span>4</span> Review</a>
    </nav>

    <div class="route-alert wrap-narrow" data-route-alert hidden role="status">
    </div>
    <nav class="route-choices wrap" aria-label="Learning routes">
      <a
        href="/learn/session?route=inference-systems-13w"
        data-select-route="inference-systems-13w">Inference sprint</a
      >
      <a href="/learn/session?route=ground-up" data-select-route="ground-up"
        >Ground-up foundations</a
      >
      <a href="/docs/learn/inference-systems-13w/">13-week overview</a>
    </nav>

    <section
      class="diagnostic wrap-narrow"
      data-diagnostic-section
      hidden
      aria-labelledby="diagnostic-title"
    >
      <p class="mono-label">Day 1 · first attempt</p>
      <h2 id="diagnostic-title">What do you already know?</h2>
      <p data-current-diagnostic></p>
      <label for="diagnostic">Your initial answer</label>
      <textarea
        id="diagnostic"
        rows="5"
        autocomplete="off"
        placeholder="Calculate, label the axes, and note what is uncertain…"
      ></textarea>
      <details class="answer-guide" data-diagnostic-repair>
        <summary>See a worked repair after trying</summary>
        <p data-current-diagnostic-repair></p>
      </details>
    </section>

    <article class="lesson wrap-narrow" id="read" data-session-content hidden>
      <header>
        <p class="mono-label">
          <span data-current-number>{current.number}</span> / <span
            data-current-track>Inference sprint</span
          >
        </p>
        <h2 data-current-title>{current.title}</h2>
        <p data-current-summary>{current.summary}</p>
      </header>
      <div class="session-meta" data-session-meta></div>
      <div data-current-lesson>
        <p>Loading lesson…</p>
      </div>
      <div class="worked-example" data-current-worked-example>
        <p class="mono-label">Worked example</p>
        <p>
          Suppose <code>y = 2x + 1</code>. For <code>x = 3</code>, the
          prediction is <code>7</code>. The input <code>x</code> and observed target
          come from the example; <code>m = 2</code> and <code>b = 1</code> are parameters.
          Changing <code>b</code> shifts every prediction equally. Changing
          <code>m</code> changes how strongly the prediction responds to x.
        </p>
      </div>
      <a class="source-link" href={current.sourceHref} data-current-source
        ><span data-current-source-label>{current.sourceLabel}</span> →</a
      >
    </article>

    <section
      class="prediction wrap-narrow"
      data-prediction-section
      data-session-content
      hidden
      aria-labelledby="prediction-title"
    >
      <p class="mono-label">Predict before checking</p>
      <h2 id="prediction-title">Write your first attempt.</h2>
      <p data-current-prediction></p>
      <label for="prediction">Initial prediction</label>
      <textarea
        id="prediction"
        rows="5"
        autocomplete="off"
        placeholder="Your shapes and dependency prediction…"></textarea>
    </section>

    <section
      class="exercise wrap-narrow"
      id="try"
      aria-labelledby="exercise-title"
      data-session-content
      hidden
    >
      <p class="mono-label">Your exercise</p>
      <h2 id="exercise-title" data-current-exercise-title>{current.title}</h2>
      <div data-foundation-one-only>
        <div class="equation" aria-label="y equals m x plus b">y = mx + b</div>
        <p class="points">(0,1) · (1,3) · (2,5) · (3,7) · (4,9)</p>
      </div>
      <p data-current-exercise>{current.exercise}</p>
      <div class="starter-code" data-current-starter hidden></div>

      <label for="actual-work">Your work</label>
      <textarea
        id="actual-work"
        required
        aria-describedby="actual-work-error"
        rows="8"
        autocomplete="off"
        placeholder={current.workPlaceholder}></textarea>
      <p class="field-error" id="actual-work-error" hidden>
        Write your calculation or exercise response before recording the check.
      </p>

      <details class="answer-guide" data-foundation-answer hidden>
        <summary>Check the worked answer after trying</summary>
        <div>
          <p><code>m = 2</code> and <code>b = 1</code>.</p>
          <p>
            Predictions: x=0 → 1; x=1 → 3; x=2 → 5; x=3 → 7; x=4 → 9. The x
            values are inputs, the listed y values are targets, m and b are
            adjustable parameters, and the values produced by the equation are
            predictions.
          </p>
        </div>
      </details>
      <details class="answer-guide" data-inference-answer hidden>
        <summary>Check the answer after recording your attempt</summary>
        <div data-current-answer></div>
      </details>
      <div class="lesson-checks" data-current-checks hidden></div>
    </section>

    <section
      class="explanation wrap-narrow"
      id="explain"
      aria-labelledby="explain-title"
      data-session-content
      hidden
    >
      <p class="mono-label">Your explanation</p>
      <h2 id="explain-title">Explain the idea in your own words.</h2>
      <p data-current-explanation>{current.explanationPrompt}</p>
      <label for="explanation">Explanation</label>
      <textarea
        id="explanation"
        required
        aria-describedby="explanation-error"
        rows="7"
        autocomplete="off"
        placeholder="During fitting…"></textarea>
      <p class="field-error" id="explanation-error" hidden>
        Explain what your work means before recording the check.
      </p>
      <label for="repo-connection">Repository connection</label>
      <input
        id="repo-connection"
        autocomplete="off"
        placeholder="For example: a weight in model.py…"
      />
      <label for="open-questions">Errors or open questions</label>
      <textarea
        id="open-questions"
        rows="3"
        autocomplete="off"
        placeholder="Anything still unclear…"></textarea>
    </section>

    <section
      class="review wrap-narrow"
      id="review"
      aria-labelledby="review-title"
      data-session-content
      hidden
    >
      <p class="mono-label">Immediate self-review</p>
      <h2 id="review-title">Can you clear the gate?</h2>
      <p data-current-gate>{current.masteryGate}</p>
      <p class="self-review-note">
        This is self-assessed. Record what is true today; both delayed checks
        are still required before the module becomes verified.
      </p>
      <p class="repair-note" data-repair-guidance hidden></p>
      <div class="review-actions">
        <button
          class="btn btn-ghost"
          type="button"
          data-immediate-result="needs-repair">I need another pass</button
        >
        <button
          class="btn btn-primary"
          type="button"
          data-immediate-result="pass">Record immediate pass</button
        >
      </div>
      <div class="continue-panel" data-continue-panel hidden>
        <p>
          You have a saved checkpoint. Keep the delayed recalls scheduled and
          move on when ready.
        </p>
        <button class="btn btn-primary" type="button" data-continue-module>
          Continue to the next module
        </button>
      </div>
    </section>

    <section class="recalls wrap" aria-labelledby="recalls-title">
      <header class="section-heading-small">
        <p class="mono-label">Delayed recall</p>
        <h2 id="recalls-title">Return without rereading.</h2>
        <p>
          Due reviews unlock on their date. Write the answer before checking
          your notes.
        </p>
      </header>
      <div class="recall-grid" data-recall-region>
        <p class="empty-copy">Loading recall schedule…</p>
      </div>
    </section>

    <section class="history-and-backup wrap">
      <div>
        <header class="section-heading-small">
          <p class="mono-label">Evidence</p>
          <h2>Checkpoint history</h2>
        </header>
        <div data-history-region>
          <p class="empty-copy">Loading checkpoints…</p>
        </div>
      </div>
      <aside class="backup-panel">
        <p class="mono-label">Local backup</p>
        <h2>Carry your work with you.</h2>
        <p>
          Progress is stored only in this browser. Clearing site data removes
          it. Export a JSON backup to move it to another device or keep a copy.
        </p>
        <div class="backup-actions">
          <button type="button" class="btn btn-primary" data-export
            >Export backup</button
          >
          <label class="btn btn-ghost import-label" for="learning-import"
            >Choose backup</label
          >
          <input
            id="learning-import"
            type="file"
            accept="application/json,.json"
            hidden
          />
        </div>
        <div class="import-preview" data-import-preview hidden>
          <strong>Validated backup</strong>
          <p data-import-summary></p>
          <p>
            A safety backup of the current state downloads before either action.
          </p>
          <div class="review-actions">
            <button
              type="button"
              class="btn btn-ghost"
              data-import-mode="replace">Replace</button
            >
            <button
              type="button"
              class="btn btn-primary"
              data-import-mode="merge">Merge history</button
            >
          </div>
        </div>
      </aside>
    </section>

    <section class="sprint-browser wrap" aria-labelledby="sprint-browser-title">
      <header class="section-heading-small">
        <p class="mono-label">Inference systems · 28 Sep–27 Dec 2026</p>
        <h2 id="sprint-browser-title">The 13-week route</h2>
        <p>
          Week 1 has seven complete lessons. Weeks 2–13 have scoped contracts;
          their daily lessons are planned.
        </p>
      </header>
      <div class="sprint-days">
        {
          inferenceSessions.map((session) => (
            <article>
              <span class="mono-label">
                Week 1 · Day {session.day} · {session.minutes} min · ready
              </span>
              <h3>{session.title}</h3>
              <p>{session.objective}</p>
              <button
                class="btn btn-ghost"
                type="button"
                data-select-module={session.id}
              >
                Open this lesson
              </button>
            </article>
          ))
        }
      </div>
      <details class="planned-weeks">
        <summary>View Weeks 2–13 contracts · detailed lessons planned</summary>
        <div class="planned-week-grid">
          {
            inferenceWeeks.slice(1).map((week) => (
              <article>
                <p class="mono-label">
                  Week {week.week} · {week.dates} · planned
                </p>
                <h3>{week.title}</h3>
                <p>
                  <strong>Before this:</strong> {week.prerequisites}
                </p>
                <p>
                  <strong>Progression:</strong> {week.progression}
                </p>
                <p>
                  <strong>Weekend evidence:</strong> {week.artifact}
                </p>
                <p>
                  <strong>Pass criterion:</strong> {week.passCriterion}
                </p>
                <p>
                  <strong>Boundary:</strong> {week.boundary}
                </p>
              </article>
            ))
          }
        </div>
      </details>
    </section>

    <details class="course-browser wrap">
      <summary>
        <span class="mono-label">Public course · indexable</span>
        <h2 id="course-library-title">Browse the complete learning spine</h2>
        <small>10 modules · choose any module as your current session</small>
      </summary>
      <section class="course-library" aria-labelledby="course-library-title">
        <div class="module-list">
          {
            learningUnits.map((unit, index) => (
              <details class="module-row" open={index === 0} id={unit.id}>
                <summary>
                  <span>{unit.number}</span>
                  <div>
                    <>
                      <h3>{unit.title}</h3>
                      <small>{unit.summary}</small>
                    </>
                  </div>
                </summary>
                <div class="module-body">
                  {unit.lesson.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  <p>
                    <strong>Exercise:</strong> {unit.exercise}
                  </p>
                  <p>
                    <strong>Mastery gate:</strong> {unit.masteryGate}
                  </p>
                  <a href={unit.sourceHref}>{unit.sourceLabel} →</a>
                  <button
                    class="btn btn-ghost module-select"
                    type="button"
                    data-select-module={unit.id}
                  >
                    Make this the current session
                  </button>
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </details>

    <details class="course-browser wrap">
      <summary>
        <span class="mono-label">Applied reading</span>
        <h2 id="case-library-title">Open the industry case studies</h2>
        <small
          >{learningCaseStudies.length} cases · each turned into a practical exercise</small
        >
      </summary>
      <section class="case-library" aria-labelledby="case-library-title">
        <div class="case-grid">
          {
            learningCaseStudies.map((study) => (
              <article id={study.id}>
                <h3>{study.title}</h3>
                <p>{study.lesson}</p>
                <p>
                  <strong>Exercise:</strong> {study.exercise}
                </p>
                <a href={study.sourceHref}>{study.sourceLabel} →</a>
              </article>
            ))
          }
        </div>
      </section>
    </details>

    <footer class="library-footer wrap">
      <p>
        The wider library remains intact: {pathRegistry.paths.length} practical paths,{
          " "
        }
        {
          artifactJourney.stages.reduce(
            (count, stage) => count + stage.artifacts.length,
            0,
          )
        } buildable artifacts, retained recipes, and the experiment archive.
      </p>
      <div>
        <a class="btn btn-ghost" href="/learn">Browse all artifacts and paths</a
        >
        <a class="btn btn-ghost" href="/recipes">Open recipes</a>
        <a class="btn btn-ghost" href="/experiments">Open experiments</a>
      </div>
    </footer>
  </main>
  <script
    id="learning-units-data"
    type="application/json"
    set:html={JSON.stringify([...inferenceSessions, ...learningUnits])}
  />
  <script src="../../learning/workspace.ts"></script>
</Default>

<style is:global>
  body {
    background: var(--paper);
  }
  main {
    padding-bottom: 7rem;
  }
  [hidden] {
    display: none !important;
  }
  .route-alert {
    margin: 1.5rem auto;
    padding: 1rem;
    border-left: 2px solid var(--brand-bright);
    background: var(--paper-raised);
  }
  .route-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: -3rem auto 4rem;
    font-size: 0.9rem;
  }
  .route-choices a[aria-current="page"] {
    color: var(--live);
    border-bottom: 1px solid var(--live);
  }
  .session-meta {
    border-left: 2px solid var(--live);
    padding-left: 1rem;
    color: var(--ink-70);
    margin: 0 0 2rem;
  }
  .session-meta p + p {
    margin-top: 0.45rem;
  }
  .lesson-block + .lesson-block {
    margin-top: 2.25rem;
  }
  .lesson-block h3,
  .lesson-checks h3 {
    font: 600 var(--step-1) var(--font-display);
    margin: 1.4rem 0 0.7rem;
  }
  .lesson-block p + p,
  .lesson-block li + li {
    margin-top: 0.75rem;
  }
  .lesson-block p,
  .lesson-checks,
  .prediction > p {
    color: var(--ink-70);
    line-height: 1.65;
  }
  .lesson-block ul,
  .lesson-checks ul {
    padding-left: 1.4rem;
  }
  .starter-code,
  .lesson-block pre {
    max-width: 100%;
    overflow-x: auto;
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--paper-sunken);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    font: 0.82rem/1.55 var(--font-mono);
    white-space: pre;
  }
  .starter-code pre {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .prediction,
  .diagnostic {
    margin: 4rem auto 0;
    padding-inline: var(--gutter);
  }
  .prediction h2,
  .diagnostic h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: 0.75rem 0 1rem;
  }
  .lesson-checks {
    margin-top: 2rem;
  }
  .sprint-browser {
    margin-top: 8rem;
  }
  .sprint-days,
  .planned-week-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }
  .sprint-days article,
  .planned-week-grid article {
    background: var(--paper);
    padding: 1.5rem;
  }
  .sprint-days h3,
  .planned-week-grid h3 {
    margin: 0.6rem 0;
    font: 600 var(--step-1) var(--font-display);
  }
  .sprint-days p,
  .planned-week-grid p {
    color: var(--ink-70);
  }
  .sprint-days button {
    margin-top: 1rem;
  }
  .planned-weeks {
    margin-top: 2rem;
  }
  .planned-weeks summary {
    cursor: pointer;
    color: var(--live);
    margin-bottom: 1rem;
  }
  .session-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 4rem;
    padding-top: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }
  .current-label {
    color: var(--live);
    margin-bottom: 1.25rem;
  }
  .session-hero h1 {
    max-width: 800px;
    font-size: clamp(2.75rem, 5.5vw, 5rem);
  }
  .session-lede {
    max-width: 65ch;
    color: var(--ink-70);
    font-size: var(--step-1);
    margin-top: 1.75rem;
  }
  .session-state {
    border-top: 1px solid var(--line-strong);
    padding-top: 1rem;
  }
  .session-state span {
    color: var(--ink-55);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .session-state strong {
    display: block;
    color: var(--live);
    font: 600 1.4rem var(--font-display);
    margin: 0.35rem 0 1rem;
    text-transform: capitalize;
  }
  [data-save-status] {
    color: var(--ink-70);
    font-size: 0.82rem;
  }
  [data-save-status][data-kind="error"] {
    color: var(--brand-bright);
  }
  [data-save-status][data-kind="ok"] {
    color: var(--live);
  }
  .session-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 2.5rem;
    margin-bottom: 4rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .session-steps a {
    color: var(--ink-70);
    padding: 1rem 0;
    font-size: 0.88rem;
  }
  .session-steps span {
    color: var(--live);
    font-family: var(--font-mono);
    margin-right: 0.5rem;
  }
  .lesson,
  .exercise,
  .explanation,
  .review {
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .lesson header {
    margin-bottom: 2rem;
  }
  .lesson h2,
  .exercise h2,
  .explanation h2,
  .review h2 {
    font-size: clamp(2.2rem, 5vw, 4.3rem);
    margin: 0.75rem 0 1.25rem;
  }
  .lesson > p,
  .exercise > p,
  .explanation > p,
  .review > p {
    max-width: 68ch;
    color: var(--ink-70);
    margin-top: 1.2rem;
    font-size: 1.06rem;
  }
  .worked-example {
    margin: 2.5rem 0 1.5rem;
    padding: 1.5rem;
    background: var(--paper-raised);
    border-radius: var(--r-3);
  }
  .worked-example p:last-child {
    margin-top: 0.75rem;
  }
  .source-link {
    display: inline-block;
    margin-top: 1rem;
  }
  .exercise,
  .explanation,
  .review {
    margin-top: 7rem;
  }
  .equation {
    color: var(--live);
    font: 500 clamp(2.3rem, 7vw, 5rem) var(--font-mono);
    text-align: center;
    margin: 2.5rem 0 1rem;
  }
  .points {
    text-align: center;
    font-family: var(--font-mono);
  }
  label {
    display: block;
    color: var(--ink-70);
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  textarea,
  input {
    width: 100%;
    margin-top: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-2);
    background: var(--paper-sunken);
    color: var(--ink);
    font: inherit;
    resize: vertical;
  }
  textarea::placeholder,
  input::placeholder {
    color: var(--ink-55);
  }
  textarea[aria-invalid="true"],
  input[aria-invalid="true"] {
    border-color: var(--brand-bright);
  }
  .field-error {
    color: var(--brand-bright);
    font-size: 0.84rem;
    margin-top: 0.5rem;
  }
  .answer-guide {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }
  .answer-guide summary {
    color: var(--live);
    cursor: pointer;
  }
  .answer-guide div {
    padding: 1rem 0 0.25rem;
    color: var(--ink-70);
  }
  .answer-guide div p + p {
    margin-top: 0.8rem;
  }
  .self-review-note {
    border-left: 1px solid var(--brand);
