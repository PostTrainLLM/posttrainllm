---
/**
 * SiteHeader — the one nav chrome shared by every page. Self-contained
 * (scoped styles, no global-token dependency) so it drops onto any page —
 * bright "brand" pages or dark "instrument" tool pages — without cascade
 * conflicts. mode="instrument" renders the dark variant that matches the
 * Mac app; mode="brand" renders the light editorial variant.
 */
import Logo from "./Logo.astro";
export interface Props {
  mode?: "brand" | "instrument";
  active?: string;
}
const { mode = "instrument", active } = Astro.props;
const homeCurrent = Astro.url.pathname === "/";
const links = [
  { href: "/artifacts", label: "specialists", key: "specialists" },
  { href: "/experiments", label: "experiments", key: "experiments" },
  { href: "/recipes", label: "recipes", key: "recipes" },
  { href: "/learn", label: "learn", key: "learn" },
  { href: "/benchmarks", label: "benchmarks", key: "benchmarks" },
  { href: "/leaderboard", label: "evals", key: "evals" },
  { href: "/playground", label: "playground", key: "playground" },
  { href: "/docs/cli-reference", label: "cli", key: "cli" },
  { href: "/docs", label: "docs", key: "docs" },
  { href: "/changelog", label: "changelog", key: "changelog" },
];
---

<header class:list={["site-header", mode]} data-mode={mode} role="banner">
  <a class="sh-skip" href="#main">Skip to content</a>
  <a
    class="sh-brand"
    href="/"
    aria-label="posttrainllm home"
    aria-current={homeCurrent ? "page" : undefined}
  >
    <Logo size={26} />
    <span class="sh-name">posttrainllm</span>
  </a>
  <nav class="sh-nav" aria-label="Primary">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[{ current: active === l.key }]}
          aria-current={active === l.key ? "page" : undefined}
        >
          {l.label}
        </a>
      ))
    }
    <a href="https://github.com/PostTrainLLM/posttrainllm" rel="noopener"
      >github ↗</a
    >
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>(".sh-nav");
  const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (nav && current && nav.scrollWidth > nav.clientWidth) {
    nav.scrollLeft = Math.max(
      0,
      current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2,
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px clamp(20px, 5vw, 72px);
    font-family:
      "Geist Variable",
      ui-sans-serif,
      system-ui,
      -apple-system,
      sans-serif;
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header.brand {
    background: color-mix(in oklab, #f5f6f8 82%, transparent);
    border-bottom: 1px solid #e3e6ec;
    --sh-fg: #15171e;
    --sh-soft: #3b404b;
    --sh-accent: #8a2a22;
    --logo-bg: #8a2a22;
    --logo-accent: #fff;
  }
  .site-header.instrument {
    background: color-mix(in oklab, #0b0d11 78%, transparent);
    border-bottom: 1px solid #23272f;
    --sh-fg: #eceef2;
    --sh-soft: #b3b9c4;
    --sh-accent: #48e5c2;
    --logo-bg: #0d0e10;
    --logo-accent: #48e5c2;
  }
  .sh-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--sh-fg);
    text-decoration: none;
  }
  .sh-skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 500;
    padding: 8px 14px;
    border-radius: 5px;
    background: #48e5c2;
    color: #06110e;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 0.18s ease;
  }
  .sh-skip:focus {
    transform: translateY(0);
  }
  .sh-name {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .sh-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .sh-nav a {
    font-size: 0.82rem;
    color: var(--sh-soft);
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color 0.14s ease;
  }
  .sh-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 1.5px;
    background: var(--sh-accent);
    transition: right 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sh-nav a:hover,
  .sh-nav a.current {
    color: var(--sh-fg);
  }
  .sh-nav a:hover::after,
  .sh-nav a.current::after {
    right: 0;
  }
  .sh-brand:focus-visible,
  .sh-nav a:focus-visible {
    outline: 2px solid var(--sh-accent);
    outline-offset: 4px;
    border-radius: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-skip,
    .sh-nav a,
    .sh-nav a::after {
      transition-duration: 0.001ms;
    }
  }
  @media (max-width: 1180px) {
    .site-header {
      flex-wrap: wrap;
      gap: 8px 18px;
      padding-block: 11px 8px;
    }
    .sh-nav {
      order: 2;
      display: flex;
      width: 100%;
      gap: 18px;
      overflow-x: auto;
      padding-block: 2px 5px;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
    }
    .sh-nav::-webkit-scrollbar {
      display: none;
    }
    .sh-nav a {
      flex: 0 0 auto;
    }
  }
</style>
