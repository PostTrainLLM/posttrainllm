---
/**
 * SiteHeader — the one nav chrome shared by every page. Self-contained
 * (scoped styles, no global-token dependency) so it drops onto any page —
 * bright "brand" pages or dark "instrument" tool pages — without cascade
 * conflicts. mode="instrument" renders the dark variant that matches the
 * Mac app; mode="brand" renders the light editorial variant.
 */
import Logo from "./Logo.astro";
export interface Props {
  mode?: "brand" | "instrument";
  /**
   * Key of the nav section this page belongs to. Omit it and the header falls
   * back to matching the current pathname. Pass "none" for a page that belongs
   * to no section and is served under arbitrary paths — the 404 page — because
   * it matches no key and so also switches the pathname fallback off, keeping
   * a 404 at /artifacts/nope from lighting up "Artifacts".
   */
  active?: string;
}
const { mode = "instrument", active } = Astro.props;
const homeCurrent = Astro.url.pathname === "/";
const primaryLinks = [
  { href: "/docs/quickstart", label: "Factory", key: "factory" },
  { href: "/playground", label: "Web Lab", key: "playground", mobile: true },
  { href: "/artifacts", label: "Artifacts", key: "specialists" },
  { href: "/experiments", label: "Experiments", key: "experiments" },
  { href: "/learn", label: "Learn", key: "learn" },
  { href: "/download", label: "Mac app", key: "download" },
];
const menuGroups = [
  {
    label: "Build",
    links: [
      { href: "/docs/quickstart", label: "Native factory", key: "factory" },
      { href: "/playground", label: "Browser training", key: "playground" },
      { href: "/inference", label: "Browser inference", key: "inference" },
      { href: "/webgpu-test", label: "WebGPU kernel tests", key: "webgpu" },
      { href: "/download", label: "Verified Mac app", key: "download" },
    ],
  },
  {
    label: "Measure",
    links: [
      { href: "/artifacts", label: "Evidence artifacts", key: "specialists" },
      { href: "/experiments", label: "Experiment ledger", key: "experiments" },
      { href: "/benchmarks", label: "Benchmarks", key: "benchmarks" },
      { href: "/leaderboard", label: "Eval leaderboard", key: "evals" },
    ],
  },
  {
    label: "Understand",
    links: [
      { href: "/learn", label: "Learning paths", key: "learn" },
      { href: "/recipes", label: "Reproducible recipes", key: "recipes" },
      { href: "/docs/cli-reference", label: "CLI reference", key: "cli" },
      { href: "/docs", label: "Documentation", key: "docs" },
      { href: "/changelog", label: "Changelog", key: "changelog" },
    ],
  },
] as const;

const isCurrent = (key: string, href: string) =>
  active === key ||
  (!active &&
    (Astro.url.pathname === href ||
      (href !== "/" && Astro.url.pathname.startsWith(`${href}/`))));
---

<header class:list={["site-header", mode]} data-mode={mode} role="banner">
  <a class="sh-skip" href="#main">Skip to content</a>
  <a
    class="sh-brand"
    href="/"
    aria-label="posttrainllm home"
    aria-current={homeCurrent ? "page" : undefined}
  >
    <Logo size={26} />
    <span class="sh-name">posttrainllm</span>
  </a>
  <div class="sh-actions">
    <nav class="sh-nav" aria-label="Primary">
      {
        primaryLinks.map((link) => {
          const current = isCurrent(link.key, link.href);
          return (
            <a
              href={link.href}
              data-mobile={link.mobile ? "true" : undefined}
              class:list={[{ current }]}
              aria-current={current ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
    <details class="sh-menu">
      <summary>
        <span class="wide-label">More</span>
        <span class="narrow-label">Explore</span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <div class="sh-panel">
        {
          menuGroups.map((group) => (
            <section aria-label={group.label}>
              <p>{group.label}</p>
              {group.links.map((link) => {
                const current = isCurrent(link.key, link.href);
                return (
                  <a
                    href={link.href}
                    class:list={[{ current }]}
                    aria-current={current ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                );
              })}
            </section>
          ))
        }
        <div class="sh-panel-source">
          <a href="/llms.txt">Agent index</a>
          <a href="https://github.com/PostTrainLLM/posttrainllm" rel="noopener">
            Source on GitHub ↗
          </a>
        </div>
      </div>
    </details>
    <a
      class="sh-github"
      href="https://github.com/PostTrainLLM/posttrainllm"
      rel="noopener">GitHub ↗</a
    >
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px clamp(20px, 5vw, 72px);
    font-family:
      "Geist Variable",
      ui-sans-serif,
      system-ui,
      -apple-system,
      sans-serif;
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header.brand {
    background: color-mix(in oklab, #f5f6f8 82%, transparent);
    border-bottom: 1px solid #e3e6ec;
    --sh-fg: #15171e;
    --sh-soft: #3b404b;
    --sh-accent: #8a2a22;
    --logo-bg: #8a2a22;
    --logo-accent: #fff;
  }
  .site-header.instrument {
    background: color-mix(in oklab, #0b0d11 78%, transparent);
    border-bottom: 1px solid #23272f;
    --sh-fg: #eceef2;
    --sh-soft: #b3b9c4;
    --sh-accent: #48e5c2;
    --logo-bg: #0d0e10;
    --logo-accent: #48e5c2;
  }
  .sh-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--sh-fg);
    text-decoration: none;
  }
  .sh-skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 500;
    padding: 8px 14px;
    border-radius: 5px;
    background: #48e5c2;
    color: #06110e;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 0.18s ease;
  }
  .sh-skip:focus {
    transform: translateY(0);
  }
  .sh-name {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .sh-actions {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .sh-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 24px);
  }
  .sh-nav a,
  .sh-github,
  .sh-menu summary {
    font-size: 0.82rem;
    color: var(--sh-soft);
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color 0.14s ease;
  }
  .sh-nav a::after,
  .sh-github::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 1.5px;
    background: var(--sh-accent);
    transition: right 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sh-nav a:hover,
  .sh-nav a.current,
  .sh-github:hover,
  .sh-menu summary:hover,
  .sh-menu[open] summary {
    color: var(--sh-fg);
  }
  .sh-nav a:hover::after,
  .sh-nav a.current::after,
  .sh-github:hover::after {
    right: 0;
  }
  .sh-menu {
    position: relative;
  }
  .sh-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    list-style: none;
  }
  .sh-menu summary::-webkit-details-marker {
    display: none;
  }
  .narrow-label {
    display: none;
  }
  .sh-panel {
    position: absolute;
    top: calc(100% + 16px);
    right: -78px;
    width: min(620px, calc(100vw - 40px));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 30px;
    padding: 26px;
    border: 1px solid #2a3039;
    border-radius: 14px;
    background: color-mix(in oklab, #111419 96%, transparent);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(18px);
  }
  .sh-panel section {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .sh-panel p {
    margin: 0 0 3px;
    color: var(--sh-accent);
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sh-panel a {
    color: var(--sh-soft);
    font-size: 0.84rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .sh-panel a:hover,
  .sh-panel a.current {
    color: var(--sh-fg);
  }
  .sh-panel-source {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 16px;
    border-top: 1px solid #2a3039;
  }
  .sh-brand:focus-visible,
  .sh-nav a:focus-visible,
  .sh-github:focus-visible,
  .sh-menu summary:focus-visible,
  .sh-panel a:focus-visible {
    outline: 2px solid var(--sh-accent);
    outline-offset: 4px;
    border-radius: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-skip,
    .sh-nav a,
    .sh-nav a::after {
      transition-duration: 0.001ms;
    }
  }
  @media (max-width: 1040px) {
    .site-header {
      gap: 14px;
      padding-block: 11px;
    }
    .sh-nav {
      gap: 16px;
    }
    .sh-nav a:not([data-mobile="true"]),
    .sh-github {
      display: none;
    }
    .wide-label {
      display: none;
    }
    .narrow-label {
      display: inline;
    }
    .sh-panel {
      right: 0;
    }
  }
  @media (max-width: 620px) {
    .site-header {
      padding-inline: 18px;
    }
    .sh-actions {
      gap: 15px;
    }
    .sh-name {
      font-size: 13px;
    }
    .sh-nav a,
    .sh-menu summary {
      font-size: 0.78rem;
    }
    .sh-panel {
      position: fixed;
      top: 58px;
      right: 14px;
      width: calc(100vw - 28px);
      max-height: calc(100vh - 78px);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow-y: auto;
    }
    .sh-panel-source {
      flex-direction: column;
      gap: 9px;
    }
  }
  @media (max-width: 380px) {
    .sh-nav {
      display: none;
    }
    .sh-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
