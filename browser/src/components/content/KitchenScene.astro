            <path d="M386 174q10-26 25-2m11 0q13-29 28-3" stroke="#809f8c" />
          </>
          <path d="M70 45h63m-32-11v23m342-19h37m-18-10v19" stroke="#41494e" />
        </>
      )
    }
    {
      kind === "chop" && (
        <>
          <>
            <path d="M56 186h448M112 100l250-36 95 73-260 50Z" fill="#171b22" />
