---
// Original scene illustrations for the owner-selected garden-to-table journey.
// Explanations are rendered as text beside each decorative scene.
interface Props {
  kind: "harvest" | "chop" | "clean" | "cook" | "serve";
}
const { kind } = Astro.props;
---

