          <>
            <path d="M228 87v57q65 38 130 0V87" fill="#171b22" />
            <ellipse cx="293" cy="87" rx="65" ry="22" fill="#b7a087" />
            <path d="M249 85q21-12 42 0m8 3 33-9" stroke="#eaedf2" />
