            d="M121 136v-51m0 18q-34-3-34-29 27 0 34 29m0-1q33-1 35-29-27 0-35 29"
            stroke="#809f8c"
          />
          <>
            <path
              d="M234 124V63m0 30q-31-3-31-26 25-1 31 26m0-2q31 0 34-25-25-1-34 25"
              stroke="#809f8c"
            />
            <circle
              class="harvest-produce"
              cx="215"
              cy="101"
              r="12"
              fill="#b7a087"
            />
