  data-scene={kind}
  class="kitchen-scene"
  viewBox="0 0 560 240"
  aria-hidden="true"
>
  <g
    fill="none"
    stroke="#a6adb9"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      kind === "harvest" && (
        <>
          <>
            <path d="M42 139l249-52 207 63-256 55Z" fill="#171b22" />
            <path d="M42 139v17l200 65 256-55v-16M242 205v16" />
