---
/**
 * Default.astro — shared shell for every page.
 *
 * Centralizes the bits that genuinely repeat across all five routes:
 *   - <!doctype>, <html lang>, charset, viewport
 *   - favicon, theme-color
 *   - Geist + Geist Mono fonts (self-hosted via @fontsource-variable)
 *   - OG/Twitter meta with sensible defaults overridable per page
 *
 * Page-specific styles still live inside each page's own <style is:global>
 * block — the CSS-variable palette varies between the playground (--base
 * #08090a) and the devlog/speedup pages (--bg #0a0c10), and the cascade
 * relies on global selectors that Astro's per-component scoping would
 * break. Keeping styles on the page preserves the existing visual design
 * with zero refactor risk.
 *
 * Fonts are now self-hosted via @fontsource-variable to drop the
 * fonts.googleapis.com CSS chain from the LCP path. The woff2 files ship
 * from the same origin as the HTML, so no preconnect/preload of an
 * external CDN is required. Browsers only fetch the woff2 when CSS
 * actually references the family — so the loadFonts prop is preserved
 * for API compat but is effectively a no-op for self-hosted fonts
 * (pages that don't reference "Geist Variable" in CSS won't pull the
 * file).
 */
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/bricolage-grotesque";

export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  ogUrl?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  themeColor?: string;
  /**
   * Retained for API compat with existing pages (training-dashboard,
   * speedup, devlog, webgpu-test pass false). Now a no-op: self-hosted
   * woff2 files are only fetched if CSS actually references the family,
   * so opting out happens implicitly via not using the font in styles.
   */
  loadFonts?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogType = "website",
  ogUrl,
  twitterTitle,
  twitterDescription,
  themeColor = "#0a0c0f",
  loadFonts: _loadFonts = true,
} = Astro.props;

const ORIGIN = "https://posttrainllm.com";
/** Extensionless, stable canonical (never …/page.html which 308s). */
function normalizeCanonicalPath(pathname: string): string {
  let p = pathname || "/";
  p = p.replace(/\/index\.html?$/i, "/");
  p = p.replace(/\.html?$/i, "");
  if (!p.startsWith("/")) p = `/${p}`;
  // collapse trailing slash except root
  if (p.length > 1 && p.endsWith("/")) p = p.slice(0, -1);
  return p || "/";
}
const canonical = new URL(normalizeCanonicalPath(Astro.url.pathname), ORIGIN)
  .href;

// Clamp meta description to 70–160 chars for SEO best practice.
const DEFAULT_DESC =
  "Mac-local LLM specialist factory — post-training and runtime that fits on one Mac, plus WebGPU playground.";
function clampDescription(
  desc: string,
  fallback: string = DEFAULT_DESC,
): string {
  let d = (desc ?? "").trim();
  if (d.length === 0) return fallback;
  if (d.length > 160) {
    d = d
      .slice(0, 157)
      .replace(/\s+\S*$/, "")
      .trim();
    if (d.length > 0) d += "…";
    return d;
  }
  if (d.length < 70) {
    const f = fallback.trim();
    if (f.length >= 70 && f.length <= 160) return f;
    if (d.length > 0 && f.length > 0) {
      const combined = `${d}. ${f}`;
      if (combined.length <= 160) return combined;
      return (
        combined
          .slice(0, 157)
          .replace(/\s+\S*$/, "")
          .trim() + "…"
      );
    }
    return f || d;
  }
  return d;
}
const clampedDescription = clampDescription(description);
const clampedOgDescription = clampDescription(ogDescription ?? description);
const clampedTwitterDescription = clampDescription(
  twitterDescription ?? ogDescription ?? description,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={clampedDescription} />
    <title>{title}</title>

    <!-- Canonical + robots -->
    <link rel="canonical" href={ogUrl ?? canonical} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <meta name="author" content="Sarthak Agrawal" />
    <meta
      name="keywords"
      content="LLM factory, Mac LLM, Apple Silicon LLM, MLX, LoRA, DoRA, QLoRA, distillation, BFCL, model evaluation, SAE interpretability, on-device AI, posttrainllm, WebGPU training"
    />

    <!-- Open Graph / Twitter card -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PostTrainLLM" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={ogUrl ?? canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={clampedOgDescription} />
    <meta property="og:image" content={`${ORIGIN}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="PostTrainLLM — a Mac-local LLM specialist factory"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle ?? ogTitle ?? title} />
    <meta name="twitter:description" content={clampedTwitterDescription} />
    <meta name="twitter:image" content={`${ORIGIN}/og-image.png`} />

    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="PostTrainLLM — Devlog"
      href="/devlog/rss.xml"
    />

    <!-- Preload the gallery manifest so the demo banner doesn't pop in
         late on a cold load (was waiting for the JS bundle to evaluate
         before kicking off the fetch). 2 KB JSON, tiny win, big perceived
         smoothness improvement on first paint. -->
    <link
      rel="preload"
      href="/gallery/manifest.json"
      as="fetch"
      crossorigin="anonymous"
    />

    <slot name="head" />

    <!-- Pre-paint layout-shift guard. Reads localStorage SYNCHRONOUSLY before
         the body parses, and adds classes on <html> that CSS uses to hide
         elements in their resting state. Without this, hidden-by-default
         elements (intro card, demo banner) would flash visible after JS ran
         and shove content below them around on every page load. -->
    <script is:inline>
      (function () {
        try {
          const html = document.documentElement;
          if (localStorage.getItem("posttrainllm.introDismissed") === "1") {
            html.classList.add("intro-dismissed");
          }
        } catch (_) {
          /* private mode / disabled storage — accept the one-time shift */
        }
      })();
    </script>
    <!-- fleet-jsonld:start (generated by apply-agent-surfaces; edit registry, not this) -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://sarthakagrawal.dev/#person",
            "name": "Sarthak Agrawal",
            "jobTitle": "AI Infrastructure & Product Engineer",
            "url": "https://sarthakagrawal.dev",
            "image": "https://avatars.githubusercontent.com/u/43884471?v=4",
            "sameAs": [
              "https://sarthakagrawal.dev",
              "https://www.linkedin.com/in/sarthakagrawal927",
              "https://github.com/sarthakagrawal927",
              "https://x.com/sarthakcodes",
              "https://huggingface.co/sarthakagrawal927"
            ],
            "knowsAbout": [
              "AI infrastructure",
              "Local-first software",
              "Post-training language models",
              "AI code review",
              "Cloudflare Workers",
              "TypeScript",
              "Rust"
            ],
            "affiliation": {
              "@type": "Organization",
              "@id": "https://sassmaker.com/#app",
              "name": "SaaS Maker",
              "url": "https://sassmaker.com"
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://posttrainllm.com/#app",
            "name": "PostTrainLLM",
            "alternateName": ["Post Train LLM", "posttrainllm.com"],
            "url": "https://posttrainllm.com",
            "description": "Mac-local LLM specialist factory — post-training and runtime that fits on one Mac, plus WebGPU playground.",
            "publisher": { "@id": "https://sarthakagrawal.dev/#person" },
            "sameAs": ["https://github.com/PostTrainLLM/posttrainllm"]
          }
        ]
      }
    </script>
    <!-- fleet-jsonld:end -->
  </head>
  <body>
    <slot />
    <script>
      import { initVitals } from "../lib/vitals";
      import { initApiTiming } from "../lib/api-timing";
      initVitals();
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(() => initApiTiming(), { timeout: 5_000 });
      } else {
        window.setTimeout(() => initApiTiming(), 1_000);
      }
    </script>
  </body>
</html>
