---
/**
 * DocLayout.astro — shared shell for rendered markdown docs (/docs/*).
 *
 * Bright editorial "lab" theme, matching the homepage. The source markdown
 * lives in `posttrainllm/docs/` (GitHub renders the same content); these pages
 * import + render it via Astro's markdown handling. Restyling this one file
 * themes every doc page cohesively.
 */
import Default from "./Default.astro";
import Logo from "../components/Logo.astro";
import "../styles/system.css";

export interface Props {
  title: string;
  description: string;
  sourcePath: string; // e.g. "docs/archive/lessons.md" — shown + linked to GitHub
}

const { title, description, sourcePath } = Astro.props;
const githubUrl = `https://github.com/PostTrainLLM/posttrainllm/blob/main/${sourcePath}`;

const layoutProps = {
  title: `posttrainllm — ${title}`,
  description,
  ogType: "article" as const,
  ogTitle: `posttrainllm — ${title}`,
  ogDescription: description,
  themeColor: "#0a0c0f",
};
---

<Default {...layoutProps}>
  <a class="skip-link" href="#doc">Skip to content</a>

  <header class="topbar" role="banner">
    <a class="brand-lockup" href="/" aria-label="posttrainllm home">
      <Logo size={26} />
      <span class="brand-name">posttrainllm</span>
    </a>
    <nav class="topnav" aria-label="Primary">
      <a href="/artifacts">specialists</a>
      <a href="/docs/attempt-ledger">experiments</a>
      <a href="/docs/learn/curriculum">learn</a>
      <a href="/leaderboard">evals</a>
      <a href="/playground">playground</a>
      <a href="https://github.com/PostTrainLLM/posttrainllm" rel="noopener">github ↗</a>
    </nav>
  </header>

  <div class="doc-wrap" id="doc">
    <nav class="doc-crumb" aria-label="Breadcrumb">
      <a href="/docs">docs</a><span class="sep">/</span><span class="here">{title}</span>
    </nav>
    <p class="doc-source mono-label">
      source <code>{sourcePath}</code> · <a href={githubUrl} target="_blank" rel="noopener">view on GitHub ↗</a>
    </p>
    <article class="prose">
      <slot />
    </article>
    <footer class="doc-foot">
      <a href="/docs">← all docs</a>
      <a href={githubUrl} target="_blank" rel="noopener">edit on GitHub ↗</a>
    </footer>
  </div>
</Default>

<style is:global>
  .doc-wrap { max-width: 74ch; margin-inline: auto; padding: clamp(40px, 6vw, 72px) var(--gutter) var(--s-10); }
  .doc-crumb { font-family: var(--font-mono); font-size: var(--step--1); color: var(--fg-quiet); margin-bottom: var(--s-2); }
  .doc-crumb a { color: var(--fg-soft); }
  .doc-crumb a:hover { color: var(--brand); }
  .doc-crumb .sep { margin: 0 8px; color: var(--line-strong); }
  .doc-crumb .here { color: var(--fg); }
  .doc-source { margin-bottom: var(--s-7); }
  .doc-source code { background: var(--sunken); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; color: var(--fg-soft); }
  .doc-source a { color: var(--brand); }

  /* ---------- prose ---------- */
  .prose { color: var(--fg-soft); font-size: 1.02rem; line-height: 1.72; }
  .prose > * + * { margin-top: var(--s-4); }
  .prose h1 { font-family: var(--font-display); font-size: var(--step-4); font-weight: 640; letter-spacing: -0.035em; color: var(--ink); line-height: 1.08; margin-bottom: var(--s-5); }
  .prose h2 { font-family: var(--font-display); font-size: var(--step-2); font-weight: 620; letter-spacing: -0.02em; color: var(--ink); margin-top: var(--s-8); margin-bottom: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .prose h2:first-of-type { border-top: 0; padding-top: 0; margin-top: var(--s-6); }
  .prose h3 { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; color: var(--ink); margin-top: var(--s-6); margin-bottom: var(--s-2); }
  .prose h4 { font-family: var(--font-mono); font-size: var(--step-0); font-weight: 500; color: var(--fg); margin-top: var(--s-5); margin-bottom: var(--s-2); }
  .prose p { color: var(--fg-soft); }
  .prose strong { color: var(--ink); font-weight: 620; }
  .prose em { color: var(--fg); font-style: italic; }
  .prose a { color: var(--brand); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--brand) 32%, transparent); text-underline-offset: 2px; transition: text-decoration-color var(--dur-1) var(--ease-out); }
  .prose a:hover { text-decoration-color: var(--brand); }

  .prose code { font-family: var(--font-mono); font-size: 0.86em; background: var(--sunken); border: 1px solid var(--line); padding: 1px 6px; border-radius: 5px; color: var(--live); }
  /* code blocks: dark "instrument" inset — the signature lab contrast */
  .prose pre { background: #0d1014; border: 1px solid #1e222b; border-radius: var(--r-2); padding: var(--s-4) var(--s-5); overflow-x: auto; margin-top: var(--s-5); margin-bottom: var(--s-5); font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.7; box-shadow: var(--shadow-2); }
  .prose pre code { background: none; border: 0; padding: 0; border-radius: 0; color: #cfd3db; font-size: inherit; }

  .prose ul, .prose ol { color: var(--fg-soft); padding-left: 1.4em; }
  .prose li { margin-bottom: 5px; }
  .prose li::marker { color: var(--live); }
  .prose ul > li::marker { color: var(--brand); }

  .prose blockquote { margin-top: var(--s-5); margin-bottom: var(--s-5); padding: var(--s-4) var(--s-5); background: var(--accent-wash); border: 1px solid color-mix(in oklab, var(--brand) 18%, var(--line)); border-radius: var(--r-2); color: var(--fg); }
  .prose blockquote p { margin: 0; }
  .prose blockquote p + p { margin-top: var(--s-2); }

  .prose table { width: 100%; border-collapse: collapse; margin-top: var(--s-5); margin-bottom: var(--s-5); font-size: 0.92rem; display: block; overflow-x: auto; }
  .prose th, .prose td { border-bottom: 1px solid var(--line); padding: 9px 14px; text-align: left; }
  .prose thead th { color: var(--ink); font-weight: 600; border-bottom: 2px solid var(--ink); white-space: nowrap; }
  .prose td { color: var(--fg-soft); font-variant-numeric: tabular-nums; }
  .prose tbody tr:hover { background: var(--sunken); }

  .prose hr { border: 0; border-top: 1px solid var(--line); margin-top: var(--s-7); margin-bottom: var(--s-7); }
  .prose img { border-radius: var(--r-2); border: 1px solid var(--line); margin-top: var(--s-5); margin-bottom: var(--s-5); }

  .doc-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-9); padding-top: var(--s-5); border-top: 1px solid var(--line); font-family: var(--font-mono); font-size: var(--step--1); }
  .doc-foot a { color: var(--brand); }
</style>
