{
  "schema_version": 1,
  "threshold_id": "mac-local-autocorrect-thresholds-v1",
  "quality": {
    "natural_error_reduction_rate_min": 0.9,
    "candidate_minus_frontier_error_reduction_ci95_lower_min": -0.02,
    "candidate_minus_local_incumbent_error_reduction_min": 0.05,
    "exact_match_reported": true,
    "residual_character_error_rate_reported": true
  },
  "regression": {
