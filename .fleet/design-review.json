{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "posttrainllm",
  "target": "OffHours standalone benchmark report",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
