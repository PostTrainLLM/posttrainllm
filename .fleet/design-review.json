    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": [
        "Pre-fix advisory: undocumented amber halo; resolved with the documented secondary and raised tokens.",
        "Pre-fix advisory: 7px radius outside the design scale; resolved with the documented 9px radius. Detector was not rerun under the single-pass rule."
      ]
    }
  },
  "ownerFeedback": {
    "decision": "keep",
    "note": "Owner approved the professional-grade OffHours artifact on 2026-08-20."
