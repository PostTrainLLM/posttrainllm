{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "posttrainllm",
  "target": "/playground explanatory controls",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PROJECT_STATUS.md",
    "design": "browser/src/styles/system.css"
  },
  "direction": {
    "references": [],
    "probes": [],
