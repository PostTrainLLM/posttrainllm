    "critique": {
      "score": 34,
      "maximum": 40
    },
    "audit": {
      "score": 19,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": []
    },
