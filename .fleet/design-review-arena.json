  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": ".fleet/evidence/game-arena/after-390.png"
      },
      {
        "width": 768,
        "path": ".fleet/evidence/game-arena/after-768.png"
      },
      {
        "width": 1440,
        "path": ".fleet/evidence/game-arena/after-1440.png"
      }
